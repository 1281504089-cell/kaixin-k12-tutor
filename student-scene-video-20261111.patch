+                super().__init__([])
+                self.queue = asyncio.Queue()
+            async def send(self, raw):
+                await super().send(raw)
+                request = json.loads(raw)
+                kind = request["type"]
+                if kind == "session.create":
+                    await self.queue.put({"type": "session.created"})
+                    for call_id in ("read-1", "read-2"):
+                        await self.queue.put({"type": "response.function_call_arguments.done", "items": [{"name": "read_shared_picture", "call_id": call_id}]})
+                elif kind == "session.update":
+                    failed = tutor.SCENE_INSTRUCTIONS["interview"] in request["session"]["instructions"]
