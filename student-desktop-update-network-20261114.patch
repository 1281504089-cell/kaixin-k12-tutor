+++ b/tests/test_desktop_release_batch.py
@@ -0,0 +1,61 @@
+"""Publication waits for the complete native build matrix, never one successful host."""
+
+import os
+from pathlib import Path
+import subprocess
+
+import pytest
+import yaml
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def workflow():
+    return yaml.safe_load((ROOT / ".github/workflows/desktop-release.yml").read_text())
+
+
+def test_each_native_build_stages_instead_of_publishing():
+    jobs = workflow()["jobs"]
+    assert jobs["publish"]["needs"] == "build"
+    assert "always()" not in jobs["publish"]["if"]
+    assert all("gh release upload" not in step.get("run", "") for step in jobs["build"]["steps"])
+    assert any(
+        step.get("with", {}).get("name") == "release-${{ matrix.target }}"
+        and step["with"]["if-no-files-found"] == "error"
+        for step in jobs["build"]["steps"]
+    )
+
+
+@pytest.mark.parametrize("missing_windows", [True, False])
+def test_missing_platform_never_calls_the_publisher(tmp_path, missing_windows):
+    script = next(step["run"] for step in workflow()["jobs"]["publish"]["steps"] if "run" in step)
+    for target in ("macos-arm64", "macos-x64", "windows-x64"):
+        if target == "windows-x64" and missing_windows:
+            continue
+        directory = tmp_path / "artifacts" / ("release-" + target)
+        directory.mkdir(parents=True)
+        (directory / ("Scholar-Setup.exe" if target == "windows-x64" else "Scholar.dmg")).touch()
+    binary = tmp_path / "bin"
+    binary.mkdir()
+    fake = binary / "gh"
+    fake.write_text('#!/bin/sh\nprintf "%s\\n" "$@" > "$PUBLISH_RECEIPT"\n')
+    fake.chmod(0o755)
+    receipt = tmp_path / "uploaded"
+    result = subprocess.run(
+        ["bash", "-c", script],
+        cwd=tmp_path,
+        capture_output=True,
+        text=True,
+        env={
+            **os.environ,
+            "PATH": str(binary) + os.pathsep + os.environ["PATH"],
+            "PUBLISH_RECEIPT": str(receipt),
+            "RELEASE_TAG": "v1.7.1",
+        },
+    )
+    assert (result.returncode == 0) is (not missing_windows)
+    assert receipt.exists() is (not missing_windows)
+    if not missing_windows:
+        assert all(
+            target in receipt.read_text() for target in ("macos-arm64", "macos-x64", "windows-x64")
+        )
