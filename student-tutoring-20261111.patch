+  }
+
+  function hangup() {
+    const call = run.current;
+    if (!call) {
+      dismiss();
+      return;
+    }
+    if (phase === "ending") return;
+    leaveAfterHangup.current = true;
+    stopDevices(call);
+    setPicture(undefined);
+    if (!call.socket || call.socket.readyState !== WebSocket.OPEN) {
+      finish(call);
+      return;
+    }
