+type Call = {
+  audio: AudioContext;
+  microphone?: MediaStream;
+  picture?: MediaStream;
+  pendingShare?: boolean;
+  socket?: WebSocket;
+  speakers: Set<AudioBufferSourceNode>;
+  playAt: number;
