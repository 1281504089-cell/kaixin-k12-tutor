+            </>
+          )}
+          <p className="text-sm text-[var(--muted-foreground)]">
+            {entry?.mode === "camera" ? "通话会同时开启麦克风和摄像头。" : "通话会开启麦克风。需要老师看题时，可共享整个屏幕或单个窗口。"}
+            通话文字会保存到当前聊天。
+          </p>
+          <button type="submit" disabled={configured === null || (!configured && !key.trim())} className={`${button} justify-self-start`}>
+            <Phone size={16} /> 开始通话
+          </button>
+        </form>
+      )}
+      {error && <p role="alert" className="mt-2 text-sm text-red-600 dark:text-red-400">{error}</p>}
+      {phase !== "setup" && (
+        <div className="mt-3 flex flex-wrap items-center gap-2">
+          <p role="status" className="mr-auto text-sm text-[var(--muted-foreground)]">
+            {live ? status : phase === "starting" ? "正在连接…" : phase === "ending" ? "正在结束通话…" : "通话已结束"}
+          </p>
+          {live && entry?.mode === "phone" && typeof navigator.mediaDevices?.getDisplayMedia === "function" && (
+            <button type="button" className={button} onClick={() => void toggleShare()}>
+              <ScreenShare size={16} /> {picture ? "停止共享" : "共享屏幕"}
+            </button>
+          )}
+          {live && entry?.mode === "camera" && cameras.length > 1 && (
+            <select aria-label="摄像头" value={camera} disabled={cameraBusy} className={`${field} max-w-56`}
+              onChange={async (event) => {
+                const call = run.current;
+                if (!call) return;
+                setCameraBusy(true);
+                try {
+                  await selectCamera(call, event.currentTarget.value);
+                } catch {
+                  if (run.current === call) setError("无法切换摄像头，请检查设备连接。");
+                } finally {
+                  setCameraBusy(false);
+                }
+              }}>
+              {cameras.map((device, index) => (
+                <option key={device.deviceId} value={device.deviceId}>{device.label || `摄像头 ${index + 1}`}</option>
+              ))}
+            </select>
+          )}
+          {ended && subtitles.length > 0 && (
+            <button type="button" className={button} onClick={async () => {
+              try {
+                await copyText(subtitles.map((line) => `${line.role === "user" ? "你" : "老师"}：${line.text}`).join("\n"));
+                setCopied(true);
+              } catch {
+                setError("无法复制，请选中字幕手动复制。");
+              }
+            }}>{copied ? "已复制" : "复制字幕"}</button>
+          )}
+          <button type="button" className={`${button} text-red-600 dark:text-red-400`}
+            disabled={phase === "ending"} onClick={hangup}>
+            {!ended && <PhoneOff size={16} />}{ended ? "返回聊天" : "挂断"}
+          </button>
+        </div>
+      )}
+      </>}
+    </dialog>
+  );
+}
