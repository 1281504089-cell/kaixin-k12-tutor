+            await client.send_json({"type": "error", "message": "这段对话无法写入，请返回聊天后重试。"})
+            return
+    saved: set[tuple[str, str]] = set()
+    subtitles: dict[tuple[str, str], str] = {}
+    phone_lines: dict[tuple[str, str], dict[str, str]] = {}
+
+    @workspace_writer
+    async def save_message(role: str, text: str) -> None:
+        nonlocal session_id
+        if not session_id:
+            session_id = (await store.create_session(title="语音通话记录"))["id"]
+        await store.add_message(session_id, role, text, capability="chat")
+
+    async def transcript(role: str, item_id: str, text: str, *, final: bool) -> None:
+        entry = (role, item_id)
+        if entry in saved:
+            return
+        if final:
+            text = (text or subtitles.get(entry, "")).strip()
+            subtitles.pop(entry, None)
+            if text:
+                if scene is not None:
+                    phone_lines[entry] = {"id": item_id, "role": role, "text": text}
+                try:
+                    await save_message(role, text)
+                except Exception:
+                    await client.send_json({
+                        "type": "history.error",
+                        "message": "有一条字幕未能保存，请在通话窗口复制需要保留的文字。",
+                    })
+                else:
+                    saved.add(entry)
+        else:
+            if not text or subtitles.get(entry) == text:
+                return
+            subtitles[entry] = text
+        await client.send_json({
+            "type": "transcript", "role": role, "id": item_id, "text": text,
+            "final": final, "sessionId": session_id if saved else None,
+        })
+
+    async with connect(
+        ENDPOINT, additional_headers={"X-Api-Key": key},
+        open_timeout=10, close_timeout=2, max_size=2**20,
+    ) as cloud:
+        async def send(kind: str, **fields) -> None:
+            await cloud.send(json.dumps({"type": kind, "event_id": uuid4().hex, **fields}, ensure_ascii=False))
+
+        await send("session.create", session={
+            "model": "1.2.6.1",
+            "instructions": INSTRUCTIONS + SCENE_INSTRUCTIONS.get(scene, ""),
+            "audio": {
+                "input": {"format": {"type": "pcm", "rate": 16000}},
+                "output": {
+                    "format": {"type": "pcm_s16le", "rate": 24000},
+                    "voice": "zh_female_vv_jupiter_bigtts",
+                },
+            },
+            "tools": [VISION_TOOL],
+        })
+        pending_frame: asyncio.Future[str | None] | None = None
+        vision_job: asyncio.Task[None] | None = None
+        seen_calls: set[str] = set()
+
+        async def answer_tools(items: list[dict]) -> None:
+            nonlocal pending_frame
+            results = []
+            for item in items:
+                call_id = item.get("call_id")
+                if not isinstance(call_id, str) or call_id in seen_calls:
+                    continue
+                seen_calls.add(call_id)
+                result = "当前未共享题目画面，请学生口述或主动共享。"
+                if item.get("name") == VISION_TOOL["name"]:
+                    try:
+                        arguments = json.loads(item.get("arguments") or "{}")
+                        question = str(arguments.get("question") or "请读出画面中学生正在做的题目。")[:600]
+                        pending_frame = asyncio.get_running_loop().create_future()
+                        await client.send_json({"type": "picture.request"})
+                        async with asyncio.timeout(3):
+                            picture = await pending_frame
+                        if picture:
+                            async with asyncio.timeout(15):
+                                result = await _read_picture(question, picture)
+                    except Exception:
+                        result = "这次没能读取画面，请学生检查共享或口述题目。"
+                    finally:
+                        pending_frame = None
+                results.append({"call_id": call_id, "role": "tool", "content": [{"type": "input_text", "text": result[:3500]}]})
+            if results:
+                await send("conversation.item.create", items=results)
+
+        async def upload() -> None:
+            while True:
+                message = await client.receive()
+                if message["type"] == "websocket.disconnect":
+                    return
+                audio = message.get("bytes")
+                if audio is not None:
+                    if len(audio) == AUDIO_PACKET_BYTES:
+                        await send("input_audio_buffer.append", audio=base64.b64encode(audio).decode("ascii"))
+                    continue
+                raw = message.get("text") or ""
+                if len(raw) > 4 * ((MAX_FRAME_BYTES + 2) // 3) + 128:
+                    continue
+                try:
+                    event = json.loads(raw)
+                    if not isinstance(event, dict):
+                        continue
+                    if event.get("type") == "hangup":
+                        return
+                    if event.get("type") == "picture" and pending_frame and not pending_frame.done():
+                        picture = event.get("jpeg")
+                        pending_frame.set_result(_decode_frame(picture) if picture else None)
+                except (ValueError, OSError, binascii.Error):
+                    if pending_frame and not pending_frame.done():
+                        pending_frame.set_result(None)
+
+        async def download() -> None:
+            nonlocal vision_job
+            async for raw in cloud:
+                event = json.loads(raw)
+                kind = event.get("type")
+                if kind == "session.created":
+                    if remember:
+                        try:
+                            await asyncio.to_thread(write_voice_key, key)
+                        except OSError:
+                            await client.send_json({
+                                "type": "key.error", "message": "通话已接通，但 Key 未能保存到本机。",
+                            })
+                    await client.send_json({"type": "ready"})
+                elif kind == "response.output_audio.delta":
+                    await client.send_bytes(base64.b64decode(event["delta"]))
+                elif kind == "response.function_call_arguments.done":
+                    if vision_job and not vision_job.done():
+                        await vision_job
+                    items = event.get("items") or []
+                    vision_job = asyncio.create_task(answer_tools(items))
+                elif kind in {
+                    "conversation.item.input_audio_transcription.delta",
+                    "conversation.item.input_audio_transcription.completed",
+                    "conversation.item.input_audio_transcription.failed",
+                }:
+                    item = str(event.get("item_id", ""))
+                    if kind.endswith(".failed"):
+                        subtitles.pop(("user", item), None)
+                        await transcript("user", item, "", final=True)
+                    elif kind.endswith(".delta"):
+                        # The recognizer sends its entire current hypothesis on each delta.
+                        await transcript("user", item, event.get("delta") or "", final=False)
+                    else:
+                        await transcript("user", item, event.get("text") or "", final=True)
+                elif kind in {"response.output_text.delta", "response.output_text.done"}:
+                    item = str(event.get("response_id", ""))
+                    if kind.endswith(".delta"):
+                        text = subtitles.get(("assistant", item), "") + (event.get("delta") or "")
+                        await transcript("assistant", item, text, final=False)
+                    else:
+                        await transcript("assistant", item, event.get("text") or "", final=True)
+                elif kind in {
+                    "conversation.item.input_audio_transcription.started",
+                    "response.output_audio.started",
+                    "response.output_audio.done",
+                    "response.canceled",
+                }:
+                    await client.send_json({"type": kind})
+                elif kind == "error":
+                    await client.send_json({"type": "error", "message": "豆包实时语音返回错误，请重新拨打。"})
+                    return
+                elif kind == "session.closed":
+                    return
+
+        sender = asyncio.create_task(upload())
+        receiver = asyncio.create_task(download())
+        try:
+            await asyncio.wait({sender, receiver}, return_when=asyncio.FIRST_COMPLETED)
+            if sender.done() and not receiver.done():
+                if vision_job and not vision_job.done():
+                    vision_job.cancel()
+                await send("session.close")
+                try:
+                    await asyncio.wait_for(receiver, timeout=2)
+                except (TimeoutError, WebSocketDisconnect):
+                    pass
+            for task in (sender, receiver):
+                if task.done() and not task.cancelled():
+                    task.result()
+        finally:
+            jobs = [job for job in (sender, receiver, vision_job) if job is not None]
+            for job in jobs:
+                job.cancel()
+            await asyncio.gather(*jobs, return_exceptions=True)
+            if scene is not None and phone_lines:
+                try:
+                    await asyncio.to_thread(save_phone_call, scene, list(phone_lines.values()))
+                except OSError:
+                    try:
+                        await client.send_json({"type": "history.error", "message": "本次通话未加入最近 5 天的记录。"})
+                    except (WebSocketDisconnect, RuntimeError):
+                        pass
+
+
+async def serve_local_realtime_tutor(ws: WebSocket) -> None:
+    from deeptutor.api.routers.auth import ws_auth_failed, ws_require_auth
+    from deeptutor.multi_user.context import reset_current_user
+    from deeptutor.multi_user.learning_access import assert_learning_surface
+    from deeptutor.services.workspace.context import get_workspace_scope
+
+    if not is_local_voice_request(ws):
+        await ws.close(code=1008)
+        return
+    user = await ws_require_auth(ws)
+    if user is ws_auth_failed:
+        return
+    try:
+        try:
+            assert_learning_surface("chat")
+        except PermissionError:
+            await ws.close(code=1008)
+            return
+        await ws.accept()
+        workspace = get_workspace_scope()
+        if workspace and workspace.archived:
+            await ws.send_json({"type": "error", "message": "请先恢复这个工作区，再拨打电话。"})
+            return
+        async with asyncio.timeout(10):
+            auth = await ws.receive_text()
+        if len(auth) > 256:
+            await ws.close(code=1008)
+            return
+        entered_key = auth.strip()
+        key = entered_key or await asyncio.to_thread(read_voice_key)
+        if not valid_voice_key(key):
+            await ws.send_json({"type": "key.required", "message": "请填写豆包实时语音 API Key。"})
+            return
+        async with asyncio.timeout(20 * 60):
+            scene = ws.query_params.get("scene")
+            if scene is not None and scene not in SCENE_INSTRUCTIONS:
+                scene = "tutor"
+            await run_realtime_tutor(
+                ws, key, ws.query_params.get("session_id"),
+                remember=bool(entered_key and ws.query_params.get("remember") == "1"),
+                scene=scene,
+            )
+    except InvalidStatus as error:
+        if error.response.status_code in {401, 403}:
+            message = "豆包拒绝连接，请检查 Key 和实时语音 3.0 的开通状态。"
+        else:
+            message = "暂时连不上豆包实时语音，请稍后再试。"
+        await ws.send_json({
+            "type": "key.required" if error.response.status_code in {401, 403} else "error",
+            "message": message,
+        })
+    except WebSocketDisconnect:
+        pass
+    except (TimeoutError, WebSocketException, OSError):
+        await ws.send_json({"type": "error", "message": "通话已超时或断开，可以重新拨打。"})
+    finally:
+        try:
+            await ws.close()
+        except (RuntimeError, WebSocketDisconnect):
+            pass
+        finally:
+            reset_current_user(user)
