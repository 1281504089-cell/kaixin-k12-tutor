diff --git a/web/lib/realtime-voice-key.ts b/web/lib/realtime-voice-key.ts
new file mode 100644
index 0000000..dc13b87
--- /dev/null
+++ b/web/lib/realtime-voice-key.ts
@@ -0,0 +1,15 @@
+import { apiFetch } from "@/shared/api/client";
+
+export async function realtimeVoiceKey(key?: string | null, signal?: AbortSignal): Promise<boolean> {
+  const response = await apiFetch("/api/voice/realtime-key", {
+    method: key === undefined ? "GET" : "PUT",
+    headers: key === undefined ? undefined : { "Content-Type": "application/json" },
+    body: key === undefined ? undefined : JSON.stringify({ key }),
+    cache: "no-store",
+    signal,
+  });
+  if (response.status === 400) throw new Error("语音 Key 格式不正确。");
+  if (response.status === 403) throw new Error("请在本机的超级学霸中设置语音 Key。");
+  if (!response.ok) throw new Error("无法读取或更新语音 Key，请重试。");
+  return (await response.json()).configured === true;
+}
diff --git a/web/public/realtime-microphone.js b/web/public/realtime-microphone.js
new file mode 100644
index 0000000..4f7e999
--- /dev/null
+++ b/web/public/realtime-microphone.js
@@ -0,0 +1,30 @@
+class RealtimeMicrophone extends AudioWorkletProcessor {
+  packet = new Int16Array(320);
+  index = 0;
+  phase = 0;
+  sum = 0;
+  count = 0;
+
+  process(inputs) {
+    const channel = inputs[0]?.[0];
+    if (!channel) return true;
+    for (const sample of channel) {
+      this.sum += sample;
+      this.count++;
+      this.phase += 16000;
+      if (this.phase < sampleRate) continue;
+      this.phase -= sampleRate;
+      this.packet[this.index++] = Math.max(-32768, Math.min(32767, 32768 * this.sum / this.count));
+      this.sum = 0;
+      this.count = 0;
+      if (this.index === this.packet.length) {
+        this.port.postMessage(this.packet.buffer, [this.packet.buffer]);
+        this.packet = new Int16Array(320);
+        this.index = 0;
+      }
+    }
+    return true;
+  }
+}
+
+registerProcessor("realtime-microphone", RealtimeMicrophone);
