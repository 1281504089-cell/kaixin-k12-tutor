+    const phone = entry.mode === "phone";
+    if (rect) {
+      element.style.setProperty("--camera-origin", phone ? "top right" : `calc(50% + ${rect.x + rect.width / 2 - window.innerWidth / 2}px) calc(50% + ${rect.y + rect.height / 2 - window.innerHeight / 2}px)`);
