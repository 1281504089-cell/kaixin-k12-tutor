+      }
+    } finally {
+      call.pendingShare = false;
+    }
+  }
+
+  async function start() {
+    const enteredKey = configured ? "" : key.trim();
+    if (run.current || !entry || configured === null || (!configured && !enteredKey)) return;
+    setError("");
+    setSubtitles([]);
+    setCopied(false);
+    savedId.current = null;
+    leaveAfterHangup.current = false;
+    saveError.current = false;
+    follow.current = true;
+    setPhase("starting");
+    let call: Call | undefined;
+    try {
+      const audio = new AudioContext();
+      call = { audio, speakers: new Set(), playAt: 0, ready: false };
+      const current = call;
+      run.current = current;
+      await audio.resume();
+      if (run.current !== current) return;
+      const microphone = await navigator.mediaDevices.getUserMedia({
+        audio: { echoCancellation: true, noiseSuppression: true, channelCount: 1 },
+      });
+      if (run.current !== current || audio.state === "closed") {
+        microphone.getTracks().forEach((track) => track.stop());
+        return;
+      }
+      current.microphone = microphone;
+      if (entry.mode === "camera") await selectCamera(current, camera || undefined);
+      if (run.current !== current) return;
+      await audio.audioWorklet.addModule("/realtime-microphone.js");
+      if (run.current !== current) return;
+      const source = audio.createMediaStreamSource(microphone);
+      const worklet = new AudioWorkletNode(audio, "realtime-microphone");
+      const mute = audio.createGain();
+      mute.gain.value = 0;
+      source.connect(worklet).connect(mute).connect(audio.destination);
+
+      const url = new URL(wsUrl(scopedUrl("/ws/realtime-tutor", entry.workspaceId)), window.location.href);
+      url.protocol = url.protocol === "https:" ? "wss:" : "ws:";
+      if (entry.sessionId) url.searchParams.set("session_id", entry.sessionId);
+      if (entry.mode === "phone") url.searchParams.set("scene", scene);
+      if (enteredKey) url.searchParams.set("remember", "1");
+      const socket = new WebSocket(url);
+      current.socket = socket;
+      socket.binaryType = "arraybuffer";
+      socket.onopen = () => socket.send(enteredKey);
+      socket.onclose = () => finish(current, leaveAfterHangup.current ? undefined : "通话已断开，可以重新拨打。");
+      current.timer = window.setTimeout(() => finish(current, "连接超时，请重新拨打。"), 18_000);
+      worklet.port.onmessage = ({ data }: MessageEvent<ArrayBuffer>) => {
+        if (current.ready && socket.readyState === WebSocket.OPEN && socket.bufferedAmount < 32_000) {
+          socket.send(data);
+        }
+      };
+      let speaking = false;
+      socket.onmessage = ({ data }: MessageEvent<string | ArrayBuffer>) => {
+        if (run.current !== current) return;
+        if (typeof data !== "string") {
+          if (!current.ready || !speaking || !data.byteLength || data.byteLength % 2) return;
+          const samples = new Int16Array(data);
+          const buffer = audio.createBuffer(1, samples.length, 24000);
+          const channel = buffer.getChannelData(0);
+          for (let i = 0; i < samples.length; i++) channel[i] = samples[i] / 32768;
+          const node = audio.createBufferSource();
+          node.buffer = buffer;
+          node.connect(audio.destination);
+          current.speakers.add(node);
+          node.onended = () => {
+            current.speakers.delete(node);
+            if (run.current === current && current.ready && !speaking && !current.speakers.size) {
+              setStatus("正在听…");
+            }
+          };
+          const startAt = Math.max(current.playAt, audio.currentTime + 0.035);
+          node.start(startAt);
+          current.playAt = startAt + buffer.duration;
+          return;
+        }
