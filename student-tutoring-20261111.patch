+              </button>
+            )) : <p>最近 5 天没有通话记录。</p>
+          )}
+        </div>
+      ) : <>
+      <div className={styles.content} hidden={collapsed}>
+        <div className={styles.preview}>
+          <h3 className={styles.panelTitle}>实时画面</h3>
+          {picture ? <video ref={video} className={styles.video} autoPlay muted playsInline /> : (
+            <div className={styles.previewPlaceholder}>
+              <Camera size={24} aria-hidden="true" />
+              <span>{phase === "setup" ? "开始通话后显示摄像头画面" : "摄像头画面未开启"}</span>
+            </div>
+          )}
+        </div>
+        <div className={styles.history}>
+          <h3 className={styles.historyTitle}>聊天记录</h3>
+          <div ref={log} className={styles.transcript} aria-label="通话字幕"
