+            </button>
+          )}
+          {phone && (phase === "setup" || ended) && (
+            <button type="button" className={button} aria-pressed={viewHistory} onClick={() => {
+              setPastCall(null);
+              setHistory(null);
+              setHistoryError(false);
+              setViewHistory(!viewHistory);
+            }}>
+              <History size={16} /> {viewHistory ? "返回通话" : "最近 5 天"}
