+                setStatus("老师正在看题…");
+              }
+            } catch {
+              setError("暂时读不到画面，请调整后再问。");
+            }
+            socket.send(JSON.stringify({ type: "picture", jpeg }));
+            break;
+          }
+          case "history.error":
+            saveError.current = true;
+            setError(event.message);
+            break;
+          case "key.error":
+            setError(event.message);
+            break;
+          case "key.required":
+            setConfigured(false);
+            finish(current, event.message);
+            break;
+          case "error":
+            finish(current, event.message);
+            break;
+        }
+      };
+    } catch {
+      const message = "无法启动通话，请检查麦克风、摄像头权限和浏览器支持。";
+      if (call) finish(call, message);
+      else {
+        setError(message);
+        setPhase("setup");
+      }
+    }
+  }
+
+  const live = phase === "live";
+  const ended = phase === "ended";
+  const phone = entry?.mode === "phone";
+  return (
+    <dialog ref={dialog} className={styles.dialog} aria-labelledby={titleId}
