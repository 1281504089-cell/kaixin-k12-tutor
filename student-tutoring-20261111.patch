diff --git a/web/components/chat/home/ChatReadingTab.tsx b/web/components/chat/home/ChatReadingTab.tsx
new file mode 100644
index 0000000..9001eea
--- /dev/null
+++ b/web/components/chat/home/ChatReadingTab.tsx
@@ -0,0 +1,196 @@
+"use client";
+
+import { useEffect, useRef, useState } from "react";
+import dynamic from "next/dynamic";
+import { BookOpen, ChevronLeft, ChevronRight, FileUp, Library } from "lucide-react";
+import { getMaterial, listMaterials, rawMaterialUrl, type MaterialDetail } from "@/lib/reading-api";
+import { getTextbooks } from "@/lib/student-learning-api";
+import type { JumpRequest } from "@/components/reading/PdfDocumentView";
+import { Button } from "@/shared/ui/Button";
+
+const PdfView = dynamic(() => import("@/components/reading/PdfDocumentView").then(m => m.PdfDocumentView), { ssr: false });
+const EpubView = dynamic(() => import("@/components/reading/EpubDocumentView").then(m => m.EpubDocumentView), { ssr: false });
+const TextView = dynamic(() => import("@/components/reading/TextUnitView").then(m => m.TextUnitView), { ssr: false });
+
+export type ChatReadingDocument = {
+  material: MaterialDetail;
+  textbook: boolean;
+  locator: number;
+};
+type Source = "textbook" | "library" | "file";
+type Choice = { id: string; title: string };
+
+const noop = () => {};
+const noAnnotations: [] = [];
+const sources = [
+  { id: "textbook", label: "教材", icon: BookOpen },
+  { id: "library", label: "资料库", icon: Library },
+  { id: "file", label: "临时附件", icon: FileUp },
+] as const;
+
+export default function ChatReadingTab({
+  document: reading, onDocumentChange, onLocation, onLocalFile, onAsk,
+}: {
+  document: ChatReadingDocument | null;
+  onDocumentChange: (document: ChatReadingDocument | null) => void;
+  onLocation: (materialId: string, locator: number) => void;
+  onLocalFile: (file: File) => Promise<boolean>;
+  onAsk: () => void;
+}) {
+  const documentId = reading?.material.material_id;
+  const fileInput = useRef<HTMLInputElement>(null);
+  const generation = useRef(0);
+  const [source, setSource] = useState<Source>("textbook");
+  const [choices, setChoices] = useState<Choice[]>([]);
+  const [query, setQuery] = useState("");
+  const [loading, setLoading] = useState(false);
+  const [opening, setOpening] = useState(false);
+  const [error, setError] = useState("");
+  const [jump, setJump] = useState<JumpRequest | null>(() =>
+    reading ? { locator: reading.locator, nonce: 1 } : null,
+  );
+
+  useEffect(() => {
+    if (documentId || source === "file") return;
+    const token = ++generation.current;
+    setChoices([]);
+    setLoading(true);
+    setError("");
+    const request = source === "textbook"
+      ? getTextbooks().then(result => result.books.map(({ id, title }) => ({ id, title })))
+      : listMaterials().then(rows => rows
+        .filter(row => row.render_mode !== "video" && row.render_mode !== "audio")
+        .map(row => ({ id: row.material_id, title: row.title || row.filename })));
+    void request.then(rows => {
+      if (token === generation.current) setChoices(rows);
+    }).catch(() => {
+      if (token === generation.current) setError("暂时无法读取资料列表，请重新选择来源。");
+    }).finally(() => {
+      if (token === generation.current) setLoading(false);
+    });
+    return () => { generation.current++; };
+  }, [source, documentId]);
+
+  useEffect(() => () => { generation.current++; }, []);
+
+  async function choose(id: string) {
+    const token = ++generation.current;
+    setOpening(true);
+    setError("");
+    try {
+      const textbook = source === "textbook";
+      const material = await getMaterial(id, textbook ? "" : undefined);
+      if (token !== generation.current) return;
+      setJump(null);
+      onDocumentChange({ material, textbook, locator: 1 });
+    } catch {
+      if (token === generation.current) setError("无法打开这份资料，请重试。");
+    } finally {
+      if (token === generation.current) setOpening(false);
+    }
+  }
+
+  async function attach(file: File) {
+    const token = ++generation.current;
+    setOpening(true);
+    setError("");
+    try {
+      if (!await onLocalFile(file) && token === generation.current) {
+        setError("无法加入这份附件，请检查格式或大小。");
+      }
+    } catch {
+      if (token === generation.current) setError("无法读取附件，请重试。");
+    } finally {
+      if (token === generation.current) setOpening(false);
+    }
+  }
+
+  if (reading) {
+    const { material, locator, textbook } = reading;
+    const move = (delta: number) => {
+      const target = locator + delta;
+      if (target < 1 || target > material.unit_count) return;
+      setJump({ locator: target, nonce: (jump?.nonce ?? 0) + 1 });
+    };
+    const common = {
+      materialId: material.material_id,
+      annotations: noAnnotations,
+      unitCount: material.unit_count,
+      jump,
+      onSelection: noop,
+      onVisibleLocatorChange: (page: number) => onLocation(material.material_id, page),
+    };
+    return (
+      <section className="flex h-full min-h-0 flex-col" aria-label="当前阅读资料">
+        <div className="flex shrink-0 flex-wrap items-center gap-2 border-b border-border px-3 py-2">
+          <h2 className="min-w-0 flex-1 basis-full truncate text-sm font-medium">{material.title || material.filename}</h2>
+          <Button size="sm" variant="ghost" onClick={() => onDocumentChange(null)}>换资料</Button>
+          <div className="flex items-center gap-1" aria-label="阅读位置">
+            <Button size="sm" variant="ghost" aria-label="上一页" disabled={locator <= 1} onClick={() => move(-1)}><ChevronLeft size={14} /></Button>
+            <span className="text-xs text-muted-foreground">第 {locator} {material.unit === "page" ? "页" : material.unit === "slide" ? "张" : material.unit === "chapter" ? "章" : "节"} / {material.unit_count}</span>
+            <Button size="sm" variant="ghost" aria-label="下一页" disabled={locator >= material.unit_count} onClick={() => move(1)}><ChevronRight size={14} /></Button>
+          </div>
+          <Button size="sm" variant="secondary" onClick={onAsk} className="ml-auto">问当前页</Button>
+        </div>
+        <div className="relative min-h-0 flex-1 overflow-hidden">
+          {material.render_mode === "pdf" ? (
+            <PdfView key={material.material_id} {...common} sourceUrl={rawMaterialUrl(material.material_id, textbook ? "" : undefined)} />
+          ) : material.render_mode === "epub" ? (
+            <EpubView key={material.material_id} {...common} unitRefs={material.unit_refs} onError={setError} />
+          ) : (
+            <TextView key={material.material_id} {...common} unit={material.unit} contentFormat={material.content_format} sourceType={material.source_type} />
+          )}
+        </div>
+        {error && <p role="alert" className="shrink-0 px-3 py-2 text-sm text-destructive">{error}</p>}
+      </section>
+    );
+  }
+
+  const matches = choices.filter(choice => choice.title.toLowerCase().includes(query.trim().toLowerCase()));
+  return (
+    <section className="h-full overflow-y-auto p-4" aria-label="选择阅读资料">
+      <h2 className="font-medium">选择阅读资料</h2>
+      <p className="mt-1 text-sm text-muted-foreground">选好资料后，可以在当前聊天里边读边问。</p>
+      <div className="my-3 flex flex-wrap gap-2" aria-label="资料来源">
+        {sources.map(({ id, label, icon: Icon }) => (
+          <Button key={id} size="sm" variant={source === id ? "secondary" : "ghost"} aria-pressed={source === id}
+            disabled={opening} onClick={() => { setSource(id); setQuery(""); setError(""); }} icon={<Icon size={15} />}>
+            {label}
+          </Button>
+        ))}
+      </div>
+      {source === "file" ? (
+        <div className="grid justify-items-start gap-2">
+          <p className="text-sm text-muted-foreground">附件会随当前对话发送，可先预览。</p>
+          <input ref={fileInput} type="file" className="sr-only" tabIndex={-1} aria-label="选择临时附件"
+            onChange={event => { const file = event.currentTarget.files?.[0]; event.currentTarget.value = ""; if (file) void attach(file); }} />
+          <Button size="sm" variant="secondary" loading={opening} onClick={() => fileInput.current?.click()}>选择文件</Button>
+        </div>
+      ) : (
+        <>
+          <input value={query} onChange={event => setQuery(event.target.value)} placeholder="搜索标题" aria-label="搜索阅读资料"
+            className="mb-2 w-full rounded-lg border border-border bg-background px-3 py-2 text-sm" />
+          {loading ? <p role="status" className="text-sm text-muted-foreground">正在读取列表…</p> : (
+            <ul className="grid gap-1">
+              {matches.map(choice => (
+                <li key={choice.id}>
+                  <button type="button" disabled={opening} onClick={() => void choose(choice.id)}
+                    className="w-full rounded-lg border border-border/65 px-3 py-2 text-left text-sm hover:bg-muted disabled:opacity-60">
+                    {choice.title}
+                  </button>
+                </li>
+              ))}
+            </ul>
+          )}
+          {!loading && !matches.length && !error && (
+            <p className="text-sm text-muted-foreground">
+              {choices.length ? "没有找到匹配的资料。" : source === "textbook" ? "本机还没有教材。" : "当前工作区还没有已上传的阅读资料。"}
+            </p>
+          )}
+          {opening && <p role="status" className="mt-2 text-sm text-muted-foreground">正在打开资料…</p>}
+        </>
+      )}
+      {error && <p role="alert" className="mt-2 text-sm text-destructive">{error}</p>}
+    </section>
+  );
+}
