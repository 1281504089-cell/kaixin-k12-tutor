+          )}
+          <button type="button" className={button} onClick={hangup} aria-label="关闭通话窗口">
+            <X size={17} />
+          </button>
+        </div>
+      </header>
+      {viewHistory ? (
+        <div className={styles.pastCalls}>
+          {pastCall ? (
+            <>
+              <button type="button" className={button} onClick={() => setPastCall(null)}>返回通话记录</button>
