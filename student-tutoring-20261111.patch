new file mode 100644
index 0000000..1b06829
--- /dev/null
+++ b/deeptutor/services/voice/realtime_history.py
@@ -0,0 +1,51 @@
+"""Short-lived, account-private phone transcripts."""
+
+import hashlib
+import json
+import time
+from uuid import uuid4
+
+from deeptutor.multi_user.paths import get_owner_secrets_dir
+from deeptutor.services.file_io import atomic_write_json, read_text
+from deeptutor.services.workspace.context import current_workspace_id
+
+_RETENTION = 5 * 24 * 60 * 60
+
+
+def _directory():
+    workspace = hashlib.sha256(current_workspace_id().encode()).hexdigest()
+    return get_owner_secrets_dir() / "phone-history" / workspace
+
+
+def _recent_paths(now):
+    for path in _directory().glob("*.json"):
+        try:
+            if path.stat().st_mtime <= now - _RETENTION:
+                path.unlink(missing_ok=True)
+            else:
+                yield path
+        except FileNotFoundError:
+            continue
+
+
+def save_phone_call(scene: str, lines: list[dict[str, str]]) -> None:
+    now = time.time()
+    for _ in _recent_paths(now):
+        pass
+    call_id = uuid4().hex
+    atomic_write_json(_directory() / f"{call_id}.json", {
+        "id": call_id, "endedAt": now, "scene": scene, "lines": lines,
+    })
+
+
+def recent_phone_calls() -> list[dict]:
+    now = time.time()
+    calls = []
+    for path in _recent_paths(now):
+        try:
+            record = json.loads(read_text(path))
+            if record["endedAt"] > now - _RETENTION:
+                calls.append(record)
+        except (FileNotFoundError, KeyError, TypeError, ValueError):
+            continue
+    return sorted(calls, key=lambda call: call["endedAt"], reverse=True)
