+    call.socket.send(JSON.stringify({ type: "hangup" }));
+    call.timer = window.setTimeout(() => finish(call), 3500);
+  }
+
+  function usePicture(call: Call, stream: MediaStream) {
+    if (run.current !== call || call.audio.state === "closed") {
+      stream.getTracks().forEach((track) => track.stop());
+      return;
+    }
+    call.picture?.getTracks().forEach((track) => track.stop());
+    call.picture = stream;
+    setPicture(stream);
+    stream.getVideoTracks()[0]?.addEventListener("ended", () => {
+      if (run.current === call && call.picture === stream) {
