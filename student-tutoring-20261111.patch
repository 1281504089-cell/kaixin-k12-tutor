+            setPhase("live");
+            setStatus("正在听…");
+            break;
+          case "transcript": {
+            if (event.sessionId) savedId.current = event.sessionId;
+            const line: Subtitle = {
+              id: event.id, role: event.role, text: event.text,
+            };
+            setSubtitles((previous) => {
+              const index = previous.findIndex((item) => item.id === line.id && item.role === line.role);
+              if (!line.text) return previous.filter((_, i) => i !== index);
+              if (index < 0) return [...previous, line];
+              return previous.map((item, i) => i === index ? line : item);
+            });
+            break;
+          }
+          case "conversation.item.input_audio_transcription.started":
+          case "response.canceled":
+            speaking = false;
+            stopPlayback(current);
+            setStatus("正在听…");
+            break;
+          case "response.output_audio.started":
+            speaking = true;
+            setStatus("老师正在说，可随时插话。");
+            break;
+          case "response.output_audio.done":
