@@ -0,0 +1,34 @@
+"use client";
+
+import dynamic from "next/dynamic";
+import { createContext, useContext, useState, type ReactNode } from "react";
+import { notifySessionsChanged } from "@/lib/session-events";
+import type { TutorCallEntry } from "./CameraTutor";
+
+const CameraTutor = dynamic(() => import("./CameraTutor"), { ssr: false });
+const TutorCallContext = createContext<{
+  entry: TutorCallEntry | null;
+  completed: { entry: TutorCallEntry; savedId: string } | null;
+  open: (entry: TutorCallEntry) => void;
+}>({ entry: null, completed: null, open: () => {} });
+
+export function useTutorCall() {
+  return useContext(TutorCallContext);
+}
+
+export function TutorCallProvider({ children }: { children: ReactNode }) {
+  const [entry, setEntry] = useState<TutorCallEntry | null>(null);
+  const [completed, setCompleted] = useState<{ entry: TutorCallEntry; savedId: string } | null>(null);
+  return (
+    <TutorCallContext.Provider value={{ entry, completed, open: (next) => setEntry((current) => current ?? next) }}>
+      {children}
+      <CameraTutor entry={entry} onClose={(savedId) => {
+        setEntry(null);
+        if (entry && savedId) {
+          setCompleted({ entry, savedId });
+          notifySessionsChanged();
+        }
+      }} />
+    </TutorCallContext.Provider>
+  );
+}
