index 0000000..401b25b
--- /dev/null
+++ b/deeptutor/services/voice/realtime_credentials.py
@@ -0,0 +1,51 @@
+"""Account-private credentials for local realtime tutoring."""
+
+import re
+from urllib.parse import urlsplit
+
+from starlette.requests import HTTPConnection
+
+from deeptutor.multi_user.paths import get_owner_secrets_dir
+from deeptutor.services.file_io import atomic_write_text, read_text
+
+_LOOPBACK = {"127.0.0.1", "localhost", "::1"}
+
+
+def is_local_voice_request(connection: HTTPConnection, *, require_origin: bool = True) -> bool:
+    headers = connection.headers
+    backend_host = headers.get("host", "")
+    frontend_host = headers.get("x-deeptutor-frontend-host") or backend_host
+    try:
+        if (
+            not connection.client
+            or connection.client.host not in _LOOPBACK
+            or urlsplit("//" + backend_host).hostname not in _LOOPBACK
+            or urlsplit("//" + frontend_host).hostname not in _LOOPBACK
+        ):
+            return False
+        origin = headers.get("origin")
+        if origin is None:
+            return not require_origin and headers.get("sec-fetch-site", "none") in {"none", "same-origin"}
+        parsed = urlsplit(origin)
+        return parsed.scheme in {"http", "https"} and parsed.netloc == frontend_host
+    except ValueError:
+        return False
+
+
+def valid_voice_key(key: object) -> bool:
+    return isinstance(key, str) and re.fullmatch(r"[A-Za-z0-9_-]{1,256}", key) is not None
+
+
+def read_voice_key() -> str:
+    try:
+        return read_text(get_owner_secrets_dir() / "realtime-voice.key").strip()
+    except FileNotFoundError:
+        return ""
+
+
+def write_voice_key(key: str) -> None:
+    path = get_owner_secrets_dir() / "realtime-voice.key"
+    if key:
+        atomic_write_text(path, key)
+    else:
+        path.unlink(missing_ok=True)
