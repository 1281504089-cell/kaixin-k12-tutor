+const field = "min-h-10 w-full rounded-lg border border-[var(--border)] bg-[var(--background)] px-3 py-1.5 text-sm";
+
+function stopPlayback(call: Call) {
+  for (const node of call.speakers) node.stop();
+  call.speakers.clear();
+  call.playAt = 0;
+}
+
+function stopDevices(call: Call) {
+  window.clearTimeout(call.timer);
+  call.ready = false;
+  call.microphone?.getTracks().forEach((track) => track.stop());
+  call.picture?.getTracks().forEach((track) => track.stop());
+  stopPlayback(call);
+  if (call.audio.state !== "closed") void call.audio.close();
+}
