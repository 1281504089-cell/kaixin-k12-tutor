+                <span className="whitespace-pre-wrap break-words">{line.text}</span>
+              </p>
+            ))}
+          </div>
+          {!subtitles.length && <p className={styles.historyPlaceholder}>开始对话后，文字会显示在这里。</p>}
+        </div>
+      </div>
+      {(phase === "setup" || (ended && !subtitles.length)) && (
+        <form className="mt-3 grid gap-2" onSubmit={(event) => { event.preventDefault(); void start(); }}>
+          {phone && (
+            <label className="grid gap-1 text-sm font-medium">选择场景
+              <select className={field} value={scene} onChange={(event) => setScene(event.currentTarget.value as keyof typeof scenes)}>
