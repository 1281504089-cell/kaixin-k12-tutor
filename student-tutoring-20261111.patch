new file mode 100644
index 0000000..6a8552b
--- /dev/null
+++ b/web/features/settings/sections/models/RealtimeVoiceKeySettings.tsx
@@ -0,0 +1,64 @@
+"use client";
+
+import { useEffect, useId, useState } from "react";
+import { realtimeVoiceKey } from "@/lib/realtime-voice-key";
+import { Button } from "@/shared/ui/Button";
+
+export function RealtimeVoiceKeySettings() {
+  const keyId = useId();
+  const [configured, setConfigured] = useState<boolean | null>(null);
+  const [key, setKey] = useState("");
+  const [saving, setSaving] = useState(false);
+  const [message, setMessage] = useState("");
+  const [error, setError] = useState("");
+
+  useEffect(() => {
+    const request = new AbortController();
+    realtimeVoiceKey(undefined, request.signal).then(setConfigured, (reason) => {
+      if (!request.signal.aborted) setError(reason.message);
+    });
+    return () => request.abort();
+  }, []);
+
+  async function save(next: string | null) {
+    setSaving(true);
+    setError("");
+    setMessage("");
+    try {
+      setConfigured(await realtimeVoiceKey(next));
+      setKey("");
+      setMessage(next ? "已保存。下次通话会自动使用。" : "已清除语音 Key。");
+    } catch (reason) {
+      setError(reason instanceof Error ? reason.message : "无法更新语音 Key，请重试。");
+    } finally {
+      setSaving(false);
+    }
+  }
+
+  return (
+    <section className="mb-8 rounded-xl border border-[var(--border)]/60 bg-[var(--card)]/40 p-4 sm:p-5">
+      <h2 className="text-[15px] font-semibold">豆包实时语音</h2>
+      <p className="mt-1 text-sm text-[var(--muted-foreground)]">
+        语音通话和高拍仪辅导共用这个 Key，保存在本机。
+      </p>
+      <form className="mt-3 grid max-w-lg gap-2" onSubmit={(event) => {
+        event.preventDefault();
+        if (key.trim() && !saving) void save(key.trim());
+      }}>
+        <label htmlFor={keyId} className="text-sm font-medium">豆包实时语音 API Key</label>
+        <input id={keyId} type="password" autoComplete="off" maxLength={256} value={key}
+          placeholder={configured ? "已保存，输入新 Key 可更换" : "输入 Key"}
+          onChange={(event) => setKey(event.currentTarget.value)}
+          className="min-h-10 min-w-0 rounded-lg border border-[var(--border)] bg-[var(--background)] px-3 text-sm" />
+        <div className="flex flex-wrap gap-2">
+          <Button type="submit" disabled={!key.trim() || saving}>保存 Key</Button>
+          {configured && (
+            <Button variant="secondary" disabled={saving} onClick={() => void save(null)}>清除 Key</Button>
+          )}
+        </div>
+      </form>
+      {message && <p role="status" className="mt-2 text-sm">{message}</p>}
+      {error && <p role="alert" className="mt-2 text-sm text-red-600 dark:text-red-400">{error}</p>}
+    </section>
+  );
+}
