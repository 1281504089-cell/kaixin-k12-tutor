+import React from "react";
+import { fireEvent, render, screen } from "@testing-library/react";
+import { beforeEach, expect, it, vi } from "vitest";
+import PdfPreview from "@/components/chat/preview/previewers/PdfPreview";
+import type { PdfDocumentViewProps, SelectionPayload } from "@/components/reading/PdfDocumentView";
+
+const selection: SelectionPayload = {locator: 5, quote: "题目片段", image: "data:image/png;base64,cGl4ZWxz", rects: [[0,0,0.5,0.5]], anchor:{x:10,y:10}};
+vi.mock("@/components/reading/PdfDocumentView", () => ({PdfDocumentView: (props: PdfDocumentViewProps) => <div>
+  <button onClick={() => props.onSelection(selection)}>Select passage</button>
+  {props.onRegionSelect && <button onClick={() => props.onRegionSelect?.({...selection,region:true})}>Capture diagram</button>}
+</div>}));
+vi.mock("react-i18next", () => ({useTranslation: () => ({t: (key: string) => key})}));
+beforeEach(() => vi.clearAllMocks());
+it("quotes a temporary PDF selection into its owning chat", () => {
+  const quote = vi.fn();
+  render(<PdfPreview url="blob:local-pdf" filename="临时数学资料.pdf" onQuote={quote} />);
+  fireEvent.click(screen.getByText("Select passage"));
+  fireEvent.click(screen.getByRole("button", {name:"引用片段"}));
+  expect(quote).toHaveBeenCalledWith(selection);
+  expect(screen.queryByLabelText("已选阅读片段")).toBeNull();
+});
+it("captures a scanned PDF region, with escape available to cancel", () => {
+  const quote = vi.fn();
+  render(<PdfPreview url="blob:scan" filename="扫描资料.pdf" onQuote={quote} />);
+  fireEvent.click(screen.getByRole("button", {name:"截图引用"}));
+  fireEvent.keyDown(window,{key:"Escape"});
+  expect(screen.queryByText("Capture diagram")).toBeNull();
+  fireEvent.click(screen.getByRole("button", {name:"截图引用"}));
+  fireEvent.click(screen.getByText("Capture diagram"));
+  expect(screen.getByRole("img",{name:"Quoted passage"})).toHaveAttribute("src",selection.image);
+  fireEvent.click(screen.getByRole("button", {name:"引用片段"}));
+  expect(quote).toHaveBeenCalledWith({...selection,region:true});
+});
+it("does not carry a previous file's quote into the next preview", () => {
+  const quote = vi.fn();
+  const view=render(<PdfPreview url="blob:one" filename="one.pdf" onQuote={quote} />);
+  fireEvent.click(screen.getByText("Select passage"));
+  view.rerender(<PdfPreview url="blob:two" filename="two.pdf" onQuote={quote} />);
+  expect(screen.queryByLabelText("已选阅读片段")).toBeNull();
+});
+it("keeps standalone previews without a chat callback read-only", () => {
+  render(<PdfPreview url="blob:read-only" filename="read-only.pdf" />);
+  expect(screen.queryByRole("button",{name:"截图引用"})).toBeNull();
+});
