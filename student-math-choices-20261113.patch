index 0000000000000000000000000000000000000000..b2d9ce77e7a27dee0e5453017a3fff87732c4984
--- /dev/null
+++ b/deeptutor/visualizers/interactive_math.py
@@ -0,0 +1,62 @@
+"""Turn compact parameter data into dependent GeoGebra objects locally."""
+
+import json
+import re
+
+from .static_math import math_expression, number
+
+INTERACTIVE_RULES = """只返回严格JSON数据，不生成GeoGebra命令：
+{"title":"中文图名","description":"中文操作说明和图形公式","view":[xmin,xmax,ymin,ymax],
+"parameters":[{"name":"a","min":0.5,"max":2,"step":0.1,"value":1}],
+"functions":[{"name":"f","expression":"a*x**2"}],
+"points":[{"name":"V","xy":["0","0"]}]}。
+所有数组都必需，没有则 []。参数最多4个，函数最多4条，关键点最多12个。
+表达式只使用声明的参数名、x、数字、pi、e、+ - * / **、sin/cos/tan/sqrt/log/exp/abs。
+关键点坐标表达式只能依赖参数，不能用未定义x。参数名、函数名和点名用唯一简短英文字母。
+视图范围是有限数值，参数范围避开题目退化情形。完整保留所有原题条件，不猜测数值。
+滑块、位置、中文界面与实时读数由本机实现，无需编写任何样式命令或文字控件。
+"""
+
+
+def build_interactive_math(data):
+    parameters = data["parameters"]
+    if not isinstance(parameters, list) or not 1 <= len(parameters) <= 4:
+        raise ValueError("交互图需有1至4个明确参数")
+    if not isinstance(data["functions"], list) or len(data["functions"]) > 4 or not isinstance(data["points"], list) or len(data["points"]) > 12:
+        raise ValueError("交互图数据超过支持范围")
+    names, values, commands = set(), {}, []
+    def name(value):
+        if not isinstance(value, str) or not re.fullmatch(r"[a-zA-Z][a-zA-Z0-9]{0,11}", value) or value in names or value in {"x", "y", "z", "pi", "e", "sin", "cos", "tan", "sqrt", "log", "exp", "abs"}:
+            raise ValueError("交互图对象名无效或重复")
+        names.add(value)
+        return value
+    for index, parameter in enumerate(parameters):
+        key = name(parameter["name"])
+        low, high, step, value = [number(parameter[field]) for field in ("min", "max", "step", "value")]
+        if not low < high or not low <= value <= high or not 0 < step <= high-low:
+            raise ValueError("无效滑块范围或初始值")
+        values[key] = value
+        commands.extend([f'{key}=Slider[{low},{high},{step},1,180,false,true,false,false]', f'SetValue[{key},{value}]', f'SetCoords[{key},30,{40+index*40}]', f'SetLabelMode[{key},1]'])
+    functions = []
+    for function in data["functions"]:
+        key = name(function["name"])
+        expression = function["expression"]
+        math_expression(expression, values)
+        commands.extend([f'{key}(x)={expression.replace("**", "^")}', f'SetLineThickness[{key},5]'])
+        functions.append(expression)
+    for point in data["points"]:
+        key = name(point["name"])
+        if not isinstance(point["xy"], list) or len(point["xy"]) != 2:
+            raise ValueError("关键点必须有两个坐标表达式")
+        coordinates = []
+        for expression in point["xy"]:
+            expression = str(expression)
+            if re.search(r"\bx\b", expression):
+                raise ValueError("关键点不能依赖未定义自变量x")
+            math_expression(expression, values)
+            coordinates.append(expression.replace("**", "^"))
+        commands.extend([f'{key}=({",".join(coordinates)})', f'SetLabelMode[{key},1]', f'SetLabelVisible[{key},true]'])
+    if not functions and not data["points"]:
+        raise ValueError("交互图没有随参数变化的数学对象")
+    view = dict(zip(("x_min", "x_max", "y_min", "y_max"), [number(value) for value in data["view"]], strict=True))
+    return json.dumps({"app_name": "graphing", "commands": commands, "view": view}, ensure_ascii=False)
