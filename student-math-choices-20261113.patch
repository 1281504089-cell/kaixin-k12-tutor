@@ -0,0 +1,36 @@
+"use client";
+
+import { useMemo, useState } from "react";
+import InlineMarkdown from "@/components/common/InlineMarkdown";
+import { choiceAnswerText, plainChoiceQuestions } from "@/lib/plain-choice-questions";
+import { extractAskUserPayload } from "./AskUserOptions";
+import { readPosedQuestion } from "@/lib/mastery-question";
+import type { StreamEvent } from "@/features/chat/model/protocol";
+
+export default function PlainChoiceCards({ content, events, disabled, onFill }: { content: string; events?: StreamEvent[]; disabled?: boolean; onFill: (text: string) => boolean }) {
+  const questions = useMemo(() => extractAskUserPayload(events) || events?.some(event => readPosedQuestion(event)) ? [] : plainChoiceQuestions(content), [content, events]);
+  const [picked, setPicked] = useState<Record<number, string[]>>({});
+  const [status, setStatus] = useState("");
+  if (!questions.length) return null;
+  function fill(index: number, letters: string[]) {
+    setStatus(onFill(choiceAnswerText(questions[index], letters)) ? "已填入当前输入框，确认后点发送即可。" : "输入框尚未准备好，请稍后再点选。");
+  }
+  return <section aria-label="选择题快捷作答" className="mt-4 space-y-3">
+    {questions.map((question, index) => <div key={index} className="rounded-2xl border border-[var(--border)] bg-[var(--background)] p-3">
+      <div className="mb-2 flex items-center justify-between gap-2 text-xs text-[var(--muted-foreground)]"><span>{questions.length > 1 ? `第 ${index + 1} 题 · ` : ""}快捷作答</span><span>{question.multiple ? "可选多项，再填入答案" : "点选后填入输入框"}</span></div>
+      <div className="grid gap-2 sm:grid-cols-2">
+        {question.options.map(option => {
+          const active = picked[index]?.includes(option.letter) ?? false;
+          return <button key={option.letter} type="button" aria-pressed={active} disabled={disabled} className={`flex min-w-0 items-start gap-2 rounded-xl border px-3 py-2 text-left text-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)] disabled:opacity-50 ${active ? "border-[var(--primary)] bg-[var(--muted)]" : "border-[var(--border)] hover:bg-[var(--muted)]"}`} onClick={() => {
+            const old = picked[index] || [];
+            const next = question.multiple ? active ? old.filter(letter => letter !== option.letter) : [...old, option.letter] : [option.letter];
+            setPicked(previous => ({ ...previous, [index]: next }));
+            if (!question.multiple) fill(index, next);
+          }}><span className="mt-0.5 shrink-0 font-medium text-[var(--primary)]">{option.letter}</span><span className="min-w-0 [overflow-wrap:anywhere]"><InlineMarkdown content={option.text} /></span></button>;
+        })}
+      </div>
+      {question.multiple && <button type="button" disabled={disabled || !picked[index]?.length} className="mt-2 rounded-lg bg-[var(--primary)] px-3 py-1.5 text-xs text-[var(--primary-foreground)] disabled:opacity-50" onClick={() => fill(index, picked[index] || [])}>填入答案</button>}
+    </div>)}
+    {status && <p role="status" className="px-1 text-xs text-[var(--muted-foreground)]">{status}</p>}
+  </section>;
+}
