diff --git a/web/lib/plain-choice-questions.ts b/web/lib/plain-choice-questions.ts
new file mode 100644
index 0000000000000000000000000000000000000000..cce332556a4c4bb2707e946c98f040f1c5c4bc09
--- /dev/null
+++ b/web/lib/plain-choice-questions.ts
@@ -0,0 +1,49 @@
+export interface PlainChoiceQuestion {
+  prompt: string;
+  options: Array<{ letter: string; text: string }>;
+  multiple: boolean;
+}
+
+const OPTION = /^\s*(?:[-*+]\s+)?(?:\*\*)?(?:[（(]([A-HＡ-Ｈ])[）)]|([A-HＡ-Ｈ])[.．、:：)）])(?:\*\*)?\s*(.+)$/;
+const QUESTION = /[?？]|[（(]\s*[）)]|_{2,}|请选择|选出|下列|以下.*正确|哪[个项些]|选择题|[单多]选|练习|试一试|判断|\b(?:which|what|choose|select|question|practice)\b/i;
+const SOLUTION = /^\s*(?:#+\s*|\*\*)*(?:(?:参考|正确)?答案|解析|解答|(?:correct\s+)?answer|solution)(?:\*\*)?\s*[:：]/i;
+
+/** Conservative UI fallback: the original answer is never rewritten. */
+export function plainChoiceQuestions(content: string): PlainChoiceQuestion[] {
+  const lines = content
+    .replace(/\*\*([A-HＡ-Ｈ])\*\*([.．、:：)）])/g, "$1$2")
+    .replace(/<think\b[^>]*>[\s\S]*?(?:<\/think>|$)/gi, "")
+    .replace(/```[\s\S]*?(?:```|$)|~~~[\s\S]*?(?:~~~|$)/g, "")
+    .replace(/\s+(?=(?:\*\*)?[B-HＢ-Ｈ][.．、:：)）](?:\*\*)?\s)/g, "\n")
+    .split(/\r?\n/);
+  const result: PlainChoiceQuestion[] = [];
+  let stemStart = 0;
+  for (let index = 0; index < lines.length; index += 1) {
+    const first = lines[index].match(OPTION);
+    if (!first || (first[1] || first[2]).normalize("NFKC") !== "A") continue;
+    const prompt = lines.slice(stemStart, index).join("\n").trim();
+    const options: PlainChoiceQuestion["options"] = [];
+    let end = index;
+    let valid = true;
+    for (; end < lines.length; end += 1) {
+      if (!lines[end].trim()) continue;
+      const match = lines[end].match(OPTION);
+      if (!match) break;
+      const letter = (match[1] || match[2]).normalize("NFKC");
+      if (letter.charCodeAt(0) !== 65 + options.length) valid = false;
+      options.push({ letter, text: match[3].trim() });
+    }
+    const following = lines.slice(end).find(line => line.trim()) || "";
+    if (valid && options.length >= 2 && options.length <= 8 && prompt.length <= 6000 && QUESTION.test(prompt) && !SOLUTION.test(following) && options.every(option => option.text.length <= 2000)) {
+      result.push({ prompt, options, multiple: /多选|不定项|选择所有|\b(?:multiple|select all|choose all)\b/i.test(prompt) });
+    }
+    stemStart = end;
+    index = end - 1;
+  }
+  return result;
+}
+
+export function choiceAnswerText(question: PlainChoiceQuestion, letters: string[]): string {
+  const selected = question.options.filter(option => letters.includes(option.letter));
+  return `题目：\n${question.prompt}\n\n${question.options.map(option => `${option.letter}. ${option.text}`).join("\n")}\n\n我的选择：${selected.map(option => `${option.letter}. ${option.text}`).join("；")}\n请根据原题核对我的选择，并解释关键理由。`;
+}
