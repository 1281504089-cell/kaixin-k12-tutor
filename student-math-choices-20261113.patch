+"use client";
+
+import dynamic from "next/dynamic";
+import { useMemo } from "react";
+import type { StreamEvent } from "@/features/chat/model/protocol";
+import { extractVisualizeResult } from "@/lib/visualize-types";
+
+const VisualizationViewer = dynamic(() => import("@/components/visualize/VisualizationViewer"), { ssr: false });
+
+export default function MathFigures({ events }: { events?: StreamEvent[] }) {
+  const figures = useMemo(() => {
+    const seen = new Set<string>();
+    return (events || []).flatMap(event => {
+      if (event.type !== "tool_result") return [];
+      const meta = event.metadata?.tool_metadata as Record<string, unknown> | undefined;
+      const review = meta?.math_review as Record<string, unknown> | undefined;
+      if (review?.approved !== true) return [];
+      const result = extractVisualizeResult(meta?.math_figure as Record<string, unknown> | undefined);
+      if (!result || !("code" in result) || !["svg", "geogebra"].includes(result.render_type)) return [];
+      const key = result.code.content;
+      if (seen.has(key)) return [];
+      seen.add(key);
+      return [result];
+    });
+  }, [events]);
+  if (!figures.length) return null;
+  return <section aria-label="本题配图" className="my-4 space-y-3">
+    {figures.map((figure, index) => <figure key={index} className="min-w-0 overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--card)] p-3">
+      {figure.presentation.title && <figcaption className="mb-2 text-sm font-medium">{figure.presentation.title}</figcaption>}
+      <VisualizationViewer result={figure} />
+      {figure.presentation.description && <p className="mt-2 text-xs text-[var(--muted-foreground)]">{figure.presentation.description}</p>}
+    </figure>)}
+  </section>;
+}
