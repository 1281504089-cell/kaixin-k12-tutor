@@ -0,0 +1,62 @@
+import { fireEvent, render, screen } from "@testing-library/react";
+import { expect, it, vi } from "vitest";
+import PlainChoiceCards from "@/components/chat/home/PlainChoiceCards";
+import { choiceAnswerText, plainChoiceQuestions } from "@/lib/plain-choice-questions";
+import type { StreamEvent } from "@/features/chat/model/protocol";
+
+const question = String.raw`已知 $f(x)=x^2-2x$，下列哪个是它的最小值？
+A. $-1$
+B. $0$
+C. $1$
+D. $2$`;
+
+it("preserves mathematical notation and puts the complete question and options in the current composer", () => {
+  const fill = vi.fn().mockReturnValue(true);
+  render(<PlainChoiceCards content={question} onFill={fill} />);
+  fireEvent.click(screen.getByRole("button", { name: /A/ }));
+  const answer = fill.mock.calls[0][0] as string;
+  expect(answer).toContain(String.raw`$f(x)=x^2-2x$`);
+  expect(answer).toContain("D. $2$");
+  expect(answer).toContain("我的选择：A. $-1$");
+  expect(screen.getByRole("status")).toHaveTextContent("已填入当前输入框");
+  expect(screen.getByRole("button", { name: /D/ })).toBeInTheDocument();
+});
+
+it("handles bold/fullwidth labels, inline choices and multiple question blocks", () => {
+  const questions = plainChoiceQuestions("第1题，选出正确的一项：\n**Ａ．** one\n**Ｂ．** two\n\n第2题（多选）：选出所有偶数\nA. 2  B. 3  C. 4  D. 5");
+  expect(questions).toHaveLength(2);
+  expect(questions[0].options.map(option => option.letter)).toEqual(["A", "B"]);
+  expect(questions[1].multiple).toBe(true);
+  expect(questions[1].options).toHaveLength(4);
+  expect(plainChoiceQuestions("请选择：\n**A**. one\n**B**. two")).toHaveLength(1);
+  expect(choiceAnswerText(questions[1], ["C", "A"])).toContain("我的选择：A. 2；C. 4");
+});
+
+it("requires explicit multiple selection and waits for the fill action", () => {
+  const fill = vi.fn().mockReturnValue(true);
+  expect(plainChoiceQuestions("多选：下列哪些是偶数？\nA. 2\nB. 3\nC. 4")).toHaveLength(1);
+  render(<PlainChoiceCards content={"多选：下列哪些是偶数？\nA. 2\nB. 3\nC. 4"} onFill={fill} />);
+  fireEvent.click(screen.getByRole("button", { name: /^A\s*2$/ }));
+  fireEvent.click(screen.getByRole("button", { name: /^C\s*4$/ }));
+  expect(fill).not.toHaveBeenCalled();
+  fireEvent.click(screen.getByRole("button", { name: "填入答案" }));
+  expect(fill.mock.calls[0][0]).toContain("我的选择：A. 2；C. 4");
+});
+
+it.each([
+  "常用方法：\nA. 分析\nB. 检查",
+  "请选择：\nA. one\nC. three",
+  "请选择：\nA. one\nB. two\nB. duplicated",
+  "请选择：\n```text\nA. one\nB. two\n```",
+  "> 请选择：\n> A. one\n> B. two",
+  "请选择：\nA. one\nB. two\n答案：A",
+  "请选择：\nA. one\nB. two\n**答案**：A",
+])("does not guess a card from prose, broken options, quoted text, code or an answer key", content => {
+  expect(plainChoiceQuestions(content)).toEqual([]);
+});
+
+it("does not duplicate a native ask_user card", () => {
+  const events = [{ type: "tool_result", content: "", metadata: { tool: "ask_user", tool_metadata: { ask_user: { questions: [{ id: "q", prompt: "Which?", options: ["A", "B"] }] } } } }] as unknown as StreamEvent[];
+  render(<PlainChoiceCards content={question} events={events} onFill={() => true} />);
+  expect(screen.queryByLabelText("选择题快捷作答")).not.toBeInTheDocument();
+});
