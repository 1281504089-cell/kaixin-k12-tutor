+        raise ValueError("未配置可用的 DeepSeek high 数学审图模型，图形尚未通过核对。")
+    config = config.model_copy(update={"reasoning_effort": "high"})
+    messages = diagram_messages(context, inputs, review_system, config)
+    key = hashlib.sha256(json.dumps(messages, ensure_ascii=False).encode()).hexdigest()
+    cache = context.extension("math_diagram_reviews")
+    if key in cache:
+        return cache[key]
+    outcome = StreamOutcome()
+    started = time.perf_counter()
+    token = set_scoped_llm_config(config)
+    try:
+        async with asyncio.timeout(90):
+            raw = "".join([chunk async for chunk in stream(
+                "", messages=messages, max_retries=0, outcome=outcome, allow_image_fallback=False,
+                max_tokens=max(8192, config.max_tokens), response_format={"type": "json_object"},
+            )])
+    finally:
+        reset_scoped_llm_config(token)
+        if usage is not None and outcome.usage:
+            usage.add_from_response(outcome.usage)
+    if outcome.truncated:
+        raise ValueError("数学核对达到输出上限，未把不完整结果交付给学生。")
+    review = json.loads(re.sub(r"<think\b[^>]*>.*?</think>", "", raw, flags=re.S | re.I).strip())
+    if not isinstance(review, dict) or not isinstance(review.get("issues"), list) or not isinstance(review.get("checks"), list):
+        raise ValueError("数学核对没有返回完整结论。")
+    review["approved"] = review.get("approved") is True and review["issues"] == [] and bool(review["checks"])
+    review.update(model=config.model, reasoning_effort="high", seconds=round(time.perf_counter() - started, 3), usage=outcome.usage or None)
+    cache[key] = review
+    return review
