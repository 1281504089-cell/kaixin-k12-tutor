+++ b/deeptutor/visualizers/static_math.py
@@ -0,0 +1,175 @@
+"""Deterministic SVG plots from small mathematical data, without executing model code."""
+
+from __future__ import annotations
+
+import ast
+from html import escape
+import math
+import operator
+
+# shortcut: this fast path covers 2D data plots; use existing GeoGebra/Manim modes for 3D or narrated scenes.
+
+STATIC_RULES = """只输出严格 JSON 绘图数据，不输出 SVG、HTML、逐点曲线路径或代码。
+结构：{"title":"中文短标题","description":"一句图解","view":[xmin,xmax,ymin,ymax],
+"functions":[{"expression":"x**2-2*x","label":"f(x)=x²−2x"}],
+"points":[{"xy":[2,0],"label":"A(2,0)"}],
+"lines":[{"from":[0,0],"to":[2,0],"label":"线段AB","dashed":false,"arrow":false}],
+"circles":[{"center":[0,0],"radius":1,"label":"圆O"}]}。
+所有数组都必需，没有则 []；坐标和半径是数值。坐标范围须包含完整题设和必要图元，并留标注空间。
+公式只用 x、数字、pi、e、+ - * / **，以及 sin/cos/tan/sqrt/log/exp/abs；表达式用于本机精确采样。
+最多4条函数、24个线段、16个点、8个圆，禁止编造题设。标签用可直接阅读的数学符号，不写 LaTeX 源码。
+静态示意图按原题表达必要条件，切线/投影等由正确坐标决定。仅实现当前题目需要的图形。"""
+
+COLORS = ("#2962A3", "#B54B25", "#397B63", "#7456A6")
+OPS = {ast.Add: operator.add, ast.Sub: operator.sub, ast.Mult: operator.mul, ast.Div: operator.truediv, ast.Pow: operator.pow}
+FUNCS = {name: getattr(math, name) for name in ("sin", "cos", "tan", "sqrt", "log", "exp")}
+FUNCS["abs"] = abs
+
+
+def number(value):
+    if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value) or abs(value) > 1e6:
+        raise ValueError("绘图数值必须有限，且绝对值不超过一百万")
+    return float(value)
+
+
+def math_expression(expression, parameters=None):
+    parameters = parameters or {}
+    tree = ast.parse(expression, mode="eval")
+    if len(list(ast.walk(tree))) > 50:
+        raise ValueError("函数表达式过于复杂")
+
+    def calculate(node, x):
+        if isinstance(node, ast.Expression):
+            return calculate(node.body, x)
+        if isinstance(node, ast.Constant):
+            return number(node.value)
+        if isinstance(node, ast.Name) and node.id in {"x", "pi", "e", *parameters}:
+            return {"x": x, "pi": math.pi, "e": math.e, **parameters}[node.id]
+        if isinstance(node, ast.UnaryOp) and isinstance(node.op, (ast.UAdd, ast.USub)):
+            return calculate(node.operand, x) * (-1 if isinstance(node.op, ast.USub) else 1)
+        if isinstance(node, ast.BinOp) and type(node.op) in OPS:
+            left, right = calculate(node.left, x), calculate(node.right, x)
+            if isinstance(node.op, ast.Pow) and abs(right) > 12:
+                raise ValueError("函数指数超过安全范围")
+            return OPS[type(node.op)](left, right)
+        if isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and node.func.id in FUNCS and len(node.args) == 1 and not node.keywords:
+            return FUNCS[node.func.id](calculate(node.args[0], x))
+        raise ValueError("只支持声明的数学表达式，不执行代码")
+
+    # Validate syntax even when the plotted interval has domain gaps.
+    allowed = (ast.Expression, ast.Constant, ast.Name, ast.Load, ast.UnaryOp, ast.UAdd, ast.USub, ast.BinOp, ast.Call, *OPS)
+    if any(not isinstance(node, allowed) for node in ast.walk(tree)):
+        raise ValueError("不支持的数学表达式")
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Name) and node.id not in {"x", "pi", "e", *FUNCS, *parameters}:
+            raise ValueError("不支持的函数名称")
+        if isinstance(node, ast.Constant):
+            number(node.value)
+    return lambda x: calculate(tree, x)
+
+
+def render_static_math(data):
+    xmin, xmax, ymin, ymax = [number(value) for value in data["view"]]
+    if not xmin < xmax or not ymin < ymax or min(xmax - xmin, ymax - ymin) < 1e-6:
+        raise ValueError("无效绘图范围")
+    limits = {"functions": 4, "lines": 24, "points": 16, "circles": 8}
+    for key, maximum in limits.items():
+        if not isinstance(data[key], list) or len(data[key]) > maximum:
+            raise ValueError(f"绘图 {key} 超过支持范围")
+    if not any(data[key] for key in limits):
+        raise ValueError("不能交付空白图")
+    title = str(data["title"])
+    if not title or len(title) > 40:
+        raise ValueError("标题为空或过长")
+    # Equal units on both axes keep geometry, angles and circles honest.
+    scale = min(640 / (xmax - xmin), 400 / (ymax - ymin))
+    left, top = 80 + (640 - (xmax - xmin) * scale) / 2, 60 + (400 - (ymax - ymin) * scale) / 2
+    width, height = (xmax - xmin) * scale, (ymax - ymin) * scale
+    def xy(point):
+        x, y = [number(value) for value in point]
+        return left + (x - xmin) * scale, top + (ymax - y) * scale
+    def label(value):
+        text = str(value)
+        if len(text) > 36 or any(char in text for char in "\\$\n\r"):
+            raise ValueError("请使用简短、可直接阅读的数学标注")
+        return escape(text)
+    def line(start, end, color, dashed=False):
+        x, y = xy(start)
+        ex, ey = xy(end)
+        return f'<line x1="{x:.3f}" y1="{y:.3f}" x2="{ex:.3f}" y2="{ey:.3f}" stroke="{color}" stroke-width="2"'+ (' stroke-dasharray="6 5"' if dashed else '') + '/>'
+    axes = []
+    if xmin <= 0 <= xmax:
+        axes.append(line([0,ymin], [0,ymax], "#939CA6"))
+    if ymin <= 0 <= ymax:
+        axes.append(line([xmin,0], [xmax,0], "#939CA6"))
+    parts = [f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 960 520"><title>{escape(title)}</title><desc>{escape(str(data["description"]))}</desc>', '<rect width="960" height="520" fill="#fff"/>', f'<text x="80" y="30" font-size="22" fill="#24333D">{escape(title)}</text>', f'<defs><clipPath id="plot"><rect x="{left}" y="{top}" width="{width}" height="{height}"/></clipPath><marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="context-stroke"/></marker></defs>', '<g clip-path="url(#plot)">', *axes]
+    legend, samples = [], []
+    for index, curve in enumerate(data["functions"]):
+        fn = math_expression(curve["expression"])
+        color = COLORS[index % len(COLORS)]
+        segments, previous, visible = [], None, False
+        for step in range(241):
+            x = xmin + (xmax - xmin) * step / 240
+            try:
+                y = fn(x)
+                if isinstance(y, complex) or not math.isfinite(y):
+                    raise ValueError("函数不定义")
+            except (ValueError, OverflowError, ZeroDivisionError, TypeError):
+                previous = None
+                continue
+            px, py = xy([x, max(ymin - 2 * (ymax-ymin), min(ymax + 2 * (ymax-ymin), y))])
+            visible = visible or ymin <= y <= ymax
+            command = "M" if previous is None or abs(py - previous) > height else "L"
+            segments.append(f"{command}{px:.2f},{py:.2f}")
+            previous = py
+        if not segments or not visible:
+            raise ValueError("函数在当前范围无可画部分")
+        parts.append(f'<path d="{" ".join(segments)}" stroke="{color}" stroke-width="2.5" fill="none"/>')
+        legend.append((label(curve["label"]), color))
+        sample = []
+        for x in (xmin, (xmin+xmax)/2, xmax):
+            try:
+                sample.append([x, number(fn(x))])
+            except (ValueError, OverflowError, ZeroDivisionError, TypeError):
+                sample.append([x, None])
+        samples.append({"expression": curve["expression"], "samples": sample})
+    for index, item in enumerate(data["lines"]):
+        color = COLORS[index % len(COLORS)]
+        segment = line(item["from"], item["to"], color, item.get("dashed", False))
+        if item.get("arrow") is True:
+            segment = segment[:-2] + ' marker-end="url(#arrow)"/>'
+        parts.append(segment)
+        if item.get("label"):
+            legend.append((label(item["label"]), color))
+    for item in data["circles"]:
+        x, y = xy(item["center"])
+        radius = number(item["radius"])
+        if radius <= 0:
+            raise ValueError("圆半径必须为正")
+        parts.append(f'<circle cx="{x}" cy="{y}" r="{radius*scale}" fill="none" stroke="{COLORS[0]}" stroke-width="2"/>')
+        if item.get("label"):
+            legend.append((label(item["label"]), COLORS[0]))
+    parts.append('</g>')
+    boxes = []
+    for point in data["points"]:
+        x, y = xy(point["xy"])
+        if not left <= x <= left+width or not top <= y <= top+height:
+            raise ValueError("题目关键点超出绘图范围")
+        text = label(point["label"])
+        tw = sum(18 if ord(char) > 255 else 10 for char in str(point["label"]))
+        for dx, dy in ((10,-12),(10,24),(-tw-10,-12),(-tw-10,24),(10,-34)):
+            box = (x+dx, y+dy-18, x+dx+tw, y+dy+4)
+            if box[0] < 30 or box[2] > 740 or box[1] < 36 or box[3] > 490:
+                continue
+            if all(box[2] <= b[0] or box[0] >= b[2] or box[3] <= b[1] or box[1] >= b[3] for b in boxes):
+                boxes.append(box)
+                parts.append(f'<circle cx="{x}" cy="{y}" r="4" fill="#24333D"/><text x="{x+dx}" y="{y+dy}" font-size="17" fill="#24333D">{text}</text>')
+                break
+        else:
+            raise ValueError("关键点标注无法排开，请扩大图形范围或简化标签")
+    if len(legend) > 16:
+        raise ValueError("图例过多")
+    for index, (text, color) in enumerate(legend):
+        parts.append(f'<text x="755" y="{75+index*25}" font-size="16" fill="{color}">{text}</text>')
+    parts.append(f'<text x="80" y="505" font-size="13" fill="#66717C">x: {xmin:g} 至 {xmax:g}　y: {ymin:g} 至 {ymax:g}　横纵单位等比例</text></svg>')
+    return ''.join(parts), samples
diff --git a/deeptutor/visualizers/tool.py b/deeptutor/visualizers/tool.py
