new file mode 100644
index 0000000000000000000000000000000000000000..572e153b05d49ea4ed0c899ac88c72966b3c0c27
--- /dev/null
+++ b/tests/visualizers/test_math_diagram.py
@@ -0,0 +1,171 @@
+import json
+from unittest.mock import AsyncMock
+
+import pytest
+
+from deeptutor.core.context import UnifiedContext
+from deeptutor.runtime.agentic.usage import UsageTracker
+from deeptutor.services.llm.config import LLMConfig
+from deeptutor.visualizers.builtin import _geogebra_validator
+from deeptutor.visualizers.protocol import VISUALIZATION_RESULT_KEY
+import deeptutor.visualizers.math_tool as drawing
+import deeptutor.visualizers.math_review as checking
+from deeptutor.visualizers.static_math import math_expression, render_static_math
+from deeptutor.visualizers.interactive_math import build_interactive_math
+
+SVG = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 240"><title>线段中垂线</title><desc>A、B关于纵轴对称，P在纵轴上</desc><path d="M80 180 L200 60 L320 180 Z" fill="none" stroke="black"/></svg>'
+
+SPEC = {"title": "线段中垂线", "description": "A、B关于纵轴对称，P在纵轴上", "view": [-3,3,-1,3], "functions": [], "lines": [{"from": [-2,0], "to": [0,2]}, {"from": [2,0], "to": [0,2]}], "points": [{"xy": [0,2], "label": "P"}], "circles": []}
+
+
+@pytest.fixture
+def model(monkeypatch):
+    config = LLMConfig(model="deepseek-flash", api_key="not-a-real-key", provider_name="deepseek", reasoning_effort="low", max_tokens=16384)
+    for module in (drawing, checking):
+        monkeypatch.setattr(module, "figure_model_config", lambda _: config)
+        monkeypatch.setattr(module, "get_llm_config", lambda: config)
+    return config
+
+
+def fake_response(text, finish="stop"):
+    async def generate(*args, outcome, **kwargs):
+        from deeptutor.services.llm.config import get_llm_config
+
+        assert get_llm_config().reasoning_effort == "high"
+        assert kwargs["max_retries"] == 0
+        outcome.finish_reason = finish
+        outcome.usage = {"prompt_tokens": 100, "completion_tokens": 200, "total_tokens": 300}
+        yield "<think>private</think>" + text
+    return generate
+
+
+@pytest.mark.asyncio
+async def test_static_default_reuses_renderer_and_counts_generation_and_independent_review(monkeypatch, model):
+    monkeypatch.setattr(drawing, "stream", fake_response(json.dumps(SPEC)))
+    monkeypatch.setattr(checking, "stream", fake_response('{"approved":true,"issues":[],"checks":["PA=PB"]}'))
+    context = UnifiedContext(user_message="A(-2,0)、B(2,0)、P(0,2)，说明PA=PB。")
+    usage = UsageTracker(model=model.model)
+    result = await drawing.MathDiagramTool().execute(question=context.user_message, _diagram_context=context, _diagram_usage=usage)
+    assert result.success
+    assert result.metadata["math_figure"]["render_type"] == "svg"
+    assert result.metadata["math_review"]["approved"] is True
+    assert result.metadata["reasoning_effort"] == "high"
+    assert usage.calls == 2 and usage.total_tokens == 600
+    assert "<svg" in context.metadata[VISUALIZATION_RESULT_KEY]["payload"]["data"]
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("reply", ['{"approved":true,"issues":["坐标不符"],"checks":["x=2"]}', '{"approved":true,"issues":[],"checks":[]}', '{"approved":false,"issues":["缺少原始条件"],"checks":[]}'])
+async def test_unverified_or_conflicting_figures_never_get_published(monkeypatch, model, reply):
+    monkeypatch.setattr(drawing, "stream", fake_response(json.dumps(SPEC)))
+    monkeypatch.setattr(checking, "stream", fake_response(reply))
+    context = UnifiedContext(user_message="证明两边相等")
+    result = await drawing.MathDiagramTool().execute(question=context.user_message, _diagram_context=context)
+    assert not result.success
+    assert VISUALIZATION_RESULT_KEY not in context.metadata
+    assert "math_figure" not in (result.metadata or {})
+
+
+@pytest.mark.asyncio
+async def test_output_limit_ends_without_an_extra_review_or_silent_retry(monkeypatch, model):
+    monkeypatch.setattr(drawing, "stream", fake_response("{", finish="length"))
+    review = AsyncMock()
+    monkeypatch.setattr(drawing.SubmitVisualizationTool, "execute", review)
+    result = await drawing.MathDiagramTool().execute(question="画抛物线", _diagram_context=UnifiedContext(user_message="画抛物线"))
+    assert not result.success and "输出上限" in result.content
+    review.assert_not_called()
+
+
+@pytest.mark.asyncio
+async def test_same_candidate_review_is_cached_only_within_its_original_context(monkeypatch, model):
+    calls = []
+    async def generate(*args, **kwargs):
+        calls.append(kwargs["messages"])
+        yield '{"approved":true,"issues":[],"checks":["已核对原题"]}'
+    monkeypatch.setattr(checking, "stream", generate)
+    context = UnifiedContext(user_message="题目A")
+    await checking.review_math_diagram(context, SVG, rules="数学老师完整规则")
+    await checking.review_math_diagram(context, SVG, rules="数学老师完整规则")
+    assert len(calls) == 1
+    assert "数学老师完整规则" in calls[0][1]["content"]
+    context.user_message = "题目B"
+    await checking.review_math_diagram(context, SVG, rules="数学老师完整规则")
+    assert len(calls) == 2
+
+
+@pytest.mark.parametrize("bound", [float("nan"), float("inf"), True])
+def test_geogebra_bounds_reject_nonfinite_and_boolean_values(bound):
+    ok, _, error = _geogebra_validator(json.dumps({"commands": ["A=(0,0)", "B=(2,0)"], "view": {"x_min": bound, "x_max": 4, "y_min": -2, "y_max": 4}}))
+    assert not ok and "finite" in error
+
+
+def test_static_curves_are_locally_calculated_and_geometry_keeps_equal_axes():
+    from xml.etree import ElementTree
+    spec = {**SPEC, "functions": [{"expression": "x**2-2*x", "label": "抛物线"}, {"expression": "2*x-4", "label": "切线"}]}
+    svg, samples = render_static_math(spec)
+    root = ElementTree.fromstring(svg)
+    assert root.tag.endswith("svg")
+    assert samples[0]["samples"] == [[-3, 15], [0, 0], [3, 3]]
+    assert samples[1]["samples"] == [[-3, -10], [0, -4], [3, 2]]
+    # The figure's horizontal/vertical scale is a single shared value.
+    assert "横纵单位等比例" in svg
+    assert math_expression("sin(pi/2)+sqrt(4)+abs(-2)")(0) == 5
+
+
+@pytest.mark.parametrize("expression", ["__import__('os').system('id')", "x.__class__", "[x for x in range(3)]", "1e309", "True", "unknown(x)"])
+def test_mathematical_data_never_executes_arbitrary_model_code(expression):
+    with pytest.raises((ValueError, SyntaxError)):
+        math_expression(expression)
+
+
+def test_invisible_or_empty_diagrams_and_raw_latex_labels_are_rejected():
+    with pytest.raises(ValueError):
+        render_static_math({**SPEC, "functions": [{"expression": "10000", "label": "空白曲线"}]})
+    with pytest.raises(ValueError):
+        render_static_math({**SPEC, "points": [{"xy": [0,2], "label": r"$\\frac{1}{2}$"}]})
+
+
+@pytest.mark.asyncio
+async def test_deepseek_high_answer_data_does_not_trigger_a_second_generation(monkeypatch, model):
+    monkeypatch.setattr(drawing, "get_llm_config", lambda: model.model_copy(update={"reasoning_effort": "high"}))
+    generation = AsyncMock()
+    monkeypatch.setattr(drawing, "stream", generation)
+    monkeypatch.setattr(checking, "stream", fake_response('{"approved":true,"issues":[],"checks":["PA=PB"]}'))
+    usage = UsageTracker(model=model.model)
+    result = await drawing.MathDiagramTool().execute(question="已知两边对称", specification=json.dumps(SPEC), _diagram_context=UnifiedContext(user_message="已知两边对称"), _diagram_usage=usage)
+    assert result.success
+    assert result.metadata["generation_source"] == "answer_tool_arguments"
+    assert usage.calls == 1
+    generation.assert_not_called()
+
+
+def test_parameter_compiler_builds_local_dependencies_and_separates_controls():
+    result = json.loads(build_interactive_math({"view": [-5,5,-3,9], "parameters": [{"name":"a", "min":0.5, "max":2, "step":0.1, "value":1}, {"name":"h", "min":-2, "max":2, "step":0.1, "value":0}], "functions":[{"name":"f", "expression":"a*(x-h)**2-1"}], "points":[{"name":"V", "xy":["h","-1"]}]}))
+    assert "SetCoords[a,30,40]" in result["commands"]
+    assert "SetCoords[h,30,80]" in result["commands"]
+    assert "f(x)=a*(x-h)^2-1" in result["commands"]
+    assert "V=(h,-1)" in result["commands"]
+
+
+@pytest.mark.asyncio
+async def test_model_cannot_replace_the_payload_seen_by_the_independent_reviewer(monkeypatch):
+    review = AsyncMock(return_value={"approved": True, "issues": [], "checks": ["checked"]})
+    monkeypatch.setattr(checking, "review_math_diagram", review)
+    context = UnifiedContext(user_message="核对当前图")
+    result = await drawing.SubmitVisualizationTool().execute(
+        _visualize_context=context, visualizer="svg", payload=SVG,
+        _require_math_review=True, _math_review_data={"fake": "different diagram"}, _math_data_token="guessed-token",
+    )
+    assert result.success
+    assert review.await_args.args[1] == SVG
+
+
+def test_picture_history_stays_multimodal_without_base64_in_text_or_duplicate_pictures(model):
+    image = {"type": "image_url", "image_url": {"url": "data:image/png;base64," + "A" * 20000}}
+    context = UnifiedContext(conversation_history=[{"role": "user", "content": [{"type": "text", "text": "原题在图中"}, image, image]}])
+    messages = checking.diagram_messages(context, {"question": "给原题配图"}, "完整教师规则", model)
+    parts = messages[-1]["content"]
+    assert len(parts) == 2
+    assert "原题在图中" in parts[0]["text"]
+    assert "data:image" not in parts[0]["text"]
+    assert parts[1] == image
