+import { act, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { beforeEach, expect, it, vi } from 'vitest'
+import type { SidebarShellProps } from '@/components/sidebar/SidebarShell'
+import type { SessionSummary } from '@/lib/session-api'
+import WorkspaceSidebar from '@/components/sidebar/WorkspaceSidebar'
+
+const f = vi.hoisted(() => ({ scope: '', selected: 'same', props: null as SidebarShellProps | null,
+  list: vi.fn(), rename: vi.fn(), remove: vi.fn(), organize: vi.fn(), push: vi.fn(),
+  cancel: vi.fn(), fresh: vi.fn(), configure: vi.fn(), fail: false }))
+vi.mock('react-i18next', () => ({ useTranslation: () => ({ t: (key: string) => key }) }))
+vi.mock('next/navigation', () => ({ useRouter: () => ({ push: f.push }) }))
+vi.mock('@/hooks/useChatWorkspaces', () => ({ useChatWorkspaces: () => ({ workspaces: [] }) }))
+vi.mock('@/components/auth/LogoutButton', () => ({ LogoutButton: () => null }))
+vi.mock('@/components/auth/AdminLink', () => ({ AdminLink: () => null }))
+vi.mock('@/components/auth/ProfileLink', () => ({ ProfileLink: () => null }))
+vi.mock('@/lib/session-unread', () => ({ reconcileUnread: vi.fn() }))
+vi.mock('@/lib/workspace-scope', () => ({ activeWorkspaceId: () => f.scope,
+  scopedUrl: (path: string, scope = f.scope) => `${path}?dt_workspace=${scope}`,
+  navigateTask: (path: string, push: (path: string) => void) => push(path) }))
+vi.mock('@/features/chat/ChatStateAdapter', () => ({ useChatStateAdapter: () => ({
+  newSession: f.fresh, configureSession: f.configure, cancelStreamingTurn: f.cancel,
+  selectedSessionId: f.selected, sessionStatuses: {}, sidebarRefreshToken: 0,
+}) }))
+vi.mock('@/lib/reading-workspace-api', () => ({ fetchReadingCollectionIndex: async () => [] }))
+vi.mock('@/lib/learning-api', () => ({ fetchMasteryTopicIndex: async () => [] }))
+vi.mock('@/lib/session-api', async original => ({ ...await original<typeof import('@/lib/session-api')>(),
+  listAllSessions: f.list, updateSessionTitle: f.rename, deleteSession: f.remove,
+  updateSessionOrganization: f.organize,
+}))
+vi.mock('@/components/sessions/OrganizedSessionList', () => ({ default: (p: {
+  sessions: SessionSummary[]; onSelect: (id: string) => void; onDelete: (id: string) => void;
+}) => <div>{p.sessions.map(s => <div key={s.session_id}>
+  <button onClick={() => p.onSelect(s.session_id)}>{s.title}</button>
+  <button onClick={() => p.onDelete(s.session_id)}>delete {s.title}</button>
+</div>)}</div> }))
+vi.mock('@/features/ui-layout/slots', () => ({ LayoutSidebarShell: (p: SidebarShellProps) => {
+  f.props = p
+  return <div>{p.sessions?.map(s => <span key={s.session_id}>{s.title}</span>)}
+    {p.temporaryHistory?.render({} as never)}</div>
+} }))
+
+const row = (id: string, title: string, scope: string): SessionSummary => ({
+  id, session_id: id, title, created_at: 1, updated_at: 1,
+  message_count: 1, last_message: '', content_workspace_id: scope, preferences: {},
+})
+const rows = [row('same', 'Temporary chat', ''), row('other', 'Another temporary chat', ''),
+  row('same', 'Math chat', 'math'), row('student-study-math-2', 'Mistake explanation', 'math')]
+
+beforeEach(() => {
+  vi.clearAllMocks(); f.scope = ''; f.selected = 'same'; f.fail = false
+  f.list.mockImplementation(async (options: { allWorkspaces?: boolean }) => {
+    if (f.fail) throw new Error('offline')
+    return structuredClone(options.allWorkspaces ? rows : rows.filter(s => s.content_workspace_id === f.scope))
+  })
+  f.rename.mockResolvedValue({ title: 'Renamed', updated_at: 2 })
+  f.organize.mockResolvedValue({ updated_at: 2, preferences: { workspace_id: 'math' } })
+  f.remove.mockResolvedValue(undefined)
+  vi.spyOn(window, 'confirm').mockReturnValue(true)
+})
+
+it('retains General temporary chats after entering a subject mistake conversation and navigates back to their store', async () => {
+  const first = render(<WorkspaceSidebar />)
+  await screen.findByText('Temporary chat')
+  first.unmount(); f.scope = 'math'; f.selected = 'student-study-math-2'
+  render(<WorkspaceSidebar />)
+  fireEvent.click(await screen.findByRole('button', { name: 'Temporary chat' }))
+  expect(screen.getByText('Another temporary chat')).toBeInTheDocument()
+  expect(screen.getByText('Mistake explanation')).toBeInTheDocument()
+  expect(f.list).toHaveBeenLastCalledWith({ force: true, allWorkspaces: true })
+  expect(f.push).toHaveBeenCalledWith('/chat/same?dt_workspace=')
+  expect(f.remove).not.toHaveBeenCalled()
+})
+
+it('deletes only the confirmed temporary chat, even when the open project reuses its id', async () => {
+  f.scope = 'math'
+  render(<WorkspaceSidebar />)
+  const remove = await screen.findByRole('button', { name: 'delete Temporary chat' })
+  vi.mocked(window.confirm).mockReturnValueOnce(false)
+  fireEvent.click(remove)
+  expect(f.remove).not.toHaveBeenCalled()
+  fireEvent.click(remove)
+  await waitFor(() => expect(screen.queryByRole('button', { name: 'Temporary chat' })).toBeNull())
+  expect(f.remove).toHaveBeenCalledWith('same', '')
+  expect(screen.getByText('Math chat')).toBeInTheDocument()
+  expect(f.cancel).not.toHaveBeenCalled()
+  expect(f.fresh).not.toHaveBeenCalled()
+})
+
+it('renames and files chats in the explicit source store without modifying a same-id project chat', async () => {
+  f.scope = 'math'; render(<WorkspaceSidebar />)
+  await screen.findByRole('button', { name: 'Temporary chat' })
+  await act(async () => { await f.props!.onRenameSession!('same', 'Renamed', '') })
+  expect(f.rename).toHaveBeenCalledWith('same', 'Renamed', '')
+  expect(screen.getByText('Math chat')).toBeInTheDocument()
+  await act(async () => { await f.props!.onOrganizeSession!('same', { workspace_id: 'math' }, '') })
+  expect(f.organize).toHaveBeenCalledWith('same', { workspace_id: 'math' }, '')
+  expect(f.configure).not.toHaveBeenCalled()
+  expect(f.push).not.toHaveBeenCalled()
+  expect(screen.queryByRole('button', { name: 'Renamed' })).toBeNull()
+})
+
+it('keeps loaded chats visible when refresh fails and retries without clearing records', async () => {
+  f.scope = 'math'; render(<WorkspaceSidebar />)
+  await screen.findByRole('button', { name: 'Temporary chat' })
+  f.fail = true
+  const report = vi.spyOn(console, 'error').mockImplementation(() => {})
+  await act(async () => { f.props!.onRetrySessions!() })
+  await waitFor(() => expect(f.props!.sessionLoadError).toBe(true))
+  expect(screen.getByRole('button', { name: 'Temporary chat' })).toBeInTheDocument()
+  expect(f.remove).not.toHaveBeenCalled()
+  f.fail = false
+  await act(async () => { f.props!.onRetrySessions!() })
+  await waitFor(() => expect(f.props!.sessionLoadError).toBe(false))
+  report.mockRestore()
+})
