+import { test, expect } from '@playwright/test'
+import catalog from '../lib/student-prompts/catalog.json'
+import { sourceModuleInventory } from './e2e/fixtures/modules'
+
+for (const viewport of [{ width: 1920, height: 1080 }, { width: 1180, height: 700 }, { width: 800, height: 1100 }, { width: 390, height: 844 }]) {
+  test(`project menus and General history at ${viewport.width}x${viewport.height}`, async ({ page }) => {
+    await page.setViewportSize(viewport)
+    await page.addInitScript(() => localStorage.setItem('deeptutor-language', 'en'))
+    const projects = catalog.studyProjects.map(subject => ({ subject: subject.id, name: subject.name,
+      workspace_id: `ws-${subject.id}`, conversations: subject.id === 'math' ? [{ session_id: 'math-new', title: '数学练习自建会话', mode: '' }] : [] }))
+    let rows = [{ id: 'math-new', session_id: 'math-new', title: '数学练习自建会话', content_workspace_id: 'ws-math', preferences: {}, created_at: 1, updated_at: 2, message_count: 1, last_message: '' },
+      { id: 'general-chat', session_id: 'general-chat', title: '保留的临时对话', content_workspace_id: '', preferences: {}, created_at: 1, updated_at: 2, message_count: 1, last_message: '' }]
+    const removed: string[] = []
+    await page.route('**/api/**', async route => {
+      const url = new URL(route.request().url()); const path = url.pathname
+      if (path === '/api/modules') return route.fulfill({ json: sourceModuleInventory })
+      if (path === '/api/auth/status') return route.fulfill({ json: { enabled: false, authenticated: true, role: 'admin', user_id: 'isolated-audit' } })
+      if (path === '/api/settings/ui') return route.fulfill({ json: { language: 'en' } })
+      if (path === '/api/settings/workspace/student-study') return route.fulfill({ json: projects })
+      if (path === '/api/settings/workspace/registrations') return route.fulfill({ json: { workspaces: projects.map(p => ({ ...p, kind: 'workspace', display_name: p.name, status: 'ready', archived: false })) } })
+      if (path === '/api/sessions') return route.fulfill({ json: { sessions: rows, unavailable_workspaces: [] } })
+      if (path === '/api/sessions/math-new' && route.request().method() === 'DELETE') {
+        removed.push(url.searchParams.get('dt_workspace') ?? 'missing')
+        rows = rows.filter(row => row.session_id !== 'math-new'); projects.find(p => p.subject === 'math')!.conversations = []
+        return route.fulfill({ json: { deleted: true } })
+      }
+      if (path === '/api/partners' || path === '/api/partner-groups') return route.fulfill({ json: [] })
+      return route.fulfill({ status: 404, json: { detail: 'Unused isolated audit endpoint' } })
+    })
+    await page.goto('/chat?dt_workspace=ws-math')
+    if (viewport.width < 768) await page.getByRole('button', { name: 'Open navigation' }).click()
+    const history = page.getByText('保留的临时对话', { exact: true })
+    await expect(history).toBeVisible()
+    const add = page.getByRole('button', { name: '在数学中新建对话' })
+    await expect(add).toBeVisible()
+    await expect(add).toHaveCSS('opacity', await page.evaluate(() => matchMedia('(pointer: coarse)').matches) ? '0.65' : '0.35')
+    const row = page.locator('#student-project-math').getByRole('button').filter({ has: page.getByText('数学练习自建会话', { exact: true }) })
+    await expect(row).toBeVisible()
+    await row.hover()
+    await row.getByRole('button', { name: 'Conversation actions' }).click()
+    await expect(page.getByRole('menuitem', { name: 'Rename chat' })).toBeVisible()
+    const menu = page.getByRole('menu')
+    const box = await menu.boundingBox()
+    expect(box!.x).toBeGreaterThanOrEqual(0)
+    expect(box!.x + box!.width).toBeLessThanOrEqual(viewport.width)
+    expect(box!.y + box!.height).toBeLessThanOrEqual(viewport.height)
+    await page.screenshot({ path: `test-results/project-history-${viewport.width}.png` })
+    page.once('dialog', dialog => dialog.accept())
+    await page.getByRole('menuitem', { name: 'Delete chat' }).click()
+    await expect.poll(() => removed).toEqual(['ws-math'])
+    await expect(history).toBeVisible()
+  })
+}
