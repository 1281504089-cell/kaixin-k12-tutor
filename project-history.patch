+import { afterEach, expect, it, vi } from 'vitest'
+import { listAllSessions } from '@/lib/session-api'
+
+afterEach(() => vi.unstubAllGlobals())
+
+it('does not treat an unreadable General store as an empty history', async () => {
+  vi.stubGlobal('fetch', vi.fn(async () => Response.json({ sessions: [], unavailable_workspaces: [''] })))
+  await expect(listAllSessions({ force: true, allWorkspaces: true })).rejects.toThrow('General conversation history could not be read')
+})
+
+it('accepts a genuinely empty history and tolerates an unavailable unrelated project', async () => {
+  vi.stubGlobal('fetch', vi.fn(async () => Response.json({ sessions: [], unavailable_workspaces: ['math'] })))
+  await expect(listAllSessions({ force: true, allWorkspaces: true })).resolves.toEqual([])
+})
