diff --git a/web/features/chat/components/camera-tutor-media.ts b/web/features/chat/components/camera-tutor-media.ts
index ae72079..2e9eb0d 100644
--- a/web/features/chat/components/camera-tutor-media.ts
+++ b/web/features/chat/components/camera-tutor-media.ts
@@ -1,16 +1,27 @@
 import { extractBase64FromDataUrl } from "@/lib/file-attachments";
 
-export function captureWorksheet(video: HTMLVideoElement) {
+export type CameraOrientation = { rotation: number; mirrored: boolean };
+
+export function captureWorksheet(
+  video: HTMLVideoElement,
+  { rotation, mirrored }: CameraOrientation,
+) {
   const { videoWidth, videoHeight } = video;
   if (video.readyState < 2 || !videoWidth || !videoHeight) {
     throw new Error("试卷画面还没准备好，请稍后再问。");
   }
   const canvas = document.createElement("canvas");
   const scale = Math.min(1, 2560 / Math.max(videoWidth, videoHeight));
-  canvas.width = Math.round(videoWidth * scale);
-  canvas.height = Math.round(videoHeight * scale);
+  const width = Math.max(1, Math.round(videoWidth * scale));
+  const height = Math.max(1, Math.round(videoHeight * scale));
+  const sideways = rotation % 180 !== 0;
+  canvas.width = sideways ? height : width;
+  canvas.height = sideways ? width : height;
   const context = canvas.getContext("2d");
   if (!context) throw new Error("暂时无法截取试卷画面。");
-  context.drawImage(video, 0, 0, canvas.width, canvas.height);
+  context.translate(canvas.width / 2, canvas.height / 2);
+  if (mirrored) context.scale(-1, 1);
+  context.rotate(rotation * Math.PI / 180);
+  context.drawImage(video, -width / 2, -height / 2, width, height);
   return extractBase64FromDataUrl(canvas.toDataURL("image/jpeg", 0.9));
 }
