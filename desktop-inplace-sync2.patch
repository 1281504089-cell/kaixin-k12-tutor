new file mode 100644
index 0000000..f2794cf
--- /dev/null
+++ b/apps/desktop/scripts/check-update-batch.mjs
@@ -0,0 +1,38 @@
+import { readFile, stat } from 'node:fs/promises';
+import path from 'node:path';
+import { pathToFileURL } from 'node:url';
+import { sha256, verifyManifest } from '../src/bundles.mjs';
+
+export const UPDATE_TARGETS = {
+  'macos-arm64': ['arm64', 'darwin'],
+  'macos-x64': ['x64', 'darwin'],
+  'windows-x64': ['x64', 'win32'],
+};
+
+/** No single-platform signed feed may be presented as a synchronized release. */
+export async function checkUpdateBatch(directory, publicKey) {
+  const rows = [];
+  for (const [target, [arch, platform]] of Object.entries(UPDATE_TARGETS)) {
+    const file = path.join(directory, `runtime-${target}.json`);
+    if ((await stat(file)).size > 16 * 1024) throw new Error(`Oversized update manifest: ${target}`);
+    const manifest = verifyManifest(JSON.parse(await readFile(file, 'utf8')), publicKey, arch, platform);
+    if (!/^[a-f0-9]{40}$/.test(manifest.commit) || !manifest.builtAt || !manifest.coreVersion) {
+      throw new Error(`Missing release identity: ${target}`);
+    }
+    const archive = path.join(directory, manifest.archive);
+    if ((await stat(archive)).size > 2 * 1024 ** 3 || await sha256(archive) !== manifest.sha256) {
+      throw new Error(`Invalid update archive: ${target}`);
+    }
+    if (rows.some(row => row.commit !== manifest.commit || row.builtAt !== manifest.builtAt
+      || row.coreVersion !== manifest.coreVersion)) throw new Error('The three update targets must share one source, version and batch');
+    rows.push({ ...manifest, target });
+  }
+  return rows;
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(path.resolve(process.argv[1])).href) {
+  if (!process.argv[2]) throw new Error('Usage: node scripts/check-update-batch.mjs DIRECTORY [PUBLIC_KEY]');
+  const publicKey = await readFile(process.argv[3] || new URL('../assets/runtime-public.pem', import.meta.url));
+  const rows = await checkUpdateBatch(path.resolve(process.argv[2]), publicKey);
+  console.log(JSON.stringify({ passed: true, commit: rows[0].commit, targets: rows.map(row => row.target) }));
+}
