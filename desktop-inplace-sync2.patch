index 0000000..c79ccef
--- /dev/null
+++ b/apps/desktop/scripts/select-offline-update.mjs
@@ -0,0 +1,49 @@
+import { readFile, stat, writeFile } from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+import { sha256, verifyManifest } from '../src/bundles.mjs';
+import { targetId } from '../src/platform.mjs';
+
+async function manifestAt(file, key, arch, platform) {
+  if ((await stat(file)).size > 16 * 1024) throw new Error('更新元数据过大，已停止。');
+  return verifyManifest(JSON.parse(await readFile(file, 'utf8')), key, arch, platform);
+}
+
+/** Read installed identities; write the selected public manifest only into the unpacked update folder. */
+export async function selectOfflineUpdate(directory, userRoot, publicKey, platform = process.platform) {
+  const activeFile = path.join(userRoot, 'active.json');
+  if ((await stat(activeFile)).size > 16 * 1024) throw new Error('安装版本信息异常，已停止。');
+  const active = JSON.parse(await readFile(activeFile, 'utf8'));
+  verifyManifest(active, publicKey, active.arch, platform);
+  const baseId = active.baseRuntimeId || active.runtimeId;
+  const base = await manifestAt(path.join(userRoot, 'runtimes', baseId, 'installed.json'), publicKey, active.arch, platform);
+  if (base.runtimeId !== baseId || base.baseRuntimeId) throw new Error('现有运行环境信息不匹配，未更改程序。');
+  const target = targetId(platform, active.arch);
+  for (const suffix of ['', '-early']) {
+    const manifest = await manifestAt(path.join(directory, `runtime-${target}${suffix}.json`), publicKey, active.arch, platform);
+    if (manifest.baseRuntimeId !== baseId) continue;
+    if (manifest.builtAt <= (active.builtAt || 0)) throw new Error('现有版本已相同或更新，未执行降级。');
+    if (await sha256(path.join(directory, manifest.archive)) !== manifest.sha256) throw new Error('核心包校验失败，请重新复制完整更新包。');
+    const output = path.join(directory, '选这个文件更新.json');
+    const text = JSON.stringify(manifest, null, 2) + '\n';
+    try { await writeFile(output, text, { flag: 'wx' }); }
+    catch (error) { if (error.code !== 'EEXIST' || await readFile(output, 'utf8') !== text) throw error; }
+    return { file: output, baseRuntimeId: baseId, target };
+  }
+  throw new Error('此安装批次尚无匹配的更新；未更改现有程序和学习记录。');
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(path.resolve(process.argv[1])).href) {
+  try {
+    const script = path.dirname(fileURLToPath(import.meta.url));
+    const directory = process.argv[2] ? path.resolve(process.argv[2]) : path.resolve(script, '../..');
+    const userRoot = process.env.OPEN_DEEPTUTOR_TEST_HOME || path.join(process.platform === 'win32'
+      ? process.env.LOCALAPPDATA || process.env.APPDATA : path.join(os.homedir(), 'Library/Application Support'), '开心动力超级学霸');
+    const result = await selectOfflineUpdate(directory, userRoot, await readFile(new URL('../assets/runtime-public.pem', import.meta.url)));
+    console.log(`已匹配现有运行环境：${result.baseRuntimeId}\n\n请回到已安装的软件，打开「核心 → 安装核心更新」，\n选择本文件夹里的「选这个文件更新.json」，然后确认更新。\n\n不需要卸载或重新安装；本步骤没有改动现有程序、Key和学习记录。`);
+  } catch (error) {
+    console.error('未改动已安装的程序或学习记录。\n' + error.message);
+    process.exitCode = 1;
+  }
+}
