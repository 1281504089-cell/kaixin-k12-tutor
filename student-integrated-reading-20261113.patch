+
+const fixture = vi.hoisted(() => ({ path: '/chat/original', workspace: 'math', principal: 'alice', push: vi.fn(), commands: vi.fn(), stop: vi.fn(), clients: vi.fn() }))
+const router = { push: fixture.push }
+vi.mock('@/lib/api', () => ({ wsUrl: (url: string) => `ws://127.0.0.1:8129${url}` }))
+vi.mock('next/navigation', () => ({ useRouter: () => router, usePathname: () => fixture.path }))
+vi.mock('@/lib/workspace-scope', () => ({ activeWorkspaceId: () => fixture.workspace, scopedUrl: (path: string, workspace: string) => `${path}?dt_workspace=${workspace}` }))
+vi.mock('@/lib/recovery-principal', () => ({ recoveryPrincipal: () => fixture.principal, RECOVERY_PRINCIPAL_CHANGED: 'account-change' }))
+vi.mock('@/features/chat/transport/TurnRuntimeClient', () => ({ TurnRuntimeClient: class {
+  constructor(options: unknown) { fixture.clients(options) }
+  connect() {}
+  sendAwaitingAck(command: unknown) { fixture.commands(command); return Promise.resolve(true) }
+  stop() { fixture.stop() }
+} }))
+const request = () => ({ id: 'a'.repeat(32), page: 'mistakes', href: '/mistakes', workspace_id: 'math', expires_at: Date.now() / 1000 + 5 })
+function send(row = request(), foreground = true) {
+  act(() => { window.dispatchEvent(new CustomEvent(APP_NAVIGATION_EVENT, { detail: { request: row, turnId: 'original-turn', foreground } })) })
+}
+beforeEach(() => {
+  vi.clearAllMocks(); fixture.path = '/chat/original'; fixture.workspace = 'math'; fixture.principal = 'alice'
+})
+
+it('navigates and confirms only after the actual route commits', async () => {
+  const view = render(<AppNavigationRuntime />)
+  send()
+  expect(fixture.push).toHaveBeenCalledWith('/mistakes?dt_workspace=math', { scroll: false })
+  expect(fixture.commands).not.toHaveBeenCalled()
+  fixture.path = '/mistakes'
+  view.rerender(<AppNavigationRuntime />)
+  await waitFor(() => expect(fixture.commands).toHaveBeenCalledOnce())
+  const command = fixture.commands.mock.calls[0][0]
+  expect(command.turn_id).toBe('original-turn')
+  expect(JSON.parse(command.text)).toMatchObject({ page: 'mistakes', opened: true })
+  expect(fixture.stop).toHaveBeenCalledOnce()
+  expect(fixture.clients).toHaveBeenCalledWith(expect.objectContaining({ url: 'ws://127.0.0.1:8129/ws?dt_workspace=math' }))
+})
+
+it('works across the utility route group for Notes', async () => {
+  const view = render(<AppNavigationRuntime />)
+  send({ ...request(), page: 'notes', href: '/notebooks' })
+  fixture.path = '/notebooks'; view.rerender(<AppNavigationRuntime />)
+  await waitFor(() => expect(fixture.commands).toHaveBeenCalledOnce())
+  expect(JSON.parse(fixture.commands.mock.calls[0][0].text).opened).toBe(true)
+})
+
+it('refuses external URLs, expired events and mismatched page identifiers', () => {
+  render(<AppNavigationRuntime />)
+  send({ ...request(), href: 'https://example.com' })
+  send({ ...request(), expires_at: 0 })
+  send({ ...request(), href: '/settings/connections' })
+  expect(fixture.push).not.toHaveBeenCalled()
+  expect(validAppNavigation({ ...request(), id: 'wrong' })).toBe(false)
+})
+
+it('does not hijack another chat or workspace for a background action', async () => {
+  render(<AppNavigationRuntime />)
+  send(request(), false)
+  await waitFor(() => expect(fixture.commands).toHaveBeenCalledOnce())
+  expect(JSON.parse(fixture.commands.mock.calls[0][0].text).opened).toBe(false)
+  expect(fixture.push).not.toHaveBeenCalled()
+})
+
+it('does not re-execute replayed requests', () => {
+  render(<AppNavigationRuntime />)
+  const row = request(); send(row); send(row)
+  expect(fixture.push).toHaveBeenCalledOnce()
+})
+
+it('drops outstanding receipts when the account changes', () => {
+  const view = render(<AppNavigationRuntime />)
+  send()
+  fixture.principal = 'bob'
+  act(() => { window.dispatchEvent(new Event('account-change')) })
+  fixture.path = '/mistakes'; view.rerender(<AppNavigationRuntime />)
+  expect(fixture.commands).not.toHaveBeenCalled()
+})
