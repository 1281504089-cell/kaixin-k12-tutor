+
+async def collect_run(context, acknowledge=True):
+    stream, events, replies = StreamBus(), [], asyncio.Queue()
+    context.runtime.wait_for_user_reply = replies.get
+
+    async def collect():
+        async for event in stream.subscribe():
+            events.append(event)
+            if event.metadata.get("trace_kind") == "app_navigation" and acknowledge:
+                request = event.metadata["app_navigation"]
+                await replies.put(
+                    {
+                        "text": json.dumps(
+                            {"id": request["id"], "page": request["page"], "opened": True}
+                        )
+                    }
+                )
+
+    task = asyncio.create_task(collect())
+    await asyncio.sleep(0)
+    await app_actions.run_app_actions(context, stream)
+    await stream.close()
+    await task
+    return next(event.metadata for event in events if event.type == StreamEventType.RESULT), events
+
+
+def test_fast_path_executes_navigation_and_requires_the_client_receipt(mu_isolated_root, as_user):
+    with as_user("alice"):
+        context = UnifiedContext(user_message="打开错题本", metadata={"turn_id": "fast"})
+        result, events = asyncio.run(collect_run(context))
+        assert result["response"] == "已打开错题本。"
+        assert result["metadata"]["app_actions"]["model_calls"] == 0
+        assert any(
+            event.type == StreamEventType.TOOL_CALL and event.content == "study_navigate"
+            for event in events
+        )
+
+
+def test_missing_receipt_does_not_report_opened(mu_isolated_root, as_user, monkeypatch):
+    from deeptutor.tools import study_navigation
+
+    monkeypatch.setattr(study_navigation, "UI_ACK_SECONDS", 0.01)
+    with as_user("alice"):
+        context = UnifiedContext(user_message="打开错题本", metadata={"turn_id": "missing"})
+        result, _ = asyncio.run(collect_run(context, acknowledge=False))
+        assert "已打开" not in result["response"]
+        assert "没有收到" in result["response"]
+
+
+def test_tool_permission_filter_is_not_bypassed_by_the_shortcut(mu_isolated_root, as_user):
+    with as_user("alice"):
+        context = UnifiedContext(
+            user_message="打开错题本", allowed_builtin_tools=[], metadata={"turn_id": "denied"}
+        )
+        result, events = asyncio.run(collect_run(context))
+        assert "已打开" not in result["response"]
+        assert not any(event.metadata.get("app_navigation") for event in events)
