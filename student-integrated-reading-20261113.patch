+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "为什么要打开错题本？",
+        "打开错题本是什么意思",
+        "他说打开错题本",
+        "打开https://example.com",
+        "打开错题本后讲解这道题",
+    ],
+)
+def test_navigation_is_not_triggered_by_mentions(text):
+    assert direct_navigation(text) is None
