+
+def test_page_contract_matches_the_browser_bundle():
+    copy = Path(__file__).parents[2] / "web/contracts/generated/app-pages.json"
+    assert json.loads(copy.read_text()) == PAGES
+    for page in PAGES:
+        route_group = "(utility)" if page["id"] in {"notes", "settings"} else "(workspace)"
+        route = Path(__file__).parents[2] / "web/app" / route_group / page["href"].lstrip("/")
+        # Settings routes are generated through [section].
+        if page["id"] != "settings":
+            assert (route / "page.tsx").exists(), route
