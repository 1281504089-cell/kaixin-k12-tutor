+++ b/web/lib/app-navigation.ts
@@ -0,0 +1,14 @@
+import pages from '@/contracts/generated/app-pages.json'
+
+export const APP_NAVIGATION_EVENT = 'deeptutor:app-navigation'
+export type AppNavigation = { id: string; page: string; href: string; workspace_id: string; expires_at: number }
+export type AppNavigationEvent = { request: AppNavigation; turnId: string; foreground: boolean }
+
+export function validAppNavigation(value: unknown): value is AppNavigation {
+  if (!value || typeof value !== 'object') return false
+  const row = value as Partial<AppNavigation>
+  return typeof row.id === 'string' && /^[0-9a-f]{32}$/.test(row.id) &&
+    typeof row.workspace_id === 'string' && typeof row.expires_at === 'number' &&
+    row.expires_at * 1000 > Date.now() && row.expires_at * 1000 <= Date.now() + 6000 &&
+    pages.some(page => page.id === row.page && page.href === row.href)
+}
