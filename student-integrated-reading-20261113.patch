--- /dev/null
+++ b/web/components/reading/PageNumberInput.tsx
@@ -0,0 +1,35 @@
+"use client";
+
+import { useState } from "react";
+import { useTranslation } from "react-i18next";
+
+export function PageNumberInput({ page, pages, unit, onPage }: {
+  page: number;
+  pages: number;
+  unit: string;
+  onPage: (page: number) => void;
+}) {
+  const { t } = useTranslation();
+  const [draft, setDraft] = useState<string | null>(null);
+  return <form className="inline-flex min-w-0 shrink-0 items-center gap-1 whitespace-nowrap text-xs tabular-nums text-[var(--muted-foreground)]"
+    onSubmit={event => {
+      event.preventDefault();
+      const target = Number(draft ?? page);
+      if (!Number.isInteger(target) || target < 1 || target > pages) {
+        event.currentTarget.reportValidity();
+        return;
+      }
+      setDraft(null);
+      onPage(target);
+    }}>
+    <input type="number" aria-label={t("Page number")} required min={1} max={pages} step={1}
+      value={draft ?? String(page)} onChange={event => setDraft(event.target.value)}
+      onFocus={event => event.currentTarget.select()} onBlur={() => setDraft(null)}
+      onKeyDown={event => {
+        if (event.key === "Enter") { event.preventDefault(); event.currentTarget.form?.requestSubmit(); }
+        if (event.key === "Escape") { setDraft(null); event.currentTarget.blur(); }
+      }}
+      className="h-7 w-12 rounded-md border border-[var(--border)] bg-[var(--background)] px-1 text-center text-[var(--foreground)] focus-visible:outline-2 focus-visible:outline-[var(--ring)]" />
+    <span>{unit} / {pages}</span>
+  </form>;
+}
