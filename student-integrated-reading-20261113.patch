@@ -0,0 +1,41 @@
+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { afterEach, expect, it, vi } from "vitest";
+import { PageNumberInput } from "@/components/reading/PageNumberInput";
+
+afterEach(cleanup);
+
+it("jumps on Enter and reflects pages reported by the reader", async () => {
+  const user = userEvent.setup();
+  const onPage = vi.fn();
+  const { rerender } = render(<PageNumberInput page={1} pages={201} unit="页" onPage={onPage} />);
+  const input = screen.getByRole("spinbutton");
+  await user.clear(input);
+  await user.type(input, "116{Enter}");
+  expect(onPage).toHaveBeenCalledWith(116);
+  rerender(<PageNumberInput page={116} pages={201} unit="页" onPage={onPage} />);
+  expect(input).toHaveValue(116);
+  rerender(<PageNumberInput page={117} pages={201} unit="页" onPage={onPage} />);
+  expect(input).toHaveValue(117);
+});
+
+it.each(["", "0", "202", "1.5"])("rejects invalid page %s without moving", value => {
+  const onPage = vi.fn();
+  render(<PageNumberInput page={6} pages={201} unit="页" onPage={onPage} />);
+  const input = screen.getByRole("spinbutton");
+  fireEvent.change(input, { target: { value } });
+  fireEvent.submit(input.closest("form")!);
+  expect(onPage).not.toHaveBeenCalled();
+  expect(input).toBeInvalid();
+});
+
+it("cancels an unsubmitted page when Escape is pressed", async () => {
+  const user = userEvent.setup();
+  const onPage = vi.fn();
+  render(<PageNumberInput page={6} pages={201} unit="页" onPage={onPage} />);
+  const input = screen.getByRole("spinbutton");
+  await user.clear(input);
+  await user.type(input, "100{Escape}");
+  expect(input).toHaveValue(6);
+  expect(onPage).not.toHaveBeenCalled();
+});
