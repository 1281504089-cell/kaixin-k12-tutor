+"""Internal navigation is successful only after the browser confirms the route."""
+
+import asyncio
+import json
+from pathlib import Path
+import re
+import time
+from uuid import uuid4
+
+from deeptutor.core.tool_protocol import BaseTool, ToolDefinition, ToolParameter, ToolResult
+from deeptutor.multi_user.learning_access import assert_learning_surface
+from deeptutor.services.workspace.context import current_workspace_id
+
+PAGES = json.loads(
+    (Path(__file__).parents[1] / "services/student_learning/app_pages.json").read_text()
+)
+PAGE_BY_ID = {page["id"]: page for page in PAGES}
+UI_ACK_SECONDS = 5
+
+
+def direct_navigation(text):
+    for page in PAGES:
+        for alias in page["aliases"]:
+            if re.fullmatch(
+                r"\s*(?:(?:请|麻烦|请帮我|帮我|给我)\s*)?(?:打开|进入|切换到|带我去|转到)\s*(?:一下)?\s*"
+                + re.escape(alias)
+                + r"\s*(?:页面|界面)?\s*(?:一下|吧)?[。！!\s]*",
+                text,
+                re.I,
+            ) or re.fullmatch(
+                r"\s*(?:please\s+)?(?:open|go to|show)\s+(?:my\s+)?"
+                + re.escape(alias)
+                + r"[.!\s]*",
+                text,
+                re.I,
+            ):
+                return page["id"]
+    return None
+
+
+class StudyNavigateTool(BaseTool):
+    def get_definition(self):
+        return ToolDefinition(
+            name="study_navigate",
+            description="按本轮学生指令真正打开超级学霸页面。不是给链接或让学生自己点。仅打开白名单页面，不操作电脑或外部网址。只有客户端回执确认后才报告已打开；失败如实说明。页面编号："
+            + "；".join(f"{page['id']}={page['title']}" for page in PAGES),
+            parameters=[ToolParameter("page", "string", enum=list(PAGE_BY_ID))],
+        )
+
+    async def execute(self, **kwargs):
+        page = PAGE_BY_ID.get(kwargs.get("page"))
+        if not page:
+            return ToolResult(content="不支持这个页面。", success=False)
+        if page["surface"]:
+            assert_learning_surface(page["surface"])
+        waiter, sink = kwargs.get("_wait_for_ui_reply"), kwargs.get("event_sink")
+        if not callable(waiter) or not callable(sink):
+            return ToolResult(content="当前客户端不能确认页面打开，未执行导航。", success=False)
+        request = {
+            "id": uuid4().hex,
+            "page": page["id"],
+            "href": page["href"],
+            "workspace_id": current_workspace_id(),
+            "expires_at": time.time() + UI_ACK_SECONDS,
+        }
+        await sink("app_navigation", f"正在打开{page['title']}…", {"app_navigation": request})
+        try:
+            reply = await asyncio.wait_for(waiter(), UI_ACK_SECONDS)
+            ack = json.loads((reply or {}).get("text") or "{}")
+        except (TimeoutError, ValueError, TypeError):
+            ack = {}
+        opened = (
+            isinstance(ack, dict)
+            and ack.get("id") == request["id"]
+            and ack.get("page") == page["id"]
+            and ack.get("opened") is True
+        )
+        result = {
+            "opened": opened,
+            "page": page["id"],
+            "title": page["title"],
+            "href": page["href"],
+        }
+        if not opened:
+            result["message"] = "没有收到页面打开的确认，请保持应用在当前窗口后重试。"
+        return ToolResult(
+            content=json.dumps(result, ensure_ascii=False),
+            success=opened,
+            metadata={"app_navigation_result": result},
+        )
