+            base_url="https://unused.invalid",
+            binding="deepseek",
+            provider_name="deepseek",
+            reasoning_effort="high",
+        ),
+    )
+    received = []
+
+    class Model:
+        handler = None
+        closed = False
+
+        async def create(self, **kwargs):
+            received.append(kwargs)
+            return await self.handler(len(received), kwargs)
+
+        async def close(self):
+            self.closed = True
+
+    model = Model()
+    model.chat = SimpleNamespace(completions=model)
+    monkeypatch.setattr(clients, "_build_openai_client", lambda *args, **kwargs: model)
+    return model, received
+
+
+def model_response(name=None, args=None, text="完成", tokens=50, finish_reason="stop"):
+    tools = (
+        [
+            SimpleNamespace(
+                id=f"call-{name}", function=SimpleNamespace(name=name, arguments=json.dumps(args))
+            )
+        ]
+        if name
+        else []
+    )
+    return SimpleNamespace(
+        choices=[
+            SimpleNamespace(
+                message=SimpleNamespace(content=text, tool_calls=tools), finish_reason=finish_reason
+            )
+        ],
+        usage={"prompt_tokens": 100, "completion_tokens": tokens, "total_tokens": 100 + tokens}
+        if tokens is not None
+        else None,
+    )
+
