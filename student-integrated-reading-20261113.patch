diff --git a/web/features/chat/components/AppNavigationRuntime.tsx b/web/features/chat/components/AppNavigationRuntime.tsx
new file mode 100644
index 0000000..bc8349c
--- /dev/null
+++ b/web/features/chat/components/AppNavigationRuntime.tsx
@@ -0,0 +1,76 @@
+'use client'
+
+import { useEffect, useRef, useState } from 'react'
+import { usePathname, useRouter } from 'next/navigation'
+import { APP_NAVIGATION_EVENT, validAppNavigation, type AppNavigationEvent } from '@/lib/app-navigation'
+import { activeWorkspaceId, scopedUrl } from '@/lib/workspace-scope'
+import { RECOVERY_PRINCIPAL_CHANGED, recoveryPrincipal } from '@/lib/recovery-principal'
+import { TurnRuntimeClient } from '@/features/chat/transport/TurnRuntimeClient'
+import { newCommandId } from '@/contracts/parse/turn-command'
+import { wsUrl } from '@/lib/api'
+
+type Pending = AppNavigationEvent & { principal: string | null; timer?: ReturnType<typeof setTimeout>; finished: boolean }
+
+// shortcut: navigation ends an action batch; chained page changes need a global turn subscription.
+// Above both route groups: opening Notes/Settings must not lose the route receipt.
+export default function AppNavigationRuntime() {
+  const router = useRouter()
+  const pathname = usePathname()
+  const pending = useRef<Pending | null>(null)
+  const seen = useRef(new Set<string>())
+  const [request, setRequest] = useState<Pending | null>(null)
+  const finish = useRef<(item: Pending, opened: boolean) => Promise<void>>(async () => {})
+
+  useEffect(() => {
+    const acknowledge = async (item: Pending, opened: boolean) => {
+      if (item.finished) return
+      item.finished = true
+      clearTimeout(item.timer)
+      if (pending.current === item) { pending.current = null; setRequest(null) }
+      if (item.principal !== recoveryPrincipal()) return
+      const client = new TurnRuntimeClient({ url: wsUrl(scopedUrl('/ws', item.request.workspace_id)), onEvent: () => {}, commandAckTimeoutMs: 1500 })
+      client.connect()
+      try {
+        await client.sendAwaitingAck({ protocol_version: '2.0', type: 'submit_user_reply', command_id: newCommandId(),
+          turn_id: item.turnId, text: JSON.stringify({ id: item.request.id, page: item.request.page, opened }) })
+      } catch { /* The server's bounded waiter reports an unconfirmed result. */ }
+      finally { client.stop() }
+    }
+    const receive = (event: Event) => {
+      const detail = (event as CustomEvent<AppNavigationEvent>).detail
+      if (!detail || !validAppNavigation(detail.request) || !detail.turnId || seen.current.has(detail.request.id)) return
+      seen.current.add(detail.request.id)
+      if (seen.current.size > 100) seen.current.delete(seen.current.values().next().value!)
+      const item: Pending = { ...detail, principal: recoveryPrincipal(), finished: false }
+      if (!detail.foreground || detail.request.workspace_id !== activeWorkspaceId() || pending.current) {
+        void acknowledge(item, false)
+        return
+      }
+      pending.current = item
+      item.timer = setTimeout(() => { void acknowledge(item, false) }, 2500)
+      // Attach the receipt callback to this request, never to the newly selected chat.
+      finish.current = acknowledge
+      setRequest(item)
+      router.push(scopedUrl(item.request.href, item.request.workspace_id), { scroll: false })
+    }
+    const accountChanged = () => {
+      const item = pending.current
+      if (item) { item.finished = true; clearTimeout(item.timer) }
+      pending.current = null; setRequest(null); seen.current.clear()
+    }
+    window.addEventListener(APP_NAVIGATION_EVENT, receive)
+    window.addEventListener(RECOVERY_PRINCIPAL_CHANGED, accountChanged)
+    return () => {
+      window.removeEventListener(APP_NAVIGATION_EVENT, receive)
+      window.removeEventListener(RECOVERY_PRINCIPAL_CHANGED, accountChanged)
+      if (pending.current) clearTimeout(pending.current.timer)
+    }
+  }, [router])
+
+  useEffect(() => {
+    if (!request || pathname !== request.request.href || activeWorkspaceId() !== request.request.workspace_id) return
+    const frame = requestAnimationFrame(() => { void finish.current(request, true) })
+    return () => cancelAnimationFrame(frame)
+  }, [pathname, request])
+  return null
+}
