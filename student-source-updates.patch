diff --git a/web/features/settings/sections/ChatHistoryRangeSection.tsx b/web/features/settings/sections/ChatHistoryRangeSection.tsx
new file mode 100644
index 0000000..82c006a
--- /dev/null
+++ b/web/features/settings/sections/ChatHistoryRangeSection.tsx
@@ -0,0 +1,85 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import { useTranslation } from "react-i18next";
+
+import { SettingRow, selectClass } from "@/components/settings/shared";
+import { useSettings } from "@/features/settings/store/SettingsStore";
+import { apiFetch, apiUrl } from "@/lib/api";
+import { applyExtensionPayload } from "@/lib/settings-extensions";
+
+const ranges = {
+  auto: "Automatic (model default)",
+  "32000": "32,000 tokens",
+  "64000": "64,000 tokens",
+} as const;
+type HistoryRange = keyof typeof ranges;
+type HistoryPreference = { chat_history_range?: HistoryRange };
+
+export default function ChatHistoryRangeSection() {
+  const { t } = useTranslation();
+  const { draftRevision, registerExtension, pendingExtensionPayload } = useSettings();
+  const [saved, setSaved] = useState<HistoryRange | null>(null);
+  const [range, setRange] = useState<HistoryRange>("auto");
+  const [loadFailed, setLoadFailed] = useState(false);
+
+  useEffect(() => {
+    const controller = new AbortController();
+    setSaved(null);
+    setLoadFailed(false);
+    void (async () => {
+      try {
+        const response = await apiFetch(apiUrl("/api/settings"), { signal: controller.signal });
+        if (!response.ok) throw new Error("Could not load the history range");
+        const { ui } = (await response.json()) as { ui?: HistoryPreference };
+        if (controller.signal.aborted) return;
+        const value = ui?.chat_history_range ?? "auto";
+        const pending = pendingExtensionPayload("chat-history") as HistoryPreference | undefined;
+        setRange(pending?.chat_history_range ?? value);
+        setSaved(value);
+      } catch {
+        if (!controller.signal.aborted) setLoadFailed(true);
+      }
+    })();
+    return () => controller.abort();
+  }, [draftRevision, pendingExtensionPayload]);
+
+  useEffect(() => {
+    const payload = { chat_history_range: range };
+    registerExtension("chat-history", {
+      dirty: saved !== null && range !== saved,
+      payload: saved !== null ? payload : null,
+      save: async () => {
+        await applyExtensionPayload("chat-history", payload);
+        setSaved(range);
+      },
+    });
+    return () => registerExtension("chat-history", null);
+  }, [range, registerExtension, saved]);
+
+  return (
+    <details className="mb-10 rounded-xl border border-[var(--border)] px-4">
+      <summary className="cursor-pointer py-3 text-[14px] font-medium">
+        {t("Advanced settings")}
+      </summary>
+      <SettingRow
+        title={t("Conversation history range")}
+        description={t("Applies to chat and reading. A shorter range summarizes earlier messages sooner. Your saved messages and current materials stay available.")}
+        control={
+          <select
+            aria-label={t("Conversation history range")}
+            className={selectClass}
+            disabled={saved === null}
+            value={range}
+            onChange={(event) => setRange(event.target.value as HistoryRange)}
+          >
+            <option value="auto">{t(ranges.auto)}</option>
+            <option value="32000">{t(ranges["32000"])}</option>
+            <option value="64000">{t(ranges["64000"])}</option>
+          </select>
+        }
+      />
+      {loadFailed && <p role="alert" className="pb-3 text-sm text-[var(--destructive)]">{t("Failed to load settings")}</p>}
+    </details>
+  );
+}
