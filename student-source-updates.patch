+ const bounds=(input.readWarnings?.length?'部分对话暂未读到，以下仅依据已读取记录。':'')+(input.omittedIncompleteAssistant?'仍在生成或未完成的助手回复未作为结论依据。':'');
+ const scope='范围：'+(input.range?.label||'所选学习记录')+'。已读取'+targets.length+'条本次记录，其中学生发言'+student.length+'条、已完成的AI助手回复'+assistant.length+'条。'+bounds+(available.length>evidence.length?'本页摘录'+evidence.length+'条代表记录，其余未逐条展开；不据摘录判断整体掌握。':'');
+ const tips=input.subject==='math'?'回看原题条件、单位与自己的步骤，检查计算和是否需要分类；未完成的题目可继续向老师提问。':'回看练习句和自己的原答，留意词义、时态与搭配；没有原句或作答证据时，不编造词汇、语法弱项。';
