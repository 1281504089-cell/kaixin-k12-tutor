 _worker_lock = threading.Lock()
+_STT_IDLE_SECONDS = 195  # Keep a prepared worker through a maximum-length recording.
+_stt_process: asyncio.subprocess.Process | None = None
+_stt_language: str | None = None
+_stt_idle: asyncio.TimerHandle | None = None
+
+
+def _detach_stt() -> asyncio.subprocess.Process | None:
+    global _stt_process, _stt_language, _stt_idle
+    if _stt_idle is not None:
+        _stt_idle.cancel()
+        _stt_idle = None
+    process, _stt_process = _stt_process, None
+    _stt_language = None
+    if process is not None and process.returncode is None:
+        try:
+            process.kill()
+        except ProcessLookupError:
+            pass
+    return process
+
+
+async def close_stt_worker() -> None:
+    process = _detach_stt()
+    if process is not None:
+        await process.wait()
+
+
+async def _start_worker(kind: str, language: str) -> asyncio.subprocess.Process:
+    return await asyncio.create_subprocess_exec(
+        sys.executable,
+        "-m",
+        "deeptutor.services.local_ai.worker",
+        kind,
+        "--language",
+        language,
+        stdin=asyncio.subprocess.PIPE,
+        stdout=asyncio.subprocess.PIPE,
+        stderr=asyncio.subprocess.DEVNULL,
+        env={**os.environ, "OMP_NUM_THREADS": "2", "OPENBLAS_NUM_THREADS": "2"},
+    )
+
+
+async def _request_stt(payload: bytes, language: str) -> bytes:
+    global _stt_process, _stt_language, _stt_idle
+    if _stt_idle is not None:
+        _stt_idle.cancel()
+        _stt_idle = None
+    try:
+        if _stt_process is None or _stt_process.returncode is not None or _stt_language != language:
+            await close_stt_worker()
+            _stt_process = await _start_worker("stt-session", language)
+            _stt_language = language
+        process = _stt_process
+        assert process.stdin is not None and process.stdout is not None
+        process.stdin.write(struct.pack(">I", len(payload)) + payload)
+        await process.stdin.drain()
+        result = await process.stdout.readline()
+        if not result:
+            raise RuntimeError("本机识别进程未返回结果。")
+    except BaseException:
+        # A cancelled request must not leave a response for the next recording.
+        await close_stt_worker()
+        raise
+    _stt_idle = asyncio.get_running_loop().call_later(_STT_IDLE_SECONDS, _detach_stt)
+    return result
 
 
