+"""Saving and practicing use the original evidence even when AI analysis fails."""
+
+import asyncio
+import json
+
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+from deeptutor.api.routers import student_learning
+from deeptutor.services.notebook.service import NotebookManager
+from deeptutor.services.student_learning import mistakes
+
+
+def test_partial_excerpt_can_be_practiced_before_and_after_failed_analysis(tmp_path, monkeypatch):
+    manager = NotebookManager(str(tmp_path / "notebooks"))
+    notebook = manager.get_or_create_notebook("错题本", "", "#547A6A", "book-open")["id"]
+    monkeypatch.setattr(mistakes, "storage", lambda: (manager, notebook))
+
+    seen = []
+
+    async def unavailable(manager, notebook, record):
+        assert record["status"] == "pending"
+        source = await mistakes.practice_source(record["id"])
+        seen.append(source["question"])
+
+        async def fail(*_args):
+            raise RuntimeError("simulated provider failure")
+
+        await analyze(manager, notebook, record, complete=fail)
+
+    analyze = mistakes.analyze
+    monkeypatch.setattr(mistakes, "analyze", unavailable)
+    app = FastAPI()
+    app.include_router(student_learning.router)
+
+    with TestClient(app) as client:
+        partial = r"分母是 $x^2-1$，后半题缺失"
+        saved = client.post("/mistakes/capture", json={"excerpt": partial, "title": "教材片段"})
+        assert saved.status_code == 200
+        row = saved.json()
+        assert row["status"] == "pending"
+        assert seen == [partial]
+        records = client.get("/mistakes").json()["records"]
+        assert records[0]["status"] == "failed"
+        practice = client.get("/mistakes", params={"practice": row["id"]}).json()
+        assert practice["question"] == partial
+        assert not practice["images"]
+
+
+def test_image_transcription_must_survive_independent_check(tmp_path, monkeypatch):
+    manager = NotebookManager(str(tmp_path / "notebooks"))
+    notebook = manager.get_or_create_notebook("错题本", "", "#547A6A", "book-open")["id"]
+    monkeypatch.setattr(mistakes, "storage", lambda: (manager, notebook))
+    from deeptutor.services.student_learning import textbooks
+
+    monkeypatch.setattr(textbooks, "search", lambda *_: [])
+    image = {"url": "/files/attachments/source/att/math.png", "mime_type": "image/png",
+             "type": "image", "filename": "math.png"}
+    saved = mistakes.create_record({"excerpt": True, "images": [image], "has_images": True,
+                                    "messages": [{"id": "source", "role": "user", "content": ""}]})
+    _, _, pending = mistakes.begin(saved["id"], saved["revision"])
+    assert asyncio.run(mistakes.practice_source(saved["id"]))["images"] == [image]
+
+    candidate = {"title": "分式", "subject": "math", "question": {"messageId": "original-image",
+                 "text": r"$\frac{1}{x^2-1}$"}, "studentWork": None, "verdict": "not_provided",
+                 "knowledgePoints": ["分式"], "examPoints": [], "explanation": "", "correction": "",
+                 "uncertainties": []}
+    calls = []
+
+    async def complete(system, _prompt):
+        calls.append(system)
+        if len(calls) == 1:
+            assert "original-image" in system
+            return json.dumps(candidate)
+        assert "无法读到或不符则拒绝" in system
+        return '{"approved":false,"issues":["分母无法核对"]}'
+
+    asyncio.run(mistakes.analyze(manager, notebook, pending, complete=complete))
+    assert len(calls) == 2
+    result = mistakes.list_records()[0]
+    assert result["status"] == "failed"
+    assert result["question"] == ""
+    assert result["source"]["images"] == [image]
