diff --git a/web/tests/student-citation-and-models.spec.ts b/web/tests/student-citation-and-models.spec.ts
new file mode 100644
index 0000000..512baa9
--- /dev/null
+++ b/web/tests/student-citation-and-models.spec.ts
@@ -0,0 +1,35 @@
+import { expect, it } from "vitest";
+import { showModelInChat } from "@/lib/llm-options";
+import { citationTargetFromHref, linkifyLocatorCitations, readingPassageHref, verifiedReadingQuotes } from "@/lib/reading-citations";
+import { findQuoteRange } from "@/lib/reading-quote-locator";
+
+it("uses the exact verified passage for a source jump and leaves ambiguous pages as page-only", () => {
+  const id = "a".repeat(64);
+  const goto = (quote: string, revision = 2) => ({
+    type: "tool_result",
+    metadata: { tool: "reader_goto", tool_metadata: {
+      material_id: id, material_revision: revision, reader_action: "goto", locator: 6, quote,
+    } },
+  });
+  const quote = "空间向量既有大小，又有方向。";
+  const quotes = verifiedReadingQuotes([goto(quote), goto("另一个版本中的段落", 1)], id, 2);
+  const text = linkifyLocatorCitations("原文 [p.6]", { materialId: id, materialRevision: 2, quotes });
+  const href = text.match(/\((#dt-material-[^)]+)\)/)?.[1];
+  expect(citationTargetFromHref(href)).toEqual({ materialId: id, materialRevision: 2, locator: 6, quote });
+  expect(verifiedReadingQuotes([goto(quote), goto("同一页另一个段落")], id, 2).size).toBe(0);
+  expect(findQuoteRange([quote, quote], quote, true)).toBeNull();
+  expect(findQuoteRange(["第六页", quote], quote, true)?.start.segment).toBe(1);
+  const region = readingPassageHref(id, 6, 2, undefined, [0.1, 0.2, 0.3, 0.4]);
+  expect(citationTargetFromHref(region)?.rect).toEqual([0.1, 0.2, 0.3, 0.4]);
+  expect(citationTargetFromHref(region.replace("0.1000", "-0.1000"))?.rect).toBeUndefined();
+});
+
+it("defaults to ordinary Kimi Pro and allows explicit visibility overrides", () => {
+  const pro = { provider: "moonshot", model: "kimi-k3.1-pro" };
+  const fast = { provider: "moonshot", model: "kimi-k3.1-pro-highspeed" };
+  expect(showModelInChat(pro)).toBe(true);
+  expect(showModelInChat(fast)).toBe(false);
+  expect(showModelInChat({ ...fast, show_in_chat: true })).toBe(true);
+  expect(showModelInChat({ ...pro, show_in_chat: false })).toBe(false);
+  expect(showModelInChat({ provider: "deepseek", model: "deepseek-flash" })).toBe(true);
+});
