@@ -0,0 +1,53 @@
+import { packager } from '@electron/packager';
+import { cp, mkdir, readFile, writeFile } from 'node:fs/promises';
+import { execFileSync } from 'node:child_process';
+import path from 'node:path';
+import { appRoot } from './lib/target.mjs';
+import { PACKAGER } from './lib/stage.mjs';
+import { verifyManifest } from '../src/bundles.mjs';
+
+const [target, baselineFile, publicKeyFile, zipDir, output] = process.argv.slice(2);
+if (!['macos-x64', 'macos-arm64', 'windows-x64'].includes(target) || !output) {
+  throw new Error('Usage: package-update-launcher.mjs <target> <baseline-manifest> <public-key> <electron-zip-dir> <new-output-dir>');
+}
+const isMac = target.startsWith('macos-');
+const platform = isMac ? 'darwin' : 'win32';
+const arch = target.endsWith('arm64') ? 'arm64' : 'x64';
+const baseline = JSON.parse(await readFile(baselineFile, 'utf8'));
+const key = await readFile(publicKeyFile);
+verifyManifest(baseline, key, arch, platform);
+const out = path.resolve(output);
+const stage = path.join(out, 'shell');
+const seed = path.join(out, 'seed');
+await mkdir(out);
+await mkdir(stage);
+await mkdir(seed);
+await writeFile(path.join(seed, 'runtime.json'), JSON.stringify(baseline));
+for (const file of ['src', 'assets', 'README.md']) await cp(path.join(appRoot, file), path.join(stage, file), { recursive: true });
+await writeFile(path.join(stage, 'assets/runtime-public.pem'), key);
+const pkg = JSON.parse(await readFile(path.join(appRoot, 'package.json'), 'utf8'));
+await writeFile(path.join(stage, 'package.json'), JSON.stringify({ ...pkg, author: '开心动力', version: baseline.coreVersion }));
+await cp(path.join(appRoot, '../../LICENSE'), path.join(stage, 'LICENSE'));
+
+const [built] = await packager({
+  ...PACKAGER, electronZipDir: path.resolve(zipDir), dir: stage, out, platform, arch,
+  electronVersion: pkg.devDependencies.electron, appVersion: baseline.coreVersion, extraResource: [seed],
+  ...(isMac ? {
+    icon: path.join(appRoot, 'assets/icon.icns'), appCategoryType: 'public.app-category.education',
+    extendInfo: {
+      NSMicrophoneUsageDescription: '开心动力超级学霸 uses the microphone when you speak to your tutor.',
+      NSCameraUsageDescription: '开心动力超级学霸 uses the camera when you capture learning material.',
+      NSLocalNetworkUsageDescription: '开心动力超级学霸 runs its learning services on this Mac.',
+    },
+  } : {}),
+});
+const zip = path.join(out, `Kaixin-Updater-${target}.zip`);
+if (isMac) {
+  const app = path.join(built, '开心动力超级学霸.app');
+  execFileSync('codesign', ['--force', '--deep', '--sign', '-', app], { stdio: 'inherit' });
+  execFileSync('codesign', ['--verify', '--deep', '--strict', app], { stdio: 'inherit' });
+  execFileSync('ditto', ['-c', '-k', '--sequesterRsrc', '--keepParent', app, zip]);
+} else {
+  execFileSync('ditto', ['-c', '-k', built, zip]);
+}
+console.log(zip);
