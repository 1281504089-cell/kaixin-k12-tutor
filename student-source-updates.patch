diff --git a/web/components/student/ReportSessionPicker.tsx b/web/components/student/ReportSessionPicker.tsx
new file mode 100644
index 0000000..0aef04c
--- /dev/null
+++ b/web/components/student/ReportSessionPicker.tsx
@@ -0,0 +1,94 @@
+'use client'
+
+import { useCallback, useEffect, useRef, useState } from 'react'
+import {
+  beijingDate, getReportSessions, MAX_EXTRA_REPORT_SESSIONS, reportSessionKey,
+  type ReportSession, type ReportSessionChoice, type ReportSubject,
+} from '@/lib/student-reports'
+import styles from './LearningReports.module.css'
+
+const groups = [{ kind: 'reading', title: '边读边问（学习栏）' }, { kind: 'chat', title: '普通聊天' }] as const
+
+export default function ReportSessionPicker({ subject, initial, onApply }: {
+  subject: ReportSubject
+  initial: ReportSession[]
+  onApply: (sessions: ReportSession[]) => void
+}) {
+  const [selected, setSelected] = useState(initial)
+  const [sessions, setSessions] = useState<ReportSessionChoice[]>([])
+  const [query, setQuery] = useState('')
+  const [nextOffset, setNextOffset] = useState<number | null>(0)
+  const [loading, setLoading] = useState(true)
+  const [error, setError] = useState('')
+  const request = useRef<AbortController | null>(null)
+
+  const load = useCallback(async (offset: number) => {
+    request.current?.abort()
+    const controller = new AbortController()
+    request.current = controller
+    setLoading(true)
+    setError('')
+    try {
+      const page = await getReportSessions(subject, offset, controller.signal)
+      if (controller.signal.aborted) return
+      setSessions(previous => {
+        const combined = new Map((offset ? previous : []).map(row => [reportSessionKey(row), row]))
+        for (const row of page.sessions) combined.set(reportSessionKey(row), row)
+        return [...combined.values()]
+      })
+      setNextOffset(page.next_offset)
+    } catch (caught) {
+      if (!controller.signal.aborted) setError(caught instanceof Error ? caught.message : '暂时未能读取对话。')
+    } finally {
+      if (!controller.signal.aborted) setLoading(false)
+    }
+  }, [subject])
+
+  useEffect(() => {
+    void load(0)
+    return () => request.current?.abort()
+  }, [load])
+
+  const keys = new Set(selected.map(reportSessionKey))
+  const matching = sessions.filter(row => row.title.toLocaleLowerCase().includes(query.trim().toLocaleLowerCase()))
+
+  function toggle(row: ReportSessionChoice) {
+    const { workspace_id, session_id } = row
+    const key = reportSessionKey(row)
+    setSelected(previous => {
+      if (previous.some(item => reportSessionKey(item) === key)) {
+        return previous.filter(item => reportSessionKey(item) !== key)
+      }
+      return previous.length < MAX_EXTRA_REPORT_SESSIONS ? [...previous, { workspace_id, session_id }] : previous
+    })
+  }
+
+  return <div className={styles.sessionPicker}>
+    <input type="search" aria-label="筛选已加载对话" placeholder="按标题筛选已加载对话" value={query} onChange={event => setQuery(event.target.value)} data-autofocus />
+    <div className={styles.sessionChoices}>
+      {groups.map(group => {
+        const rows = matching.filter(row => row.kind === group.kind)
+        return <section key={group.kind}>
+          <h3>{group.title}</h3>
+          {rows.length ? rows.map(row => {
+            const key = reportSessionKey(row)
+            const checked = keys.has(key)
+            return <label className={styles.sessionChoice} key={key}>
+              <input type="checkbox" checked={checked} disabled={!checked && selected.length >= MAX_EXTRA_REPORT_SESSIONS} onChange={() => toggle(row)} />
+              <span><strong>{row.title}</strong><small>{row.workspace_name} · 最近活动 {beijingDate(new Date(row.updated_at * 1000))}</small></span>
+            </label>
+          }) : <p className={styles.scopeNote}>{loading ? '正在读取…' : '已加载的对话中暂无匹配项。'}</p>}
+        </section>
+      })}
+      {error && <p role="alert" className={styles.scopeNote}>{error}</p>}
+      {nextOffset !== null && <button type="button" className={styles.quiet} disabled={loading} onClick={() => void load(nextOffset)}>
+        {loading ? '正在读取…' : error ? '重试读取' : '加载更早的对话'}
+      </button>}
+    </div>
+    <div className={styles.sessionPickerActions}>
+      <span aria-live="polite">已选 {selected.length} / {MAX_EXTRA_REPORT_SESSIONS} 段</span>
+      {selected.length > 0 && <button type="button" className={styles.quiet} onClick={() => setSelected([])}>清空</button>}
+      <button type="button" className={styles.primary} onClick={() => onApply(selected)}>应用选择</button>
+    </div>
+  </div>
+}
