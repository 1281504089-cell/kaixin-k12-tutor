+@pytest.mark.parametrize("first_error", [None, "No results found.", "request timed out"])
+def test_free_search_uses_explicit_engines_and_preserves_sources(monkeypatch, first_error):
+    import ddgs
+    from ddgs.exceptions import DDGSException
+
+    from deeptutor.services.search.providers.duckduckgo import DuckDuckGoProvider
+
+    calls = []
+    clock = [100.0]
+
+    class FakeDDGS:
+        def __init__(self, **kwargs):
+            self.options = kwargs
+
+        def text(self, query, **kwargs):
+            calls.append({**self.options, **kwargs, "query": query})
+            if first_error and kwargs["backend"] == "yahoo":
+                clock[0] += 4
+                raise DDGSException(first_error)
+            return [
+                {"title": "试卷原题", "href": "https://example.org/paper", "body": "完整来源待核对"}
+            ]
+
+    monkeypatch.setattr(ddgs, "DDGS", FakeDDGS)
+    monkeypatch.setattr(
+        "deeptutor.services.search.providers.duckduckgo.monotonic", lambda: clock[0]
+    )
+    response = DuckDuckGoProvider(proxy=PROXY).search("东莞中考数学2025", timeout=6, max_results=5)
+    assert [call["backend"] for call in calls] == (
+        ["yahoo", "duckduckgo"] if first_error else ["yahoo"]
+    )
+    assert calls[-1]["timeout"] == (2 if first_error else 4)
+    assert all(
+        call["region"] == "cn-zh"
+        and call["safesearch"] == "on"
+        and call["proxy"] == PROXY
+        and call["max_results"] == 5
+        for call in calls
+    )
+    assert response.citations[0].url == "https://example.org/paper"
+    assert response.citations[0].source == ("DuckDuckGo" if first_error else "Yahoo")
+    assert "error_code" not in response.metadata
+
