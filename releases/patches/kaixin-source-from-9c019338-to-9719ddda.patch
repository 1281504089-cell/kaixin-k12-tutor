diff --git a/deeptutor/services/imagegen/status.py b/deeptutor/services/imagegen/status.py
new file mode 100644
index 0000000000000000000000000000000000000000..12d2ddc28396d6b63762efdc0a83013f6c6ba426
--- /dev/null
+++ b/deeptutor/services/imagegen/status.py
@@ -0,0 +1,79 @@
+"""Last image-generation outcome for Settings; authentication holds are process-local."""
+import hashlib
+import hmac
+import json
+import secrets
+import threading
+import time
+from urllib.parse import urlsplit
+
+from deeptutor.services.file_io import atomic_write_json
+from deeptutor.services.path_service import get_path_service
+
+_lock = threading.RLock()
+_salt = secrets.token_bytes(32)
+_blocked = {}
+
+
+def _scope(config):
+    path = get_path_service().get_settings_file("imagegen_health")
+    host = urlsplit(config.base_url).hostname or ""
+    slot = json.dumps([config.profile_id, config.provider_name, host, config.model])
+    return path, slot
+
+
+def _identity(config):
+    # Also invalidate a 401 when a custom authorization header or endpoint changes.
+    secret = json.dumps([config.base_url, config.api_key, config.extra_headers], sort_keys=True)
+    return hmac.digest(_salt, secret.encode(), hashlib.sha256)
+
+
+def same_connection(first, second):
+    return _scope(first) == _scope(second) and _identity(first) == _identity(second)
+
+
+def auth_blocked(config):
+    with _lock:
+        return _blocked.get(_scope(config)) == _identity(config)
+
+
+def _read(path):
+    try:
+        data = json.loads(path.read_bytes())
+        return data if isinstance(data, dict) else {}
+    except (OSError, ValueError):
+        return {}
+
+
+def record(config, outcome, started):
+    path, slot = _scope(config)
+    now = time.time()
+    with _lock:
+        records = _read(path)
+        row = records.get(slot, {})
+        if not isinstance(row, dict):
+            row = {}
+        if outcome == "success":
+            row["last_success"] = max(now, row.get("last_success", 0))
+        if started >= row.get("started", 0):
+            row.update(started=started, checked_at=now, outcome=outcome)
+            if outcome == "auth":
+                _blocked[path, slot] = _identity(config)
+            elif outcome == "success" and auth_blocked(config):
+                _blocked.pop((path, slot), None)
+        records[slot] = row
+        try:
+            atomic_write_json(path, records)
+        except OSError:
+            pass  # Diagnostics must not discard a generated image.
+
+
+def current_status(config):
+    path, slot = _scope(config)
+    with _lock:
+        row = _read(path).get(slot, {})
+        if not isinstance(row, dict):
+            row = {}
+        return {"model": config.model, "host": urlsplit(config.base_url).hostname,
+                "blocked": auth_blocked(config),
+                **{key: row[key] for key in ("last_success", "checked_at", "outcome") if key in row}}
