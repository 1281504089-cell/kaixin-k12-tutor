+            "description": "在有间断的区间绘制函数", "axes": {"x": "x", "y": "y", "equal_scale": False},
+            "functions": [{"expression": "1/(x-0.12345)", "label": ""}], "points": [], "circles": [], "lines": []}
+    board, _ = compile_svg_data(json.dumps(data), canvas=True)
+    paths = next(cmd[1] for cmd in board["commands"] if cmd[0] == "line" and cmd[3] == 2.5)
