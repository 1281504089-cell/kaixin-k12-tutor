+def practice_diagram_key(stem):
+    text = unicodedata.normalize("NFKC", stem)
+    text = re.sub(r"\[\[配图\s*[:：]\s*\d+\s*\]\]", "", text)
+    return re.sub(r"[ \t\r\n]+", " ", _NUMBERING.sub("", text)).strip(" *")
+
+
+def practice_diagram(context, stem: str):
+    return context.extension("study_quiz").get("reviewed_diagrams", {}).get(practice_diagram_key(stem))
+
+
+def remember_practice_diagram(context, stem, figure):
+    context.extension("study_quiz").setdefault("reviewed_diagrams", {})[practice_diagram_key(stem)] = figure
+
+
+def reviewed_practice_sections(context, answer):
+    """Keep independently usable, numbered question blocks with their own verified figures."""
+    diagrams = context.extension("study_quiz").get("reviewed_diagrams", {})
+    if not diagrams:
+        return None
+    headings = list(re.finditer(
+        r"(?m)^[ \t]*(?:#{1,6}[ \t]+)?(?:\*\*)?(?:第\s*[一二三四五六七八九十\d]+\s*题|\d+[.、．)）])",
+        answer,
+    ))
+    if not headings:
+        return ([(1, answer.strip(), figure)], []) if (figure := practice_diagram(context, answer)) else None
+    ready, missing = [], []
+    for i, heading in enumerate(headings):
+        section = answer[heading.start():headings[i + 1].start() if i + 1 < len(headings) else len(answer)].strip()
+        section = re.sub(r"(?m)^[ \t]*\[\[配图\s*[:：]\s*\d+\s*\]\][ \t]*$", "", section).strip()
+        # Match the statement at its complete line boundaries. Supplementary prose and options can follow.
+        lines = section.splitlines()
+        statement = "\n".join(lines[1:]).strip() if _NUMBERING.fullmatch(lines[0].strip("*# ")) else section
+        prefixes = (practice_diagram_key("\n".join(statement.splitlines()[:n]))
+                    for n in range(1, len(statement.splitlines()) + 1))
+        figure = next((diagrams[key] for key in prefixes if key in diagrams), None)
+        if figure is None or (exercise_origin_required(context) and not exercise_origin(context, section)):
+            missing.append(i + 1)
+            continue
+        ready.append((i + 1, section, figure))
+    return ready, missing
+
