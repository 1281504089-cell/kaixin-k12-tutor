+from dataclasses import replace
+from io import BytesIO
+
+import httpx
+import pytest
+from PIL import Image
+
+from deeptutor.services import imagegen
+from deeptutor.services.imagegen import status
+from deeptutor.services.imagegen.adapters.dashscope import DashScopeImagegenAdapter
+from deeptutor.services.imagegen.config import ImagegenConfig
+from deeptutor.services.generation_http import GenerationHTTPError, GenerationProviderError
+
+
+@pytest.mark.asyncio
+async def test_auth_hold_changed_key_manual_test_and_safe_receipt(tmp_path, monkeypatch):
+    from deeptutor.services.config import provider_runtime
+    config = ImagegenConfig(model="qwen-image-2.1-pro", provider_name="dashscope", adapter="dashscope",
+                            api_key="isolated-key-one", profile_id="class", base_url="https://example.invalid/api/v1")
+    monkeypatch.setattr(status, "get_path_service", lambda: type("P", (), {"get_settings_file":lambda self, name:tmp_path/name})())
+    monkeypatch.setattr(provider_runtime, "resolve_imagegen_runtime_config", lambda **kwargs: config)
+    out = BytesIO()
+    Image.new("RGB",(10,10),"blue").save(out,format="PNG")
+    outcomes = ["auth","auth","ok","bad","ok"]
+    used = []
+    async def generate(self,prompt,cfg,*,n):
+        used.append(cfg.api_key)
+        outcome = outcomes.pop(0)
+        if outcome == "auth":
+            raise GenerationHTTPError("private provider error",401,"DashScope image task submission")
+        return [(b"corrupt" if outcome=="bad" else out.getvalue(),"image/png")]
+    monkeypatch.setattr(DashScopeImagegenAdapter,"generate",generate)
+    for _ in range(2):
+        with pytest.raises(GenerationProviderError): await imagegen.generate_image("scene", config=config)
+    assert used == [config.api_key] and status.current_status(config)["blocked"]
+    draft = replace(config, api_key="other-account")
+    with pytest.raises(GenerationProviderError): await imagegen.generate_image("test",config=draft,retest=True)
+    assert len(used)==2 and status.current_status(config)["blocked"] and not status.auth_blocked(draft)
+    await imagegen.generate_image("manual",config=config,retest=True)
+    success=status.current_status(config)
+    assert success["outcome"]=="success" and success["last_success"] and not success["blocked"]
+    with pytest.raises(GenerationProviderError): await imagegen.generate_image("damaged",config=config)
+    assert status.current_status(config)["outcome"]=="invalid"
+    assert status.current_status(config)["last_success"]==success["last_success"]
+    await imagegen.generate_image("next",config=config)
+    raw=(tmp_path/'imagegen_health').read_text()
+    assert all(value not in raw for value in (*used,'private provider error','other-account'))
+
+
+@pytest.mark.asyncio
+async def test_poll_resumes_same_accepted_task_without_second_submit():
+    calls=[]
+    def reply(req):
+        calls.append((req.method,req.url.path))
+        if len(calls)==1: raise httpx.ReadTimeout("transient",request=req)
+        return httpx.Response(200,json={"output":{"task_status":"SUCCEEDED","results":[{"url":"asset"}]}})
+    cfg=ImagegenConfig(model="qwen-image-2.1-pro",base_url="https://test.invalid/api/v1",poll_interval=0)
+    async with httpx.AsyncClient(transport=httpx.MockTransport(reply)) as client:
+        results=await DashScopeImagegenAdapter()._poll(client,cfg,{},"same-task")
+    assert calls==[("GET","/api/v1/tasks/same-task")]*2 and results==[{"url":"asset"}]
+
+
+def test_late_review_preserves_more_recent_authentication_error(tmp_path, monkeypatch):
+    from types import SimpleNamespace
+
+    config = ImagegenConfig(model="qwen-image-2.1-pro", provider_name="dashscope",
+                            base_url="https://test.invalid/api/v1", profile_id="lesson")
+    monkeypatch.setattr(status, "get_path_service", lambda: SimpleNamespace(
+        get_settings_file=lambda name: tmp_path / name))
+    status.record(config, "success", 1)
+    status.record(config, "auth", 2)
+    status.record(config, "review", 1)
+    health = status.current_status(config)
+    assert health["outcome"] == "auth" and health["blocked"] and health["last_success"]
