+it("uploads mono 16 kHz WAV for local transcription and keeps the source if decoding fails", async () => {
+  fixture.student = true;
+  const read = Object.getOwnPropertyDescriptor(Blob.prototype, "arrayBuffer");
+  Object.defineProperty(Blob.prototype, "arrayBuffer", {
+    configurable: true,
+    value: async () => new ArrayBuffer(1),
+  });
+  const decode = vi.fn().mockResolvedValue({
+    length: 3, sampleRate: 16000, numberOfChannels: 2,
+    getChannelData: (i: number) => new Float32Array(i ? [0.5, -1, 0] : [0.5, -1, 0.5]),
+  });
+  vi.stubGlobal("OfflineAudioContext", class { decodeAudioData = decode; });
+  try {
+    const blob = await recordingWav(new Blob(["recording"]));
+    const result = await new Promise<ArrayBuffer>((resolve, reject) => {
+      const reader = new FileReader();
+      reader.onerror = reject;
+      reader.onload = () => resolve(reader.result as ArrayBuffer);
+      reader.readAsArrayBuffer(blob);
+    });
+    const wav = new DataView(result);
+    expect(wav.getUint32(0)).toBe(0x52494646);
+    expect(wav.getUint16(22, true)).toBe(1);
+    expect(wav.getUint32(24, true)).toBe(16000);
+    expect(wav.getInt16(44, true)).toBe(16384);
+    expect(wav.getInt16(46, true)).toBe(-32768);
+    const view = renderHook(() => useVoiceRecorder(vi.fn()));
+    for (const name of ["recording.wav", "recording.webm"]) {
+      if (name.endsWith("webm")) decode.mockRejectedValueOnce(new Error("codec"));
+      await act(async () => { await view.result.current.start(); });
+      act(() => view.result.current.stop());
+      await waitFor(() => expect(view.result.current.state).toBe("idle"));
+      const [, request] = fixture.api.mock.calls.at(-1)!;
+      expect((request.body.get("file") as File).name).toBe(name);
+    }
+  } finally {
+    if (read) Object.defineProperty(Blob.prototype, "arrayBuffer", read);
+    else Reflect.deleteProperty(Blob.prototype, "arrayBuffer");
+  }
+});
