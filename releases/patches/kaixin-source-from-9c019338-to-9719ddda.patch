+def interactive_review_samples(spec):
+    """Evaluate the compiled slider formulae at reachable settings for the independent reviewer."""
+    initial = {p["name"]: p["value"] for p in spec["parameters"]}
+    left, right = spec["view"][:2]
+    xs = sorted({max(left, min(right, x)) for x in (-1, 0, 1)})
+    if len(xs) < 3:
+        xs = [left, (left + right) / 2, right]
+
+    def at(expression, values, x):
+        try:
+            return round(number(math_expression(str(expression), values)(x)), 5)
+        except (ArithmeticError, ValueError, TypeError):
+            return None
+
+    samples = []
+    for parameter in spec["parameters"]:
+        low, high, step = (parameter[key] for key in ("min", "max", "step"))
+        count = (high - low) / step
+        if not math.isfinite(count) or count > 1e12:
+            continue
+        last = math.floor(count + 1e-9)
+        for value in dict.fromkeys([low, low + (last // 2) * step, parameter["value"], low + last * step]):
+            values = {**initial, parameter["name"]: value}
+            samples.append({"parameters": values, "functions": {
+                f["name"]: [at(f["expression"], values, x) for x in xs] for f in spec["functions"]
+            }, "points": {p["name"]: [at(expr, values, 0) for expr in p["xy"]] for p in spec["points"]}})
+    return {"x": xs, "settings": samples}
