+def polynomial_render_evidence(spec, svg):
+    """Read a compiled static plot back in pixel space before compact semantic review."""
+    from xml.etree.ElementTree import fromstring
+
+    if spec["slider"]:
+        return None
+    try:
+        c, b, a = polynomial_coefficients(expression(spec["expression"]))
+    except (SyntaxError, ValueError, ArithmeticError):
+        return None
+    root = fromstring(svg)
+    frame = root.find(".//{*}g[@data-frame='0']")
+    box = root.find(".//{*}clipPath/{*}rect")
+    path = frame.find("{*}g/{*}path") if frame is not None else None
+    if box is None or path is None:
+        return None
+    coords = re.findall(r"([ML])(-?[\d.]+) (-?[\d.]+)", path.get("d", ""))
+    if len(coords) != 121 or any(cmd != "L" for cmd, _, _ in coords[1:]):
+        return None
+    xmin, xmax, ymin, ymax = map(number, spec["view"])
+    x0, y0, width, height = [float(box.get(k)) for k in ("x", "y", "width", "height")]
+    def screen(x, y):
+        return (x0 + width*(x-xmin)/(xmax-xmin), y0 + height*(ymax-y)/(ymax-ymin))
+    for index, (_, px, py) in enumerate(coords):
+        x = xmin + index*(xmax-xmin)/120
+        y = max(2*ymin-ymax, min(2*ymax-ymin, (a*x+b)*x+c))
+        if math.dist(screen(x, y), (float(px),float(py))) > 0.011:
+            return None
+    points = frame.findall("{*}circle")
+    if len(points) != len(spec["points"]):
+        return None
+    for (_, x, y), point in zip(spec["points"], points):
+        x, y = [number(math_expression(expression(str(v)))(None)) for v in (x,y)]
+        if not (xmin <= x <= xmax and ymin <= y <= ymax
+                and math.isclose((a*x+b)*x+c, y, rel_tol=1e-8, abs_tol=1e-8)
+                and math.dist(screen(x,y), (float(point.get("cx")),float(point.get("cy")))) <= 0.011):
+            return None
+    return {"local_renderer":"checked_polynomial_pixels", "givens":spec, "coefficients_c_b_a":[c,b,a],
+            "sample_count":len(coords), "visible_text":[node.text for node in root.iterfind(".//{*}text")]}
+
