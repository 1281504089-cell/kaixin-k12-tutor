+"""Bind a continuation drawing to a verbatim statement from the lesson."""
+
+from contextvars import ContextVar
+import re
+
+
+active_figure_focus = ContextVar("active_figure_focus", default="")
+
+
+def latest_lesson_text(context):
+    return next((row["content"] for row in reversed(context.conversation_history)
+                 if row.get("role") == "assistant" and not row.get("_context_snapshot")
+                 and isinstance(row.get("content"), str) and row["content"].strip()), "")
+
+
+def checked_figure_focus(context, quote):
+    if isinstance(quote, str):
+        quote = quote.strip()
+        if 8 <= len(quote) <= 500 and quote in latest_lesson_text(context):
+            return quote
+    return ""
+
+
+def named_proof_triangles(quote):
+    # Read actual mathematical notation in the already selected proof, not words in the student request.
+    return tuple(dict.fromkeys(
+        tuple(match) for match in re.findall(r"在\s*\$?\s*(?:\\triangle|△)\s*([A-Z]{3})\s*\$?\s*[中里内]", quote)
+        if len(set(match)) == 3
+    ))
+
+
+def is_unqualified_figure_followup(request):
+    from deeptutor.services.student_learning.study_preferences import short_drawing_request
+
+    return short_drawing_request(request) or bool(re.fullmatch(
+        r"[给发](?:我)?(?:[个张幅]|一[个张幅])?图[吧嘛呀啊呢吗。！？?!\s]*", request.strip(),
+    ))
+
+
+def unqualified_proof_focus(context, request):
+    if is_unqualified_figure_followup(request):
+        proofs = [row for row in latest_lesson_text(context).splitlines()
+                  if 8 <= len(row) <= 500 and named_proof_triangles(row)]
+        if len(proofs) == 1:
+            return proofs[0]
+    return ""
+
+
+def named_chord_proof(quote):
+    triangles = named_proof_triangles(quote)
+    if len(triangles) != 1 or not re.search(r"任取|任意", quote):
+        return None
+    match = re.search(r"弦\s*\$?([A-Z])([A-Z])\b", quote)
+    if match:
+        endpoints = match.groups()
+        centers = set(triangles[0]) - set(endpoints)
+        if len(centers) == 1 and set(endpoints) <= set(triangles[0]):
+            return next(iter(centers)), *endpoints
+    return None
