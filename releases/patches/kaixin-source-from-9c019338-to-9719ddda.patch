diff --git a/web/lib/recording-wav.ts b/web/lib/recording-wav.ts
new file mode 100644
index 0000000000000000000000000000000000000000..287ca299c0245b493b4658e506ede7167b3f94e6
--- /dev/null
+++ b/web/lib/recording-wav.ts
@@ -0,0 +1,30 @@
+const VOICE_RATE = 16_000;
+
+/** Decode the browser's own recording and hand the local recognizer its native format. */
+export async function recordingWav(blob: Blob): Promise<Blob> {
+  const decoder = new OfflineAudioContext(1, 1, VOICE_RATE);
+  const decoded = await decoder.decodeAudioData(await blob.arrayBuffer());
+  if (!decoded.length || decoded.sampleRate !== VOICE_RATE) throw new Error("Invalid recording");
+  const channels = Array.from({ length: decoded.numberOfChannels }, (_, i) => decoded.getChannelData(i));
+  if (!channels.length) throw new Error("Empty recording");
+  const wav = new DataView(new ArrayBuffer(44 + decoded.length * 2));
+  wav.setUint32(0, 0x52494646); // RIFF
+  wav.setUint32(4, wav.byteLength - 8, true);
+  wav.setUint32(8, 0x57415645); // WAVE
+  wav.setUint32(12, 0x666d7420); // fmt chunk
+  wav.setUint32(16, 16, true);
+  wav.setUint16(20, 1, true);
+  wav.setUint16(22, 1, true);
+  wav.setUint32(24, VOICE_RATE, true);
+  wav.setUint32(28, VOICE_RATE * 2, true);
+  wav.setUint16(32, 2, true);
+  wav.setUint16(34, 16, true);
+  wav.setUint32(36, 0x64617461); // data
+  wav.setUint32(40, wav.byteLength - 44, true);
+  for (let i = 0; i < decoded.length; i++) {
+    let sample = 0;
+    for (const channel of channels) sample += channel[i];
+    wav.setInt16(44 + 2 * i, Math.max(-32768, Math.min(32767, (sample / channels.length) * 32768)), true);
+  }
+  return new Blob([wav.buffer], { type: "audio/wav" });
+}
