+        prev = domain[-1]
+        before = c + dt * prev[0] + ds * prev[1]
+        for point in domain:
+            after = c + dt * point[0] + ds * point[1]
+            if (before < 0) != (after < 0):
+                ratio = before / (before - after)
+                clipped.append(tuple(x + ratio * (y - x) for x, y in zip(prev, point)))
