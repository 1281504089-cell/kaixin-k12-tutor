+    drawing = parallel_refraction({"media": [["甲", indices[0]], ["乙", indices[1]]],
+                                   "angles": [20, 24], "virtual": True, "illustrative": True,
+                                   "qualitative": True, "normal": normal}, canvas=True)
+    evidence = drawing.optical_paths
