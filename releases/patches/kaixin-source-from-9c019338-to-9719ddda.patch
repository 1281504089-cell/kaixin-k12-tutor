index 0000000000000000000000000000000000000000..c0a8b486f3296fc253da66186d10af99ac7cb8bd
--- /dev/null
+++ b/deeptutor/visualizers/board_drawing.py
@@ -0,0 +1,54 @@
+"""Record local Canvas operations from trusted plotting routines."""
+
+from .school_diagrams import Drawing, INK
+
+
+class BoardDrawing:
+    def __init__(self, title, description="", *, width=760, height=425, title_at=(26, 37)):
+        self.title, self.description = title, description
+        self.width, self.height = width, height
+        self.commands = []
+        self.text(title_at, title, color=INK, size=23, align="start")
+
+    def payload(self):
+        return {"size": [self.width, self.height], "commands": self.commands}
+
+    def text(self, point, text, *, color=INK, size=18, align="middle"):
+        self.commands.append(["text", list(point), text, color, size, "center" if align == "middle" else align])
+
+    def line(self, *points, **style):
+        self.paths([points], **style)
+
+    def paths(self, paths, *, color=INK, width=2.5, dashed=False, arrow=False):
+        # A repeated final vertex has no direction; follow the last actual segment.
+        clean = []
+        for path in paths:
+            clean.append([list(p) for i, p in enumerate(path) if i == 0 or p != path[i-1]])
+        self.commands.append(["line", clean, color, width, dashed, arrow])
+
+    def rect(self, x, y, width, height, *, fill="none", color=INK, stroke=2.3, radius=0):
+        self.commands.append(["rect", x, y, width, height, fill, color, stroke, radius])
+
+    def ellipse(self, x, y, rx, ry, *, fill="none", color=INK, stroke=2.2):
+        self.commands.append(["ellipse", x, y, rx, ry, fill, color, stroke])
+
+    def polygon(self, points, *, fill, color, stroke=2.2):
+        self.commands.append(["polygon", [list(p) for p in points], fill, color, stroke])
+
+    def arc(self, x, y, radius, start, sweep, *, color, width=2, dashed=False):
+        self.commands.append(["arc", x, y, radius, start, sweep, color, width, dashed])
+
+    def dot(self, point, radius=3.5, *, color=INK):
+        self.ellipse(*point, radius, radius, fill=color, color="none")
+
+    def circle(self, point, radius, *, fill="#fff", color=INK):
+        self.ellipse(*point, radius, radius, fill=fill, color=color, stroke=2.4)
+
+    angle_arc = Drawing.angle_arc
+    right_angle = Drawing.right_angle
+
+    def clip(self, x, y, width, height):
+        self.commands.append(["clip", x, y, width, height])
+
+    def restore(self):
+        self.commands.append(["restore"])
