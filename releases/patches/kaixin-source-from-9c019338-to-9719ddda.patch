+++ b/web/lib/remark-empty-images.ts
@@ -0,0 +1,22 @@
+type MarkdownNode = {
+  type: string;
+  children?: MarkdownNode[];
+  url?: string;
+  alt?: string | null;
+  value?: string;
+};
+
+export function remarkEmptyImages() {
+  function visit(node: MarkdownNode) {
+    const children = node.children;
+    if (!children) return;
+    for (const [index, child] of children.entries()) {
+      if (child.type === "image" && child.url === "") {
+        children[index] = { type: "text", value: child.alt ?? "" };
+      } else {
+        visit(child);
+      }
+    }
+  }
+  return visit;
+}
