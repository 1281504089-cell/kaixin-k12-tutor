diff --git a/web/components/common/MarkdownImage.tsx b/web/components/common/MarkdownImage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..963f8db6e4c43c51d461fa48dc838fb4bbcfa8a8
--- /dev/null
+++ b/web/components/common/MarkdownImage.tsx
@@ -0,0 +1,29 @@
+"use client";
+
+import { useState, type ComponentPropsWithoutRef } from "react";
+import { useTranslation } from "react-i18next";
+
+type ImageProps = Omit<ComponentPropsWithoutRef<"img">, "src"> & {
+  src?: string;
+  "data-source-line"?: number;
+};
+
+export function MarkdownImage({ src, alt = "", ...props }: ImageProps) {
+  const { t } = useTranslation();
+  const [failedSource, setFailedSource] = useState<string | null>(null);
+  // The drawing tool displays its own result in the answer.
+  if (src === "math_diagram") return alt || null;
+  if (!src || failedSource === src) {
+    return (
+      <span data-source-line={props["data-source-line"]}>
+        {alt && <>{alt}{" "}</>}
+        <span role="status" className="text-sm text-[var(--muted-foreground)]">{t("Failed to load image.")}</span>
+      </span>
+    );
+  }
+  return (
+    // Markdown may reference authenticated or external assets at runtime.
+    // eslint-disable-next-line @next/next/no-img-element
+    <img {...props} src={src} alt={alt} loading="lazy" onError={() => setFailedSource(src)} />
+  );
+}
