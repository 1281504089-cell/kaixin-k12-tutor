+    stages = [("较长且必须完整保留的步骤" + str(i)) for i in range(n)]
+    edges = [[start, end] for start, end in zip(stages, stages[1:])]
+    monkeypatch.setattr(shutil, "which", lambda _: None)
+    data = {"format": "directed-flow", "nodes": stages[::-1], "edges": edges[::-1]}
+    svg, evidence = await compile_structured_diagram(data, title="流程", description="观察先后")
+    boxes = {name: (x,y,w,h) for name,x,y,w,h in evidence["nodes"]}
+    root = ElementTree.fromstring(svg)
+    labels = {el.text: float(el.get("font-size")) for el in root.findall(".//{*}text")}
+    assert all(labels[label] >= 16 for label in stages)
+    assert len(root.findall(".//{*}path[@marker-end]")) == n-1
+    for start, end, points in evidence["connections"]:
+        assert [start, end] in edges and len(points) == 2
+        for name, (u,v) in zip((start,end), points):
+            x,y,w,h = boxes[name]
+            assert 0 <= u <= 760 and 0 <= v <= 425
+            assert (abs(u-x) == w/2 and v == y) or (abs(v-y) == h/2 and u == x)
