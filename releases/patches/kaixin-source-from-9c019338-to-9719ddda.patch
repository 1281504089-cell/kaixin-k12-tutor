+async def test_compact_flow_keeps_title_boxes_and_arrows_inside_canvas():
+    nodes=["进水口","沉淀池池面","出水堰与出水口"]
+    for title in ("水的三站","长标题"*18):
+        body,_=await compile_structured_diagram({"format":"directed-flow","nodes":nodes,"edges":[nodes[:2],nodes[1:]]},title=title,description="依次流经三个位置")
+        root=fromstring(body)
+        _,_,width,height=map(int,root.get("viewBox").split())
+        assert height<220 and width<=760
+        boxes=root.findall("{*}rect")[1:];paths=root.findall("{*}path")
+        assert len(boxes)==3 and len(paths)==2
+        for el in boxes:
+            assert float(el.get("y"))>=62 and float(el.get("y"))+float(el.get("height"))<height
+        assert [n.text for n in root.findall("{*}text")[1:]]==nodes
+        assert all(p.get("marker-end") for p in paths)
