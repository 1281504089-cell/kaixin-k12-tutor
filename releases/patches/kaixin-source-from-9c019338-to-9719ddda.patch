+def test_canvas_repairs_label_layout_without_touching_geometry():
+    scene = {"format": "scene", "coordinates": "world", "items": [
+        ["line", [[-6, -4], [6, 4]], "ink", "solid"],
+        ["ellipse", -1, 0, .18, .18, "blue", "blue"],
+        ["ellipse", 0, 0, .18, .18, "orange", "orange"],
+        ["text", -1, -.35, "探头模块", "blue", "middle"],
+        ["text", 0, -.35, "指示灯模块", "orange", "middle"],
+    ]}
+    args = {"title": "导轨", "description": "核对探头和指示灯。", "canvas": True}
+    with pytest.raises(ValueError, match="重叠"):
+        compile_scene(scene, **args, fit_labels=False)
+    board, evidence = compile_scene(scene, **args)
+    rail, probe, lamp, first, second = board["commands"][1:]
+    assert rail[1][0][0][1] > rail[1][0][1][1]
+    assert probe[1] < lamp[1] and probe[2] == lamp[2] and probe[3:5] == lamp[3:5]
+    assert 20 <= abs(first[1][1] - second[1][1]) <= 50
+    assert evidence["labels"][1][1:3] == second[1]
+    for tag in (first, second):
+        _, (_, baseline), *_ = tag
