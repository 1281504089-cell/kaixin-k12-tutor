diff --git a/web/components/visualize/BoardCanvas.tsx b/web/components/visualize/BoardCanvas.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..422039d80f941bdb419eb5309f43ae9d7e7d680b
--- /dev/null
+++ b/web/components/visualize/BoardCanvas.tsx
@@ -0,0 +1,139 @@
+"use client";
+
+import { useEffect, useRef, useState } from "react";
+
+type Point = [number, number];
+type Command =
+  | ["text", Point, string, string, number, CanvasTextAlign]
+  | ["line", Point[][], string, number, boolean, boolean]
+  | ["rect", number, number, number, number, string, string, number, number]
+  | ["ellipse", number, number, number, number, string, string, number]
+  | ["polygon", Point[], string, string, number]
+  | ["arc", number, number, number, number, number, string, number, boolean]
+  | ["clip", number, number, number, number]
+  | ["restore"];
+type Board = { size: [number, number]; commands: Command[] };
+
+export default function BoardCanvas({ data, label }: { data: unknown; label: string }) {
+  const ref = useRef<HTMLCanvasElement>(null);
+  const [failed, setFailed] = useState(false);
+
+  useEffect(() => {
+    const canvas = ref.current;
+    const board = data as Board | null;
+    const ctx = canvas?.getContext("2d");
+    if (!canvas || !ctx || !Array.isArray(board?.size) || board.size.length !== 2 ||
+        board.size.some(v => !Number.isInteger(v) || v < 100 || v > 1200) ||
+        !Array.isArray(board.commands) || board.commands.length > 200) {
+      setFailed(true);
+      return;
+    }
+    const [width, height] = board.size;
+    const density = Math.max(2, Math.min(3, window.devicePixelRatio || 1));
+    try {
+      canvas.width = width * density;
+      canvas.height = height * density;
+      ctx.scale(density, density);
+      ctx.fillStyle = "#fff";
+      ctx.fillRect(0, 0, width, height);
+      ctx.lineJoin = "round";
+      ctx.lineCap = "round";
+
+      for (const command of board.commands) {
+        ctx.beginPath();
+        switch (command[0]) {
+          case "text": {
+            const [, [x, y], content, color, size, align] = command;
+            ctx.font = `${size}px system-ui, sans-serif`;
+            ctx.fillStyle = color;
+            ctx.textAlign = align;
+            ctx.fillText(content, x, y);
+            break;
+          }
+          case "line": {
+            const [, paths, color, stroke, dashed, arrow] = command;
+            ctx.setLineDash(dashed ? [6, 5] : []);
+            ctx.lineWidth = stroke;
+            ctx.strokeStyle = color;
+            for (const path of paths) {
+              if (!path.length) continue;
+              ctx.moveTo(...path[0]);
+              for (const point of path.slice(1)) ctx.lineTo(...point);
+            }
+            if (color !== "none") ctx.stroke();
+            ctx.setLineDash([]);
+            const path = paths[paths.length - 1];
+            if (arrow && path?.length >= 2) {
+              const [x, y] = path[path.length - 1];
+              const [px, py] = path[path.length - 2];
+              const direction = Math.atan2(y - py, x - px);
+              const length = Math.min(9, Math.hypot(x - px, y - py));
+              ctx.beginPath();
+              ctx.moveTo(x, y);
+              for (const angle of [direction - 0.46, direction + 0.46])
+                ctx.lineTo(x - length * Math.cos(angle), y - length * Math.sin(angle));
+              ctx.closePath();
+              ctx.fillStyle = color;
+              ctx.fill();
+            }
+            break;
+          }
+          case "rect":
+          case "ellipse": {
+            const [kind, x, y, a, b, fill, color, stroke, radius = 0] = command;
+            if (kind === "rect") ctx.roundRect(x, y, a, b, radius);
+            else ctx.ellipse(x, y, a, b, 0, 0, Math.PI * 2);
+            if (fill !== "none") {
+              ctx.fillStyle = fill;
+              ctx.fill();
+            }
+            if (color !== "none") {
+              ctx.lineWidth = stroke;
+              ctx.strokeStyle = color;
+              ctx.stroke();
+            }
+            break;
+          }
+          case "arc": {
+            const [, x, y, radius, start, sweep, color, stroke, dashed] = command;
+            ctx.setLineDash(dashed ? [6, 5] : []);
+            ctx.arc(x, y, radius, start, start + sweep, sweep < 0);
+            ctx.strokeStyle = color;
+            ctx.lineWidth = stroke;
+            ctx.stroke();
+            ctx.setLineDash([]);
+            break;
+          }
+          case "polygon": {
+            const [, points, fill, color, stroke] = command;
+            points.forEach((point, i) => i === 0 ? ctx.moveTo(...point) : ctx.lineTo(...point));
+            ctx.closePath();
+            if (fill !== "none") { ctx.fillStyle = fill; ctx.fill(); }
+            if (color !== "none") { ctx.strokeStyle = color; ctx.lineWidth = stroke; ctx.stroke(); }
+            break;
+          }
+          case "clip":
+            ctx.save();
+            ctx.rect(...command.slice(1) as [number, number, number, number]);
+            ctx.clip();
+            break;
+          case "restore":
+            ctx.restore();
+            break;
+          default:
+            throw new Error("Unknown board command");
+        }
+      }
+      canvas.dataset.boardReady = "true";
+      setFailed(false);
+    } catch {
+      delete canvas.dataset.boardReady;
+      setFailed(true);
+    }
+  }, [data]);
+
+  return <>
+    <canvas ref={ref} role="img" aria-label={label} hidden={failed} className="mx-auto h-auto max-w-full rounded-lg" />
+    {failed && <p role="status" className="p-4 text-sm">本机画板未能显示这张图。</p>}
+  </>;
+}
