+async def test_fallback_reuses_only_the_bound_original_with_the_selected_model(monkeypatch, already_in_answer):
+    url = "/files/attachments/session/attachment/optics.png"
+    context = UnifiedContext(
+        user_message="照着刚才那张说明一下。",
+        raw_user_message="这张照着讲就行。",
+        conversation_history=[{"role": "user", "content": "这是第15页的光路。"}],
+        attachments=[Attachment(type="image", url=url, base64="aW1hZ2U=", filename="optics.png")],
+    )
+    config = SimpleNamespace(binding="openai", model="gpt-4.1", reasoning_effort="high", provider_name="openai")
+    request = AsyncMock(return_value=SimpleNamespace(finish_reason="stop", usage=None, content='{"kind":"original","index":1}'))
+    monkeypatch.setattr(illustration_fallback, "get_runtime_provider",
+                        lambda selected: SimpleNamespace(chat_stream_with_retry=request) if selected is config else None)
+
+    tool, result = await illustration_fallback.deliver_illustration_fallback(
+        context, config, None, f"![已显示]({url})" if already_in_answer else "折射光向法线靠近。",
+        title="光路", prompt="draw refraction", anchor="", diagram=None, bind_diagram=None,
+    )
+    assert tool == "read_source"
+    assert result.metadata["lesson_original"] == {
+        "title": "光路", "label": "optics.png", "existing_url" if already_in_answer else "url": url,
+    }
+    wire = request.await_args.kwargs
+    assert wire["model"] == config.model and wire["reasoning_effort"] == "high"
+    evidence = json.loads(wire["messages"][1]["content"])
+    assert evidence["request"] == context.raw_user_message
+    assert evidence["history"][0]["content"] == "这是第15页的光路。"
+    assert wire["allow_image_fallback"] is False
