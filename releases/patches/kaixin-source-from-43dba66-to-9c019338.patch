+import json
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+
+from deeptutor.core.context import Attachment, TurnRuntimeContext, UnifiedContext, WorkspaceRuntimeContext
+from deeptutor.core.tool_protocol import ToolResult
+from deeptutor.visualizers import board_fallback, illustration_review
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("condition", ["allowed", "declined", "readback_unavailable", "attachment", "disabled", "not_configured"])
+async def test_board_illustration_requires_current_model_approval_and_authorized_inputs(monkeypatch, condition):
+    context = UnifiedContext(
+        user_message="光是怎么转向的？给个印象就行。",
+        runtime=TurnRuntimeContext(workspace=WorkspaceRuntimeContext(workspace_id="fixture")),
+    )
+    if condition == "attachment":
+        context.attachments = [Attachment(type="image", filename="private.png")]
+    binding, model = ("deepseek", "deepseek-v4-pro") if condition == "readback_unavailable" else ("openai", "gpt-4.1")
+    selected = SimpleNamespace(model=model, binding=binding, provider_name=binding, reasoning_effort="high")
+    qwen = SimpleNamespace(model="qwen-image-2.1-turbo")
+    choice = {"kind": "none"} if condition == "declined" else {
+        "kind": "schematic", "title": "光的传播", "prompt": "近似画出传播路径", "anchor": "注意传播方向。",
+    }
+    decide = AsyncMock(return_value=SimpleNamespace(finish_reason="stop", usage=None, content=json.dumps(choice)))
+    monkeypatch.setattr(board_fallback, "_qwen_config", lambda: None if condition == "not_configured" else qwen)
+    monkeypatch.setattr(board_fallback, "get_runtime_provider",
+                        lambda config: SimpleNamespace(chat_stream_with_retry=decide) if config is selected else None)
+    generate = AsyncMock(return_value=ToolResult(
+        content="", metadata={"lesson_illustration": {"url": "/fixture", "approximate": True}},
+    ))
+    alternative = await board_fallback.deliver_board_schematic(
+        context, selected, None, SimpleNamespace(generate_board_schematic=generate),
+        lambda: condition != "disabled", "注意传播方向。", ToolResult(content="布局不可用", success=False),
+        question="只画光的传播路线", anchor="", other_illustrations=[],
+    )
+    if condition in {"allowed", "declined"}:
+        assert decide.await_args.kwargs["model"] == selected.model
+        assert decide.await_args.kwargs["reasoning_effort"] == "high"
+        assert decide.await_args.kwargs["retry_delays"] == []
+    else:
+        decide.assert_not_awaited()
+    if condition != "allowed":
+        generate.assert_not_awaited()
+        assert alternative is None
+    else:
+        generate.assert_awaited_once()
+        kwargs = generate.await_args.kwargs
+        assert kwargs["prompt"] == choice["prompt"] and kwargs["config"] is qwen
+        assert kwargs["workspace"] is context.runtime.workspace
+        assert callable(kwargs["verify"])
+        tool, result = alternative
+        assert tool == "imagegen" and result.content == ""
+        assert result.metadata["figure_anchor"] == choice["anchor"]
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(("review", "show"), [
+    pytest.param({"approved": True, "issues": [], "checks": ["外形近似且 A 指向 B"]}, True, id="approximate-shape"),
+    pytest.param({"approved": True, "issues": ["表格把 A 行的 25 写成 52"], "checks": ["行标题正确"]},
+                 False, id="contradictory-table-review"),
+    pytest.param({"approved": False, "issues": ["角标放到了相邻外角"], "checks": ["已核对顶点和角弧"]},
+                 False, id="wrong-angle"),
+    pytest.param({"approved": False, "issues": ["公式应为 ρ=m/V"], "checks": ["已读图上公式"]},
+                 False, id="wrong-formula"),
+    pytest.param({"approved": True}, False, id="bare-approval"),
+    pytest.param({"approved": True, "issues": [], "checks": [" "]}, False, id="empty-evidence"),
+])
+async def test_checkable_schematic_must_pass_review_of_its_actual_pixels(monkeypatch, review, show):
+    context = UnifiedContext(
+        user_message="用近似的布局看设备之间的连接。",
+        runtime=TurnRuntimeContext(workspace=WorkspaceRuntimeContext(workspace_id="fixture")),
+    )
+    selected = SimpleNamespace(model="gpt-4.1", binding="openai", provider_name="openai", reasoning_effort="high")
+    choice = {"kind": "schematic", "title": "连接", "prompt": "按题意画 A 指向 B"}
+    responses = [
+        SimpleNamespace(finish_reason="stop", usage=None, content=json.dumps(choice)),
+        SimpleNamespace(finish_reason="stop", usage=None, content=json.dumps(review)),
+    ]
+    decide = AsyncMock(side_effect=responses)
+    monkeypatch.setattr(board_fallback, "_qwen_config", lambda: SimpleNamespace(model="qwen-image-2.1-turbo"))
+    monkeypatch.setattr(board_fallback, "get_runtime_provider", lambda _: SimpleNamespace(chat_stream_with_retry=decide))
+    monkeypatch.setattr(illustration_review, "get_runtime_provider", lambda _: SimpleNamespace(chat_stream_with_retry=decide))
+
+    async def generate(*, verify, **_):
+        if not await verify(b"mock verified PNG bytes", "image/png"):
+            return ToolResult(content="", success=False)
+        return ToolResult(content="", metadata={"lesson_illustration": {"url": "/fixture", "approximate": True}})
+
+    alternative = await board_fallback.deliver_board_schematic(
+        context, selected, None, SimpleNamespace(generate_board_schematic=generate), lambda: True,
+        "A 指向 B。", ToolResult(content="布局不可用", success=False),
+        question="连接从 A 指向 B", anchor="", other_illustrations=[],
+    )
+    assert (alternative is not None) is show
+    assert decide.await_count == 2
+    visual = decide.await_args.kwargs
+    assert visual["messages"][-1]["content"][-1]["image_url"]["url"].startswith("data:image/png;base64,")
+    assert visual["model"] == selected.model and visual["reasoning_effort"] == "high"
+    standard = visual["messages"][0]["content"]
+    assert "长度和比例可近似" in standard
+    assert "表格行列与数值、刻度、单位、公式" in standard
+    assert "正确的顶点、两条边及角弧" in standard
+    assert "关键关系无法确认" in standard
