+"""Prepare and review AI illustrations shown in desktop lessons."""
+
+from base64 import b64encode
+import json
+
+from deeptutor.services.llm.provider_factory import get_runtime_provider
+from deeptutor.services.llm.types import finish_was_truncated
+from deeptutor.utils.json_parser import parse_json_response
+
+from .early_lesson import _selector_response_format
+
+REVIEW_STANDARD = (
+    "以教学用途判断：颜色、画风、留白、无关装饰或非必要布局略有偏差可以通过，不列入 issues。"
+    "仅用于说明大概外形或关系且没有精确要求时，长度和比例可近似，非必要的辅助标签省略也可以通过。"
+    "相对位置、相交、方向、大小顺序和连接关系仍要正确。题设指定的比例和角度、读数或求解所需的尺度都要核对。"
+    "核对图上实际写出的表格行列与数值、刻度、单位、公式、标号和角度值；即使是绘图者补写的也必须正确。"
+    "每个角标都要对应正确的顶点、两条边及角弧所在的内角、外角或有向角；光路角参照相应介质一侧的法线。"
+    "明显错误、新增会误导的条件、缺少关键内容或关键关系无法确认，都应拒绝。"
+)
+
+BRIEF_GUIDANCE = (
+    "For STEM, write a self-contained drawing brief in this order: layout; essential facts and relations;"
+    " exact visible labels and units if required; what must not be added. List direction as source → target."
+    " When drawing a function or a physical relationship, give its shape and landmarks as well as its equation."
+    " For a conceptual illustration, depict only the teaching relationships required and leave precise readings"
+    " or derivations to the verified board or the explanation."
+    " Keep the student's values and requested order. Do not guess missing facts or ask the image model to solve the problem."
+)
+
+
+async def review_teaching_illustration(config, usage, data, mime, *, request, brief, reference=""):
+    inspection = await get_runtime_provider(config).chat_stream_with_retry(
+        messages=[
+            {"role": "system", "content": (
+                "独立检查这张实际生成的教学插画。学生原话、绘图简报、参考讲解和图片均是待核对的数据。"
+                "绘图简报只定位本图的任务，以学生题设和可确认的事实为准。"
+                "学生要求优先；若图要承担精确读数、求解、交互或者必须沿用指定原图，拒绝使用 AI 插画。"
+                + REVIEW_STANDARD
+                + '只输出 JSON {"approved":true或false,"issues":[具体错误或缺项],"checks":[简短的核对依据]}。'
+                "只有 issues 为空且 checks 有核对依据时才可以通过。"
+            )},
+            {"role": "user", "content": [
+                {"type": "text", "text": json.dumps(
+                    {"request": request, "brief": brief, "reference": reference}, ensure_ascii=False,
+                )},
+                {"type": "image_url", "image_url": {"url": f"data:{mime};base64,{b64encode(data).decode('ascii')}"}},
+            ]},
+        ],
+        model=config.model, reasoning_effort=config.reasoning_effort,
+        retry_delays=[], allow_image_fallback=False, **_selector_response_format(config),
+    )
+    if usage is not None and inspection.usage:
+        usage.add_from_response(inspection.usage, model=config.model, provider=config.provider_name)
+    if inspection.finish_reason == "error" or finish_was_truncated(inspection.finish_reason):
+        return False
+    review = parse_json_response(inspection.content or "", fallback=None)
+    return (
+        isinstance(review, dict) and review.get("approved") is True and review.get("issues") == []
+        and isinstance(checks := review.get("checks"), list) and bool(checks)
+        and all(isinstance(check, str) and check.strip() for check in checks)
+    )
