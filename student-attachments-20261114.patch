+import { apiFetch, apiUrl } from '@/lib/api'
+import { scopedUrl } from '@/lib/workspace-scope'
+import { invalidateKnowledgeCaches } from '@/features/knowledge/api/client'
+
+export const MAX_UPLOAD_SOURCE_BYTES = 1024 * 1024 * 1024
+export interface UploadedAttachment {
+  id: string
+  type: string
+  filename: string
+  url: string
+  size: number
+  mime_type: string
+  page_count?: number
+}
+export interface UploadResult {
+  upload_id: string
+  records: UploadedAttachment[]
+  library_status: string
+  filename: string
+  created_at: number
+}
+
+async function checked(response: Response) {
+  const result = await response.json().catch(() => null)
+  if (!response.ok)
+    throw new Error(
+      typeof result?.detail === 'string' ? result.detail : `上传失败 (${response.status})，请重试。`
+    )
+  return result
+}
+
+/** Send bounded raw chunks once; never encode a whole PDF into a chat message. */
+export async function uploadDocumentFile(
+  file: File,
+  retention: 'temporary' | 'library',
+  workspaceId: string,
+  progress?: (percent: number) => void,
+  signal?: AbortSignal
+): Promise<UploadResult> {
+  const url = (suffix = '') =>
+    apiUrl(scopedUrl(`/api/student/attachments/uploads${suffix}`, workspaceId))
+  const meta = await checked(
+    await apiFetch(url(), {
+      method: 'POST',
+      signal,
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ filename: file.name, size: file.size, retention }),
+    })
+  )
+  try {
+    if (
+      !/^[0-9a-f]{32}$/.test(meta.upload_id) ||
+      !Number.isInteger(meta.chunk_bytes) ||
+      meta.chunk_bytes < 1 ||
+      meta.chunk_bytes > 8 * 1024 * 1024
+    )
+      throw new Error('上传分段设置不正确。')
+    for (let offset = 0, index = 0; offset < file.size; index++) {
+      const chunk = file.slice(offset, Math.min(file.size, offset + meta.chunk_bytes))
+      const hash = Array.from(
+        new Uint8Array(await crypto.subtle.digest('SHA-256', await chunk.arrayBuffer()))
+      )
+        .map(value => value.toString(16).padStart(2, '0'))
+        .join('')
+      let response: Response | null = null
+      for (let attempt = 0; attempt < 2; attempt++) {
+        try {
+          response = await apiFetch(url(`/${meta.upload_id}/chunks/${index}`), {
+            method: 'PUT',
+            signal,
+            body: chunk,
+            headers: { 'X-Upload-SHA256': hash },
+          })
+        } catch (error) {
+          if (attempt || signal?.aborted) throw error
+          continue
+        }
+        if (response.status < 500 || attempt) break
+      }
+      await checked(response!)
+      offset += chunk.size
+      progress?.(Math.round((offset / file.size) * 95))
+    }
+    const result = (await checked(
+      await apiFetch(url(`/${meta.upload_id}/complete`), { method: 'POST', signal })
+    )) as UploadResult
+    if (!Array.isArray(result.records) || !result.records.length)
+      throw new Error('上传完成，但未返回可读取的原件。')
+    progress?.(100)
+    if (retention === 'library') {
+      invalidateKnowledgeCaches()
+      window.dispatchEvent(new Event('student:materials-updated'))
+    }
+    return result
+  } catch (error) {
+    void apiFetch(url(`/${meta.upload_id}`), { method: 'DELETE' }).catch(() => {})
+    throw error
+  }
+}
