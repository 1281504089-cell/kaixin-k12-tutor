@@ -0,0 +1,60 @@
+import { Blob } from 'node:buffer'
+import { webcrypto } from 'node:crypto'
+import { beforeEach, expect, it, vi } from 'vitest'
+import { apiFetch } from '@/lib/api'
+import { uploadDocumentFile } from '@/lib/student-upload'
+
+vi.mock('@/lib/api', () => ({ apiUrl: (url: string) => url, apiFetch: vi.fn() }))
+vi.mock('@/features/knowledge/api/client', () => ({ invalidateKnowledgeCaches: vi.fn() }))
+const id = 'a'.repeat(32)
+beforeEach(() => {
+  vi.stubGlobal('crypto', webcrypto)
+})
+const file = () =>
+  Object.assign(new Blob(['123456789']), { name: 'formula.pdf' }) as unknown as File
+
+it('sends hashed bounded blobs, retries one transient chunk failure and never sends base64', async () => {
+  const chunks: Blob[] = []
+  let failed = false
+  vi.mocked(apiFetch).mockImplementation(async (url, init) => {
+    if (String(url).includes('/chunks/')) {
+      expect(init?.headers).toHaveProperty(
+        'X-Upload-SHA256',
+        expect.stringMatching(/^[0-9a-f]{64}$/)
+      )
+      if (!failed) {
+        failed = true
+        return new Response('{}', { status: 503 })
+      }
+      chunks.push(init!.body as Blob)
+      return new Response('{}')
+    }
+    if (String(url).includes('/complete'))
+      return new Response(
+        JSON.stringify({
+          upload_id: id,
+          records: [{ id, url: '/files/attachments/_pending/file', filename: 'formula.pdf' }],
+        })
+      )
+    return new Response(JSON.stringify({ upload_id: id, chunk_bytes: 4 }))
+  })
+  const progress = vi.fn()
+  const result = await uploadDocumentFile(file(), 'temporary', 'math', progress)
+  expect(result.records).toHaveLength(1)
+  expect(chunks.map(chunk => chunk.size)).toEqual([4, 4, 1])
+  expect(await new Blob(chunks).text()).toBe('123456789')
+  expect(progress).toHaveBeenLastCalledWith(100)
+})
+
+it('rejects failed transfers and discards unfinished chunks', async () => {
+  vi.mocked(apiFetch).mockImplementation(async (url, init) => {
+    if (init?.method === 'DELETE') return new Response('{}')
+    if (String(url).includes('/chunks/'))
+      return new Response(JSON.stringify({ detail: '校验失败' }), { status: 400 })
+    return new Response(JSON.stringify({ upload_id: id, chunk_bytes: 4 }))
+  })
+  await expect(uploadDocumentFile(file(), 'library', '')).rejects.toThrow('校验失败')
+  expect(apiFetch).toHaveBeenLastCalledWith(expect.stringContaining(`/${id}?`), {
+    method: 'DELETE',
+  })
+})
