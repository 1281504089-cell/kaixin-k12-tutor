@@ -0,0 +1,358 @@
+'use client'
+
+import { useEffect, useState } from 'react'
+import { FileText, Library, Loader2, MessageCircle, RefreshCw, Search } from 'lucide-react'
+import { Dialog } from '@/shared/ui/Dialog'
+import TextbookLibrary from './TextbookLibrary'
+import KbFilePreview from '@/components/knowledge/KbFilePreview'
+import { apiFetch, apiUrl } from '@/lib/api'
+import { activeWorkspaceId, scopedUrl, selectWorkspace } from '@/lib/workspace-scope'
+import {
+  listKnowledgeBases,
+  listKnowledgeBaseFiles,
+  knowledgeBaseFilePath,
+} from '@/features/knowledge/api/client'
+import { formatFileSize, knowledgeBaseRef } from '@/lib/knowledge-helpers'
+import { learningLibrary } from '@/lib/learning-library'
+import { createReadingWorkspace, type ReadingLibraryMaterial } from '@/lib/reading-workspace-api'
+import { readingCollectionRoute } from '@/lib/learning-routes'
+import { setPendingMaterial } from '@/lib/pending-material'
+import type { UploadResult, UploadedAttachment } from '@/lib/student-upload'
+import type { FilePreviewSource } from '@/components/chat/preview/previewerFor'
+import styles from './StudentLearning.module.css'
+
+type Row = {
+  key: string
+  name: string
+  detail: string
+  size?: number
+  source?: FilePreviewSource
+  attachment?: UploadedAttachment
+  workspace?: string
+  kb?: string
+  retainedKb?: string
+  material?: ReadingLibraryMaterial
+}
+type SavedUpload = UploadResult & {
+  content_workspace_id?: string
+  content_workspace_name?: string
+  library_error?: string
+}
+
+/** One shelf for original files; readiness of a search index never gates reading. */
+export default function StudentMaterials() {
+  const [rows, setRows] = useState<Row[]>([])
+  const [view, setView] = useState('textbooks')
+  const [query, setQuery] = useState('')
+  const [selected, setSelected] = useState<Row | null>(null)
+  const [busy, setBusy] = useState('')
+  const [loading, setLoading] = useState(true)
+  const [error, setError] = useState('')
+  const [revision, setRevision] = useState(0)
+  useEffect(() => {
+    const refresh = () => setRevision(value => value + 1)
+    window.addEventListener('focus', refresh)
+    window.addEventListener('student:materials-updated', refresh)
+    return () => {
+      window.removeEventListener('focus', refresh)
+      window.removeEventListener('student:materials-updated', refresh)
+    }
+  }, [])
+  useEffect(() => {
+    let alive = true
+    setLoading(true)
+    setError('')
+    const failures: string[] = []
+    const saved = async (): Promise<Row[]> => {
+      const response = await apiFetch(apiUrl('/api/student/attachments/uploads/library'), {
+        cache: 'no-store',
+      })
+      if (!response.ok) throw new Error('长期资料')
+      const result = (await response.json()) as {
+        uploads: SavedUpload[]
+        unavailable_workspaces?: string[]
+      }
+      if (result.unavailable_workspaces?.length) failures.push('部分项目的长期资料')
+      return result.uploads.flatMap(upload =>
+        upload.records.map(row => ({
+          key: `upload:${row.id}`,
+          name: row.filename,
+          size: row.size,
+          detail:
+            upload.library_error ||
+            (upload.library_status === 'saving' ? '原件可用 · 检索准备中' : '长期保存 · 原件可用'),
+          attachment: row,
+          workspace: upload.content_workspace_id || '',
+          retainedKb: upload.content_workspace_id
+            ? `workspace:${upload.content_workspace_id}:kb:我的上传资料`
+            : 'account:kb:我的上传资料',
+          source: { id: row.id, filename: row.filename, mimeType: row.mime_type, url: row.url },
+        }))
+      )
+    }
+    const knowledge = async (): Promise<Row[]> => {
+      const bases = await listKnowledgeBases({ library: true, force: true })
+      const lists = await Promise.allSettled(
+        bases.map(async kb => {
+          const ref = knowledgeBaseRef(kb)
+          const files = await listKnowledgeBaseFiles(ref, { library: true, force: true })
+          return files
+            .filter(file => file.type !== 'folder')
+            .map(file => {
+              const path = knowledgeBaseFilePath(ref, file.name)
+              return {
+                key: `kb:${ref}:${file.name}`,
+                name: file.name,
+                size: file.size,
+                detail: kb.name,
+                kb: ref,
+                source: {
+                  filename: file.name,
+                  mimeType: file.mime_type || undefined,
+                  url: `${path}${path.includes('?') ? '&' : '?'}resource_library=true`,
+                },
+              }
+            })
+        })
+      )
+      return lists.flatMap(result => {
+        if (result.status === 'fulfilled') return result.value
+        failures.push('部分资料原件')
+        return []
+      })
+    }
+    const reading = async (): Promise<Row[]> => {
+      const result = await learningLibrary<ReadingLibraryMaterial>('materials')
+      return result.items
+        .filter(
+          material =>
+            material.source_kind === 'file' &&
+            !material.collections?.some(c => c.workspace_id.startsWith('rw_tb_'))
+        )
+        .map(material => ({
+          key: `material:${material.content_workspace_id}:${material.material_id}`,
+          name: material.title || material.filename,
+          size: material.size_bytes,
+          detail: '已保存资料',
+          material,
+        }))
+    }
+    const values: Row[][] = [[], [], []]
+    const publish = () => {
+      if (!alive) return
+      // The native index's raw copy and the new upload row refer to the same retained file.
+      const pending = values[0]
+      const existing = values[1].filter(
+        row =>
+          !pending.some(
+            item => item.retainedKb === row.kb && item.name === row.name && item.size === row.size
+          )
+      )
+      setRows([...pending, ...existing, ...values[2]])
+    }
+    const jobs = [saved(), knowledge(), reading()].map(async (job, index) => {
+      values[index] = await job
+      publish()
+    })
+    void Promise.allSettled(jobs).then(results => {
+      if (!alive) return
+      results.forEach((result, index) => {
+        if (result.status === 'rejected') failures.push(['长期资料', '已有知识资料', '已有阅读资料'][index])
+      })
+      setError(
+        failures.length
+          ? `${Array.from(new Set(failures)).join('、')}暂时未能读取，可点击刷新重试。`
+          : ''
+      )
+      setLoading(false)
+    })
+    return () => {
+      alive = false
+    }
+  }, [revision])
+
+  async function openMaterial(row: Row) {
+    if (!row.material) {
+      setSelected(row)
+      return
+    }
+    setBusy(row.key)
+    setError('')
+    try {
+      const material = row.material
+      const workspace = material.content_workspace_id || ''
+      const collection =
+        material.collections?.[0]?.workspace_id ||
+        (
+          await createReadingWorkspace(
+            { title: material.title, material_ids: [material.material_id] },
+            workspace
+          )
+        ).workspace_id
+      await selectWorkspace(workspace, readingCollectionRoute(collection, workspace))
+    } catch {
+      setError('这份原件暂时无法打开，请刷新后重试。')
+    } finally {
+      setBusy('')
+    }
+  }
+  async function useInChat(row: Row) {
+    setBusy(row.key)
+    setError('')
+    try {
+      const workspace = row.workspace ?? activeWorkspaceId()
+      let attachment = row.attachment
+      if (!attachment && row.kb) {
+        const response = await apiFetch(
+          apiUrl(scopedUrl('/api/student/materials/attach', workspace)),
+          {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify({ kb_ref: row.kb, filename: row.name }),
+          }
+        )
+        if (!response.ok) throw new Error('原件引用失败，请重试。')
+        attachment = await response.json()
+      }
+      if (!attachment) throw new Error('请先打开原件，再选择需要提问的片段。')
+      await setPendingMaterial(attachment, workspace)
+      await selectWorkspace(workspace, '/chat')
+    } catch (caught) {
+      setError(caught instanceof Error ? caught.message : '引用失败，请重试。')
+    } finally {
+      setBusy('')
+    }
+  }
+  const filtered = rows.filter(
+    row => !query || `${row.name} ${row.detail}`.toLowerCase().includes(query.toLowerCase())
+  )
+  return (
+    <main className={styles.page} aria-label="资料库">
+      <header className={styles.header}>
+        <div>
+          <div className={styles.eyebrow}>
+            <Library size={14} /> 本机资料库
+          </div>
+          <h1>教材与长期资料</h1>
+          <p>打开原件就能阅读和提问。全文解析、检索索引在后台准备；临时附件只留在对话中。</p>
+        </div>
+        <button
+          className={styles.button}
+          onClick={() => setRevision(value => value + 1)}
+          disabled={loading}
+        >
+          <RefreshCw size={14} className={loading ? 'animate-spin' : ''} />
+          刷新资料
+        </button>
+      </header>
+      <div className={styles.tabs}>
+        <button
+          className={styles.tab}
+          aria-pressed={view === 'textbooks'}
+          onClick={() => setView('textbooks')}
+        >
+          已有教材
+        </button>
+        <button
+          className={styles.tab}
+          aria-pressed={view === 'saved'}
+          onClick={() => setView('saved')}
+        >
+          长期资料 <small>{rows.length}</small>
+        </button>
+      </div>
+      {error && (
+        <p role="alert" className={styles.error}>
+          {error}
+        </p>
+      )}
+      {view === 'textbooks' ? (
+        <TextbookLibrary embedded />
+      ) : (
+        <>
+          <div className={styles.search}>
+            <Search size={16} />
+            <input
+              aria-label="搜索长期资料"
+              placeholder="搜索资料名称…"
+              value={query}
+              onChange={event => setQuery(event.target.value)}
+            />
+          </div>
+          {loading && !rows.length ? (
+            <div className={styles.empty} role="status">
+              <Loader2 className="animate-spin" />
+              正在读取原件目录…
+            </div>
+          ) : (
+            <div className={styles.books}>
+              {filtered.map(row => (
+                <article className={styles.book} key={row.key}>
+                  <div className={styles.bookTop}>
+                    <FileText size={24} />
+                    <span className={styles.tag}>
+                      {row.size ? formatFileSize(row.size) : '原件'}
+                    </span>
+                  </div>
+                  <h2>{row.name}</h2>
+                  <p>{row.detail}</p>
+                  <div className={styles.actions}>
+                    <button
+                      className={styles.button}
+                      disabled={!!busy}
+                      onClick={() => void openMaterial(row)}
+                    >
+                      打开原件
+                    </button>
+                    {!row.material && (
+                      <button
+                        className={styles.button}
+                        disabled={!!busy}
+                        onClick={() => void useInChat(row)}
+                      >
+                        <MessageCircle size={13} />
+                        引用到对话
+                      </button>
+                    )}
+                  </div>
+                </article>
+              ))}
+            </div>
+          )}
+          {!loading && !filtered.length && (
+            <p className={styles.notice}>
+              还没有长期资料。在对话框点加号，选择“长期保存到资料库”后上传。
+            </p>
+          )}
+        </>
+      )}
+      <Dialog
+        open={!!selected?.source}
+        title={selected?.name || '原件预览'}
+        description="可直接阅读原件，无需等待全文解析。"
+        closeLabel="关闭原件预览"
+        onClose={() => setSelected(null)}
+        size="xl"
+        className={`${styles.dialog} !max-w-[95vw]`}
+        footer={
+          selected && (
+            <button
+              className={styles.button}
+              disabled={!!busy}
+              onClick={() => void useInChat(selected)}
+            >
+              <MessageCircle size={14} />
+              带到对话中提问
+            </button>
+          )
+        }
+      >
+        {selected?.source && (
+          <div className="h-[65dvh] min-h-0">
+            <KbFilePreview source={selected.source} />
+          </div>
+        )}
+      </Dialog>
+    </main>
+  )
+}
