@@ -0,0 +1,227 @@
+import asyncio
+import hashlib
+from pathlib import Path
+from types import SimpleNamespace
+
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+import pymupdf
+import pytest
+
+from deeptutor.api.routers import student_uploads as api
+from deeptutor.services.student_learning import uploads
+from deeptutor.services.storage import LocalDiskAttachmentStore
+
+REAL_PROCESS = uploads.process
+
+
+@pytest.fixture
+def environment(tmp_path, monkeypatch):
+    local = LocalDiskAttachmentStore(tmp_path / 'attachments')
+    monkeypatch.setattr(uploads, 'get_attachment_store', lambda: local)
+    monkeypatch.setattr(uploads, 'get_chat_attachment_limits', lambda: SimpleNamespace(max_file_bytes=3000, max_total_bytes=3000))
+    calls = []
+
+    async def process(result):
+        calls.append(result)
+
+    monkeypatch.setattr(uploads, 'process', process)
+    app = FastAPI()
+    app.include_router(api.router, prefix='/api/student')
+    return app, local, calls
+
+
+def upload(client, filename, data, retention='temporary'):
+    response = client.post('/api/student/attachments/uploads', json={'filename': filename, 'size': len(data), 'retention': retention})
+    assert response.status_code == 200, response.text
+    meta = response.json()
+    for index, offset in enumerate(range(0, len(data), meta['chunk_bytes'])):
+        chunk = data[offset:offset + meta['chunk_bytes']]
+        response = client.put(f"/api/student/attachments/uploads/{meta['upload_id']}/chunks/{index}", content=chunk, headers={'X-Upload-SHA256': hashlib.sha256(chunk).hexdigest()})
+        assert response.status_code == 200, response.text
+    response = client.post(f"/api/student/attachments/uploads/{meta['upload_id']}/complete")
+    assert response.status_code == 200, response.text
+    return response.json()
+
+
+def test_original_ready_before_background_processing_and_idempotent_complete(environment, monkeypatch):
+    app, local, calls = environment
+    body_sent = False
+    async def process(result):
+        assert body_sent, 'Do not begin parsing/indexing before the raw upload response'
+        calls.append(result)
+    monkeypatch.setattr(uploads, 'process', process)
+
+    async def traced(scope, receive, send):
+        async def capture(message):
+            nonlocal body_sent
+            if scope.get('path', '').endswith('/complete') and message['type'] == 'http.response.body' and not message.get('more_body'):
+                body_sent = True
+            await send(message)
+        await app(scope, receive, capture)
+
+    with TestClient(traced) as client:
+        result = upload(client, '../公式.txt', '向量 a·b = |a||b|cosθ'.encode())
+        assert body_sent and len(calls) == 1
+        row = result['records'][0]
