+import { browserStorage } from '@/shared/storage'
+import type { UploadedAttachment } from './student-upload'
+import type { PendingAttachment } from '@/features/chat/controllers/pending-attachments'
+import { fetchAuthStatus } from './auth'
+
+const prefix = 'student:material-for-chat:'
+async function key(workspace: string) {
+  const status = await fetchAuthStatus()
+  if (!status || (status.enabled && (!status.authenticated || !status.user_id))) throw new Error('账号暂时不可用，请重试。')
+  return `${prefix}${status.user_id || 'local-admin'}:${workspace}`
+}
+
+export async function setPendingMaterial(row: UploadedAttachment, workspace: string) {
+  if (!browserStorage.writeRaw(
+    'session',
+    await key(workspace),
+    JSON.stringify({ ...row, selected_at: Date.now() })
+  )) throw new Error('无法暂存附件引用，请检查浏览器储存空间。')
+}
+
+export async function consumePendingMaterial(workspace: string, isCurrent = () => true): Promise<PendingAttachment | null> {
+  if (!browserStorage.listRaw('session', prefix).length) return null
+  try {
+    const name = await key(workspace)
+    // Navigation may replace the composer while the account check is pending.
+    if (!isCurrent()) return null
+    const value = browserStorage.readRaw('session', name)
+    browserStorage.removeRaw('session', name)
+    const row = JSON.parse(value || 'null')
+    if (
+      !row ||
+      Date.now() - row.selected_at > 300_000 ||
+      !/^[0-9a-f]{32}$/.test(row.id) ||
+      !String(row.url).startsWith('/files/attachments/')
+    )
+      return null
+    return {
+      id: row.id,
+      attachmentId: row.id,
+      type: row.type,
+      filename: row.filename,
+      url: row.url,
+      mimeType: row.mime_type,
+      size: row.size,
+      pageCount: row.page_count,
+    }
+  } catch {
+    return null
+  }
+}
