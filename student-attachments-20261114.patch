+import { render, screen } from '@testing-library/react'
+import { expect, it, vi } from 'vitest'
+import ChatSpaceMenu from '@/components/chat/space/ChatSpaceMenu'
+import { studentRouteVisible, studentResourceVisible } from '@/lib/student-edition'
+import { VISIBLE_LEARNING_SURFACES, learningSurface } from '@/components/learning/surfaces'
+
+vi.mock('react-i18next', () => ({ useTranslation: () => ({ t: (value: string) => value }) }))
+const counts = {
+  attachments: 0,
+  knowledge: 0,
+  chatHistory: 0,
+  myAgents: 0,
+  books: 0,
+  reading: 0,
+  notebooks: 0,
+  questionBank: 0,
+  persona: 0,
+  memory: 0,
+}
+for (const variant of ['toolbar', 'mention', 'resources'] as const)
+  it(`hides unused resource entrances in the ${variant} menu`, () => {
+    render(
+      <ChatSpaceMenu
+        variant={variant}
+        selectedCounts={counts}
+        readingAvailable
+        onSelectItem={vi.fn()}
+      />
+    )
+    for (const label of ['Books', 'Reading', 'Notebooks', 'Question Bank'])
+      expect(screen.queryByText(label)).toBeNull()
+    expect(screen.getAllByRole(variant === 'mention' ? 'option' : 'button').length).toBeGreaterThan(
+      0
+    )
+  })
+it('keeps stored reading history and native note actions while hiding all five feature launchers', () => {
+  for (const path of [
+    '/notebooks',
+    '/space/journal',
+    '/space/questions',
+    '/learning/books',
+    '/learning/reading',
+    '/learning/practice',
+  ])
+    expect(studentRouteVisible(path)).toBe(false)
+  for (const kind of ['books', 'reading', 'notebooks', 'question_bank', 'journal'])
+    expect(studentResourceVisible(kind)).toBe(false)
+  expect(studentRouteVisible('/space')).toBe(true)
+  expect(studentRouteVisible('/co-writer')).toBe(true)
+  expect(studentRouteVisible('/learning/reading/existing-study')).toBe(true)
+  expect(learningSurface('reading')).toBeDefined()
+  expect(
+    VISIBLE_LEARNING_SURFACES.some(surface =>
+      ['books', 'reading', 'practice'].includes(surface.kind)
+    )
+  ).toBe(false)
+})
