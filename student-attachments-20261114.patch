+async def test_library_uploads_wait_for_each_other_without_blocking_original_access(environment):
+    _, local, _ = environment
+    order = []
+    release = asyncio.Event()
+    async def first():
+        async with uploads.library_queue():
+            order.append('first')
+            await release.wait()
+    async def second():
+        async with uploads.library_queue():
+            order.append('second')
