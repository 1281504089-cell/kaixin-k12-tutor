+import { beforeEach, expect, it, vi } from 'vitest';
+import { fetchAuthStatus } from '@/lib/auth';
+import { consumePendingMaterial, setPendingMaterial } from '@/lib/pending-material';
+import type { AuthStatus } from '@/lib/auth';
+
+vi.mock('@/lib/auth', () => ({ fetchAuthStatus: vi.fn() }));
+const identity = (user_id: string) => ({ user_id, enabled: true, authenticated: true }) as AuthStatus;
+const row = { id: 'a'.repeat(32), type: 'file', filename: '公式.pdf', url: '/files/attachments/_pending/a/公式.pdf', size: 10, mime_type: 'application/pdf' };
+beforeEach(() => { sessionStorage.clear(); vi.mocked(fetchAuthStatus).mockResolvedValue(identity('student-a')); });
+it('hands an original to chat once, scoped by account and workspace', async () => {
+  await setPendingMaterial(row, 'math');
+  expect(await consumePendingMaterial('english')).toBeNull();
+  vi.mocked(fetchAuthStatus).mockResolvedValue(identity('student-b'));
+  expect(await consumePendingMaterial('math')).toBeNull();
+  vi.mocked(fetchAuthStatus).mockResolvedValue(identity('student-a'));
+  expect(await consumePendingMaterial('math')).toMatchObject({ attachmentId: row.id, url: row.url });
+  expect(await consumePendingMaterial('math')).toBeNull();
+});
+
+it('keeps the original handoff if navigation replaces the composer during the account check', async () => {
+  await setPendingMaterial(row, 'math');
+  let finish!: (value: AuthStatus) => void;
+  vi.mocked(fetchAuthStatus).mockReturnValueOnce(new Promise(resolve => { finish = resolve; }));
+  let current = true;
+  const cancelled = consumePendingMaterial('math', () => current);
+  current = false;
+  finish(identity('student-a'));
+  expect(await cancelled).toBeNull();
+  expect(await consumePendingMaterial('math')).toMatchObject({ attachmentId: row.id });
+  expect(await consumePendingMaterial('math')).toBeNull();
+});
