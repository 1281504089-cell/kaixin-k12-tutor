@@ -0,0 +1,382 @@
+"""Bounded local uploads. Original bytes are usable before parsing/indexing."""
+from __future__ import annotations
+
+import asyncio
+from contextlib import asynccontextmanager
+import json
+import math
+import mimetypes
+import os
+from pathlib import Path
+import re
