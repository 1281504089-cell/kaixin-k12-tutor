@@ -0,0 +1,14 @@
+// Original-file preview state is local to this window; it never becomes a learning-memory record.
+const pages = new Map<string, number>()
+export const attachmentPageVisited = (url?: string) => Boolean(url && pages.has(url))
+export function splitPdfPage(filename: string, originalPage: number): number | null {
+  const range = filename.match(/-第(\d+)-(\d+)页\.pdf$/i)
+  if (!range) return originalPage
+  return originalPage >= Number(range[1]) && originalPage <= Number(range[2]) ? originalPage - Number(range[1]) + 1 : null
+}
+export function rememberAttachmentPage(url: string, page: number) {
+  if (!url || !Number.isInteger(page) || page < 1) return
+  pages.set(url, page)
+  if (pages.size > 100) pages.delete(pages.keys().next().value!)
+}
+export const attachmentPage = (url?: string) => (url ? pages.get(url) || 1 : 1)
