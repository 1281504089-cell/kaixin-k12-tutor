@@ -0,0 +1,127 @@
+"""Small transport chunks and immediate original-file references for student chat."""
+import asyncio
+import hashlib
+import os
+import re
+from typing import Literal
+import uuid
+
+from fastapi import APIRouter, BackgroundTasks, HTTPException, Request
+from pydantic import BaseModel, Field
+
+from deeptutor.services.student_learning import uploads
+
+router = APIRouter()
+
+
+class UploadStart(BaseModel):
+    filename: str = Field(min_length=1, max_length=240)
+    size: int = Field(gt=0, le=uploads.MAX_SOURCE_BYTES)
+    retention: Literal["temporary", "library"] = "temporary"
+
+
+def error(exc):
+    return HTTPException(404 if isinstance(exc, LookupError) else 400, detail=str(exc))
+
+
+@router.post("/attachments/uploads")
+async def begin_upload(body: UploadStart):
+    try:
+        return await asyncio.to_thread(uploads.begin, body.filename, body.size, body.retention)
+    except (ValueError, LookupError) as exc:
+        raise error(exc) from None
+
+
+@router.put("/attachments/uploads/{upload_id}/chunks/{index}")
+async def upload_chunk(upload_id: str, index: int, request: Request):
+    temporary = None
+    try:
+        meta = uploads.read(upload_id)
+        expected = uploads.expected_chunk(meta, index)
+        wanted = request.headers.get("x-upload-sha256", "")
+        if not re.fullmatch(r"[0-9a-f]{64}", wanted):
+            raise ValueError("上传分段缺少有效校验值。")
+        directory = uploads.directory(upload_id)
+        if (directory / "result.json").exists() or (directory / "finishing").exists():
+            raise ValueError("文件已提交，不能继续修改分段。")
+        temporary = directory / f"{index}.{uuid.uuid4().hex}.receiving"
+        size = 0
+        digest = hashlib.sha256()
+        with temporary.open("xb") as output:
+            async for data in request.stream():
+                size += len(data)
+                if size > expected:
+                    raise HTTPException(413, detail="上传分段超过当前大小上限。")
+                digest.update(data)
+                await asyncio.to_thread(output.write, data)
+        if size != expected or digest.hexdigest() != wanted:
+            raise ValueError("上传分段不完整或校验失败，请重试。")
+        target = directory / f"{index}.chunk"
+        try:
+            os.link(temporary, target)
+        except FileExistsError:
+            def existing_hash():
+                with target.open("rb") as handle:
+                    return hashlib.file_digest(handle, "sha256").hexdigest()
+            if await asyncio.to_thread(existing_hash) != wanted:
+                raise ValueError("重复分段的内容不同，请重新上传。")
+        return {"received": size, "index": index}
+    except (ValueError, LookupError) as exc:
+        raise error(exc) from None
+    finally:
+        if temporary:
+            temporary.unlink(missing_ok=True)
+
+
+@router.post("/attachments/uploads/{upload_id}/complete")
+async def complete_upload(upload_id: str, background: BackgroundTasks):
+    try:
+        was_complete = (uploads.directory(upload_id) / "result.json").is_file()
+        result = await uploads.finish(upload_id)
+        if not was_complete:
+            background.add_task(uploads.process, result)
+        return result
+    except (ValueError, LookupError) as exc:
+        raise error(exc) from None
+
+
+@router.get("/attachments/uploads/library")
+async def list_long_term_uploads():
+    from deeptutor.services.workspace.navigation import read_workspace_indexes
+
+    async def read():
+        return await asyncio.to_thread(uploads.library_uploads)
+
+    rows, unavailable = await read_workspace_indexes(read)
+    return {"uploads": rows, "unavailable_workspaces": unavailable}
+
+
+@router.delete("/attachments/uploads/{upload_id}")
+async def cancel_upload(upload_id: str):
+    try:
+        await asyncio.to_thread(uploads.cancel, upload_id)
+        return {"cancelled": True}
+    except (ValueError, LookupError) as exc:
+        raise error(exc) from None
+
+
+class ExistingMaterial(BaseModel):
+    kb_ref: str = Field(min_length=1, max_length=500)
+    filename: str = Field(min_length=1, max_length=1000)
+
+
+@router.post("/materials/attach")
+async def attach_library_material(body: ExistingMaterial):
+    from deeptutor.api.routers.knowledge import _resolve_kb_raw_file_or_404
+    from deeptutor.services.workspace.knowledge import library_request
+    token = library_request.set(True)
+    try:
+        source = _resolve_kb_raw_file_or_404(body.kb_ref, body.filename)
+        # The resolver enforces the existing account/library ACL and raw-root boundary.
+        attachment_id = uuid.uuid4().hex
+        url = await uploads.store().import_file(session_id=uploads.PENDING, attachment_id=attachment_id, filename=source.name, source=source)
+        import mimetypes
+        return {"id": attachment_id, "filename": source.name, "url": url, "type": "file",
+                "mime_type": mimetypes.guess_type(source.name)[0] or "application/octet-stream", "size": source.stat().st_size}
+    finally:
+        library_request.reset(token)
