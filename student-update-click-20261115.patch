+"""Local desktop restart is explicit and restricted to the owned frontend origin."""
+import asyncio
+import os
+
+from fastapi import APIRouter, HTTPException, Request
+
+from deeptutor.services.student_learning import desktop_update
+
+router = APIRouter()
+
+
+@router.get("/desktop-update/status")
+async def desktop_launcher_status():
+    return await asyncio.to_thread(desktop_update.launcher_status)
+
+
+@router.post("/desktop-update/restart")
+async def restart_desktop_launcher(request: Request):
+    port = os.environ.get("FRONTEND_PORT", "")
+    if (not port.isdecimal() or request.headers.get("origin") != "http://127.0.0.1:" + port
+            or request.headers.get("x-kaixin-desktop-action") != "restart"):
+        raise HTTPException(403, "Only the desktop update page can request this restart")
+    try:
+        return await asyncio.to_thread(desktop_update.restart_launcher)
+    except (ValueError, RuntimeError, OSError, TimeoutError) as error:
+        raise HTTPException(409, str(error)) from None
