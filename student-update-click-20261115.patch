diff --git a/web/components/settings/DesktopLauncherUpdate.tsx b/web/components/settings/DesktopLauncherUpdate.tsx
new file mode 100644
index 0000000..dad75be
--- /dev/null
+++ b/web/components/settings/DesktopLauncherUpdate.tsx
@@ -0,0 +1,50 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import { apiFetch, apiUrl } from "@/lib/api";
+import type {} from "@/lib/desktop-update";
+import Button from "@/components/ui/Button";
+
+export default function DesktopLauncherUpdate() {
+  const [pending, setPending] = useState(false);
+  const [restarting, setRestarting] = useState(false);
+  const [error, setError] = useState("");
+  useEffect(() => {
+    if (!window.kaixinDesktop) return;
+    let disposed = false;
+    let timer: ReturnType<typeof setTimeout>;
+    let checks = 0;
+    const read = async () => {
+      try {
+        const response = await apiFetch(apiUrl("/api/student/desktop-update/status"), { signal: AbortSignal.timeout(10_000), skipAuthRedirect: true });
+        if (!response.ok) return;
+        const status = await response.json();
+        if (disposed) return;
+        setPending(Boolean(status.restart_required));
+        setRestarting(Boolean(status.restarting));
+        setError(status.error || "");
+        if (status.restarting && checks++ < 70) timer = setTimeout(read, 1000);
+        else if (status.restarting) { setRestarting(false); setError("重开尚未完成，请正常退出软件后重新打开，再检查更新。"); }
+      } catch {
+        if (!disposed && restarting && checks++ < 70) timer = setTimeout(read, 1000);
+        else if (!disposed && restarting) { setRestarting(false); setError("重开尚未完成，请正常退出软件后重新打开。"); }
+      }
+    };
+    void read();
+    return () => { disposed = true; clearTimeout(timer); };
+  }, [restarting]);
+  if (!pending) return null;
+  return <aside aria-label="完成桌面更新" className="fixed bottom-4 right-4 z-[100] w-[min(420px,calc(100vw-2rem))] rounded-xl border border-[var(--border)] bg-[var(--background)] p-4 shadow-lg">
+    <p className="font-medium">重开软件即可完成更新</p>
+    <p className="my-2 text-sm opacity-70">聊天记录和设置会保留。请先结束正在进行的通话或生成。</p>
+    {error && <p role="alert" className="mb-2 break-words text-sm text-red-600">{error}</p>}
+    <Button disabled={restarting} onClick={async () => {
+      setError("");
+      try {
+        const response = await apiFetch(apiUrl("/api/student/desktop-update/restart"), { method: "POST", headers: { "x-kaixin-desktop-action": "restart" }, signal: AbortSignal.timeout(15_000) });
+        if (!response.ok) { const body = await response.json(); throw new Error(body.detail || "无法重开，请重试"); }
+        setRestarting(true);
+      } catch (cause) { setRestarting(false); setError(cause instanceof Error ? cause.message : "无法重开，请重试"); }
+    }}>{restarting ? "正在重开…" : "重新打开完成更新"}</Button>
+  </aside>;
+}
