diff --git a/deeptutor/services/student_learning/desktop_update.py b/deeptutor/services/student_learning/desktop_update.py
new file mode 100644
index 0000000..461d83c
--- /dev/null
+++ b/deeptutor/services/student_learning/desktop_update.py
@@ -0,0 +1,119 @@
+"""Stage the signed script launcher from an installed core, never from web input."""
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+import threading
+
+import psutil
+
+_restart_lock = threading.Lock()
+
+
+def desktop_context():
+    core = Path(__file__).resolve().parents[3]
+    runtime = core.parent
+    executable = os.getenv("DEEPTUTOR_ELECTRON_EXECUTABLE", "")
+    if not executable or runtime.parent.name != "runtimes":
+        return None
+    profile = runtime.parent.parent
+    if Path(os.environ.get("DEEPTUTOR_HOME", "")).resolve() != (profile / "workspace").resolve():
+        return None
+    executable = Path(executable).resolve(strict=True)
+    parent = None
+    for process in psutil.Process().parents():
+        try:
+            if os.path.normcase(process.exe()) == os.path.normcase(str(executable)):
+                parent = process
+                break
+        except (psutil.NoSuchProcess, psutil.AccessDenied):
+            continue
+    if parent is None:
+        return None
+    installed = json.loads((runtime / "installed.json").read_text(encoding="utf-8"))
+    base_id = installed.get("baseRuntimeId", runtime.name)
+    if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9.+_-]{0,100}", base_id):
+        raise ValueError("Invalid desktop base runtime")
+    base = runtime.parent / base_id
+    node = base / ("node/node.exe" if os.name == "nt" else "node/bin/node")
+    return {"runtimeRoot": str(runtime), "profileRoot": str(profile),
+            "appExecutable": str(executable), "appPid": parent.pid,
+            "appCreateTime": parent.create_time(), "nodeExecutable": str(node)}
+
+
+def stage_launcher():
+    context = desktop_context()
+    if context is None:
+        return {"status": "not-desktop"}
+    script = Path(context["runtimeRoot"]) / "launcher/src/shell-update.mjs"
+    if not script.is_file():
+        raise RuntimeError("The update is missing its signed desktop launcher")
+    result = subprocess.run(
+        [context["nodeExecutable"], str(script), "--stage"], input=json.dumps(context),
+        capture_output=True, text=True, encoding="utf-8", timeout=120, check=False,
+        env={k: v for k, v in os.environ.items() if k != "ELECTRON_RUN_AS_NODE"},
+    )
+    if result.returncode:
+        raise RuntimeError("Desktop launcher staging failed: " + result.stderr.strip()[:500])
+    return json.loads(result.stdout)
+
+
+def launcher_status():
+    context = desktop_context()
+    if context is None:
+        return {"available": False, "restart_required": False}
+    state_file = Path(context["profileRoot"]) / "launcher-update.json"
+    try:
+        state = json.loads(state_file.read_text(encoding="utf-8"))
+    except FileNotFoundError:
+        state = {}
+    pending = state.get("status") in {"ready", "failed", "restarting"}
+    return {"available": True, "restart_required": pending,
+            "restarting": state.get("status") == "restarting",
+            "build_id": state.get("buildId", ""), "error": state.get("error", "")}
+
+
+def restart_launcher():
+    with _restart_lock:
+        return _restart_launcher()
+
+
+def _restart_launcher():
+    context = desktop_context()
+    if context is None:
+        raise ValueError("This request is only available inside the desktop application")
+    status = launcher_status()
+    if status.get("restarting"):
+        return {"scheduled": True}
+    if not status["restart_required"]:
+        raise ValueError("No desktop launcher update is pending")
+    stage_launcher()  # Revalidate signatures and replace stale process metadata before scheduling.
+    profile = Path(context["profileRoot"])
+    state_file = profile / "launcher-update.json"
+    state = json.loads(state_file.read_text(encoding="utf-8"))
+    if not state.get("restartRequired"):
+        raise ValueError("The launcher is already current")
+    state["status"] = "restarting"
+    temporary = state_file.with_suffix(".tmp")
+    temporary.write_text(json.dumps(state), encoding="utf-8")
+    temporary.replace(state_file)
+    script = Path(context["runtimeRoot"]) / "core/deeptutor/runtime/desktop_restart.py"
+    command = [sys.executable, str(script), "--job", str(profile / "launcher-update.json")]
+    if os.name == "nt":
+        command.append("--detach")
+    options = {"stdin": subprocess.DEVNULL, "stdout": subprocess.DEVNULL,
+               "stderr": subprocess.DEVNULL, "cwd": str(profile), "shell": False}
+    if os.name == "nt":
+        options["creationflags"] = subprocess.DETACHED_PROCESS | subprocess.CREATE_NEW_PROCESS_GROUP
+    else:
+        options["start_new_session"] = True
+    try:
+        subprocess.Popen(command, **options)
+    except OSError:
+        state["status"] = "ready"
+        temporary.write_text(json.dumps(state), encoding="utf-8")
+        temporary.replace(state_file)
+        raise
+    return {"scheduled": True}
diff --git a/tests/test_desktop_launcher_restart.py b/tests/test_desktop_launcher_restart.py
