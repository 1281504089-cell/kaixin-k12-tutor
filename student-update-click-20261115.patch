+import { act, fireEvent, render, screen, waitFor } from '@testing-library/react';
+import { afterEach, beforeEach, expect, it, vi } from 'vitest';
+import DesktopLauncherUpdate from '@/components/settings/DesktopLauncherUpdate';
+const request = vi.fn();
+vi.mock('@/lib/api', () => ({ apiFetch: (...args: unknown[]) => request(...args), apiUrl: (path: string) => path }));
+beforeEach(() => { request.mockReset(); window.kaixinDesktop = { checkForUpdates: vi.fn() }; });
+afterEach(() => { delete window.kaixinDesktop; });
+it('asks the local desktop to restart once and keeps a rejected restart retryable', async () => {
+ request.mockResolvedValueOnce(Response.json({restart_required:true})).mockResolvedValueOnce(Response.json({detail:'application declined to close'},{status:409}));
+ render(<DesktopLauncherUpdate/>);
+ fireEvent.click(await screen.findByRole('button',{name:'重新打开完成更新'}));
+ expect(await screen.findByRole('alert')).toHaveTextContent('declined to close');
+ expect(screen.getByRole('button',{name:'重新打开完成更新'})).toBeEnabled();
+ expect(request.mock.calls[1][1]).toMatchObject({method:'POST',headers:{'x-kaixin-desktop-action':'restart'}});
+});
+it('does not offer a restart for an unchanged launcher or a web browser', async()=> {
+ request.mockResolvedValue(Response.json({restart_required:false}));
+ const ui=render(<DesktopLauncherUpdate/>); await waitFor(()=>expect(request).toHaveBeenCalledTimes(1));
+ expect(screen.queryByRole('complementary')).not.toBeInTheDocument();
+ ui.unmount(); delete window.kaixinDesktop; request.mockClear();
+ render(<DesktopLauncherUpdate/>); await act(async()=>{}); expect(request).not.toHaveBeenCalled();
+});
