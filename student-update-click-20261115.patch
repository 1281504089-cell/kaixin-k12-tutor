index 0000000..6d140eb
--- /dev/null
+++ b/tests/test_desktop_launcher_restart.py
@@ -0,0 +1,73 @@
+"""The restart helper must not close an app before verification or lose failure state."""
+import importlib.util
+import json
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+file = Path(__file__).parents[1] / 'deeptutor/runtime/desktop_restart.py'
+spec = importlib.util.spec_from_file_location('desktop_restart_qa', file)
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+
+
+def test_bad_signature_marks_failed_without_closing_or_relaunching(tmp_path):
+    state = tmp_path / 'launcher-update.json'
+    state.write_text(json.dumps({'profileRoot': str(tmp_path), 'status': 'restarting'}))
+    args = SimpleNamespace(job=str(state), detach=False, detached_parent=None, wait_only=False)
+    with patch.object(module, 'validate_job', side_effect=ValueError('Invalid launcher signature')), \
+         patch.object(module, 'quit_application') as close, patch.object(module, 'relaunch') as launch:
+        assert module.run_job(args) == 1
+        close.assert_not_called()
+        launch.assert_not_called()
+    result = json.loads(state.read_text())
+    assert result['status'] == 'failed' and result['restartRequired']
+    assert 'signature' in result['error']
+
+
+def test_timeout_restores_retry_and_keeps_the_running_application(tmp_path):
+    state = tmp_path / 'launcher-update.json'
+    job = {'profileRoot': str(tmp_path), 'status': 'restarting', 'appExecutable': '/synthetic-app'}
+    state.write_text(json.dumps(job))
+    args = SimpleNamespace(job=str(state), detach=False, detached_parent=None, wait_only=False)
+    with patch.object(module, 'validate_job', return_value=job), \
+         patch.object(module, 'finish', side_effect=TimeoutError('did not close')), \
+         patch.object(module, 'app_is_running', return_value=True), patch.object(module, 'relaunch') as launch:
+        assert module.run_job(args) == 1
+        launch.assert_not_called()
+    assert json.loads(state.read_text())['status'] == 'failed'
+
+
+if __name__ == '__main__':
+    from tempfile import TemporaryDirectory
+    for check in [test_bad_signature_marks_failed_without_closing_or_relaunching,
+                  test_timeout_restores_retry_and_keeps_the_running_application]:
+        with TemporaryDirectory() as directory:
+            check(Path(directory))
+        print(check.__name__ + ': passed')
+
+
+def test_restart_http_requires_owned_origin_and_header():
+    import asyncio
+    import os
+    from fastapi import HTTPException
+    from starlette.requests import Request
+    from deeptutor.api.routers.desktop_update import restart_desktop_launcher
+    def request(origin, header):
+        return Request({'type':'http','method':'POST','path':'/','headers':[(b'origin',origin.encode()),(b'x-kaixin-desktop-action',header.encode())]})
+    with patch.dict(os.environ, {'FRONTEND_PORT':'18802'}), \
+         patch('deeptutor.api.routers.desktop_update.desktop_update.restart_launcher', return_value={'scheduled':True}) as restart:
+        for origin, header in [('https://foreign.invalid','restart'),('http://127.0.0.1:18802',''),('http://127.0.0.1:18803','restart')]:
+            try:
+                asyncio.run(restart_desktop_launcher(request(origin,header)))
+                assert False, 'foreign page was accepted'
+            except HTTPException as error:
+                assert error.status_code == 403
+        restart.assert_not_called()
+        assert asyncio.run(restart_desktop_launcher(request('http://127.0.0.1:18802','restart'))) == {'scheduled':True}
+        restart.assert_called_once()
+
+
+if __name__ == '__main__':
+    test_restart_http_requires_owned_origin_and_header()
+    print('test_restart_http_requires_owned_origin_and_header: passed')
