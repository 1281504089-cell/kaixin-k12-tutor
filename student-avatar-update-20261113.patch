+import { act, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+import { WorkspaceMenu } from '@/components/sidebar/WorkspaceMenu'
+import type { DesktopUpdateStatus } from '@/lib/desktop-update'
+
+vi.mock('@/components/workspaces/useWorkspaceChoices', () => ({ useWorkspaceChoices: () => ({ active: '', currentName: '常规', choices: [] }) }))
+vi.mock('@/hooks/useStudentProfile', () => ({ useStudentProfile: () => null }))
+vi.mock('@/components/settings/StudentProfileBadge', () => ({ default: () => null }))
+vi.mock('@/components/sidebar/VersionBadge', () => ({ VersionBadge: () => null }))
+vi.mock('react-i18next', () => ({ useTranslation: () => ({ t: (key: string) => key }) }))
+vi.mock('next/image', () => ({ default: () => null }))
+const available = { available: true, runtimeId: 'next-version' }
+let listener: (status: DesktopUpdateStatus) => void
+const check = vi.fn(), unsubscribe = vi.fn()
+beforeEach(() => {
+  sessionStorage.clear()
+  check.mockReset().mockResolvedValue(undefined)
+  unsubscribe.mockClear()
+  window.kaixinDesktop = {
+    checkForUpdates: check,
+    getUpdateStatus: vi.fn().mockResolvedValue(available),
+    onUpdateStatus: callback => { listener = callback; return unsubscribe },
+  }
+})
+afterEach(() => { delete window.kaixinDesktop })
+
+it('shows an update beside the avatar without opening Settings or checking again', async () => {
+  render(<WorkspaceMenu />)
+  expect(await screen.findByRole('region', { name: 'Update available' })).toBeInTheDocument()
+  expect(screen.getByRole('button', { name: '开心动力超级学霸' })).toHaveTextContent('student.update.short')
+  expect(check).not.toHaveBeenCalled()
+  fireEvent.click(screen.getByRole('button', { name: 'student.update.action' }))
+  await waitFor(() => expect(check).toHaveBeenCalledTimes(1))
+})
+
+it('keeps the marker and menu action after dismissing the notice', async () => {
+  const ui = render(<WorkspaceMenu />)
+  fireEvent.click(await screen.findByRole('button', { name: 'student.update.later' }))
+  expect(screen.queryByRole('region')).not.toBeInTheDocument()
+  const header = screen.getByRole('button', { name: '开心动力超级学霸' })
+  expect(header).toHaveTextContent('student.update.short')
+  fireEvent.click(header)
+  fireEvent.click(screen.getByRole('menuitem', { name: 'student.update.action' }))
+  await waitFor(() => expect(check).toHaveBeenCalledTimes(1))
+  ui.unmount()
+  render(<WorkspaceMenu compact />)
