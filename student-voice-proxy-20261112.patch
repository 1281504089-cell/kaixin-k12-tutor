+    async def test_student_runtime_connects_through_system_socks_proxy(self):
+        from websockets.asyncio.client import connect
+        from websockets.asyncio.server import serve
+
+        async def echo(socket):
+            async for message in socket:
+                await socket.send(message)
+
+        async def proxy(reader, writer):
+            upstream = None
+            try:
+                version, methods = await reader.readexactly(2)
+                self.assertEqual(version, 5)
+                await reader.readexactly(methods)
+                writer.write(b"\x05\x00")
+                await writer.drain()
+                self.assertEqual(await reader.readexactly(4), b"\x05\x01\x00\x01")
+                host = ".".join(str(part) for part in await reader.readexactly(4))
+                port = int.from_bytes(await reader.readexactly(2), "big")
+                remote, upstream = await asyncio.open_connection(host, port)
+                writer.write(b"\x05\x00\x00\x01\x7f\x00\x00\x01\x00\x00")
+                await writer.drain()
+                async def relay(source, target):
+                    while data := await source.read(65536):
+                        target.write(data)
+                        await target.drain()
+                    target.close()
+                await asyncio.gather(relay(reader, upstream), relay(remote, writer))
+            finally:
+                if upstream:
+                    upstream.close()
+                writer.close()
+
+        async with serve(echo, "127.0.0.1", 0) as server, await asyncio.start_server(proxy, "127.0.0.1", 0) as socks:
+            port, proxy_port = server.sockets[0].getsockname()[1], socks.sockets[0].getsockname()[1]
+            async with asyncio.timeout(3):
+                async with connect(f"ws://127.0.0.1:{port}", proxy=f"socks5://127.0.0.1:{proxy_port}") as socket:
+                    await socket.send("synthetic-voice-connection")
+                    self.assertEqual(await socket.recv(), "synthetic-voice-connection")
