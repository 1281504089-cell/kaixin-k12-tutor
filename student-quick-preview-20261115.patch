diff --git a/web/tests/turn-navigator.spec.tsx b/web/tests/turn-navigator.spec.tsx
new file mode 100644
index 0000000..be598de
--- /dev/null
+++ b/web/tests/turn-navigator.spec.tsx
@@ -0,0 +1,178 @@
+import React, { useRef } from 'react'
+import { act, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { TurnNavigator } from '@/components/chat/home/TurnNavigator'
+import type { ChatOutlineEntry } from '@/lib/chat-outline'
+
+vi.mock('react-i18next', () => ({ useTranslation: () => ({ t: (text: string) => text }) }))
+vi.mock('@/features/chat/messages', () => ({ getModeBadgeLabel: (text: string) => text }))
+vi.mock('framer-motion', () => ({
+  useReducedMotion: () => true,
+  AnimatePresence: ({ children }: React.PropsWithChildren) => children,
+  m: {
+    div: React.forwardRef<HTMLDivElement, React.HTMLAttributes<HTMLDivElement>>(function Preview(
+      { children, ...props },
+      ref
+    ) {
+      const dom = { ...props } as Record<string, unknown>
+      for (const key of ['initial', 'animate', 'exit', 'transition']) delete dom[key]
+      return (
+        <div ref={ref} {...dom}>
+          {children}
+        </div>
+      )
+    }),
+  },
+}))
+
+const entries: ChatOutlineEntry[] = [1, 2, 3].map(n => ({
+  key: `m${n}`,
+  index: n - 1,
+  ordinal: n,
+  title: `Question ${n}`,
+  reply: `Answer ${n}`,
+  weight: n / 3,
+}))
+let width = 480
+let resize: () => void
+function Harness({ rows = entries, onJump = vi.fn(), onBottom = vi.fn() }) {
+  const ref = useRef<HTMLDivElement>(null)
+  return (
+    <div data-wrapper>
+      <div ref={ref}>
+        <div data-chat-column style={{ paddingLeft: 24 }}>
+          {rows.map(row => (
+            <div key={row.key} data-turn-key={row.key} />
+          ))}
+        </div>
+      </div>
+      <TurnNavigator entries={rows} scrollRootRef={ref} onJump={onJump} onJumpToBottom={onBottom} />
+    </div>
+  )
+}
+
+beforeEach(() => {
+  width = 480
+  vi.stubGlobal(
+    'ResizeObserver',
+    class {
+      constructor(callback: () => void) {
+        resize = callback
+      }
+      observe() {}
+      disconnect() {}
+    }
+  )
+  vi.spyOn(HTMLElement.prototype, 'getBoundingClientRect').mockImplementation(function (
+    this: HTMLElement
+  ) {
+    const top = this.hasAttribute('data-turn-key')
+      ? 60 + (Number(this.getAttribute('data-turn-key')?.slice(1)) - 1) * 300
+      : this.hasAttribute('data-tick')
+        ? 250
+        : this.hasAttribute('data-chat-turn-navigator')
+          ? 200
+          : 0
+    return {
+      x: 0,
+      y: top,
+      top,
+      left: 0,
+      right: width,
+      bottom: top + 640,
+      width,
+      height: 640,
+      toJSON() {},
+    }
+  })
+})
+
+describe('conversation quick previews', () => {
+  it('shows two questions in a normal 24px gutter, previews and jumps to the original', async () => {
+    const onJump = vi.fn()
+    const { container } = render(<Harness rows={entries.slice(0, 2)} onJump={onJump} />)
+    expect(container.querySelector('[data-chat-turn-navigator]')).toHaveStyle({
+      visibility: 'visible',
+    })
+    const mark = screen.getByRole('button', { name: '2. Question 2' })
+    fireEvent.mouseEnter(mark)
+    expect(screen.getByText('Answer 2')).toBeVisible()
+    fireEvent.click(mark)
+    expect(onJump).toHaveBeenCalledWith('m2')
+    await waitFor(() =>
+      expect(screen.getByRole('button', { name: '1. Question 1' })).toHaveAttribute(
+        'aria-current',
+        'true'
+      )
+    )
+  })
+
+  it('allows keyboard preview, Escape dismissal and activation from the card', () => {
+    const onJump = vi.fn()
+    render(<Harness onJump={onJump} />)
+    fireEvent.focus(screen.getByRole('button', { name: '2. Question 2' }))
+    fireEvent.keyDown(screen.getByRole('navigation'), { key: 'Escape' })
+    expect(screen.queryByText('Answer 2')).toBeNull()
+    fireEvent.focus(screen.getByRole('button', { name: '3. Question 3' }))
+    fireEvent.click(screen.getByRole('button', { name: 'Jump to this message' }))
+    expect(onJump).toHaveBeenCalledWith('m3')
+  })
+
+  it('fits the card within narrow and large conversation panes', () => {
+    const { container } = render(<Harness />)
+    for (const paneWidth of [280, 390, 844, 1366, 1920]) {
+      width = paneWidth
+      act(() => resize())
+      fireEvent.mouseEnter(screen.getByRole('button', { name: '2. Question 2' }))
+      const preview = container.querySelector<HTMLElement>('[data-turn-preview]')!
+      expect(parseFloat(preview.style.width)).toBeLessThanOrEqual(paneWidth - 48)
+      expect(parseFloat(preview.style.width)).toBeLessThanOrEqual(420)
+    }
+  })
+
+  it('does not retain the old preview when switching conversations or branches', () => {
+    const { rerender } = render(<Harness />)
+    fireEvent.mouseEnter(screen.getByRole('button', { name: '2. Question 2' }))
+    rerender(
+      <Harness
+        rows={entries.map(row => ({ ...row, key: `other-${row.key}`, reply: 'Other answer' }))}
+      />
+    )
+    expect(screen.queryByText('Answer 2')).toBeNull()
+    expect(screen.queryByText('Other answer')).toBeNull()
+  })
+
+  it('lets touch users preview first, then jump, and dismisses an outside tap', () => {
+    const onJump = vi.fn()
+    render(<Harness onJump={onJump} />)
+    const mark = screen.getByRole('button', { name: '2. Question 2' })
+    const event = new Event('pointerdown', { bubbles: true })
+    Object.defineProperty(event, 'pointerType', { value: 'touch' })
+    fireEvent(mark, event)
+    fireEvent.click(mark)
+    expect(onJump).not.toHaveBeenCalled()
+    expect(screen.getByText('Answer 2')).toBeVisible()
+    fireEvent.click(screen.getByRole('button', { name: 'Jump to this message' }))
+    expect(onJump).toHaveBeenCalledWith('m2')
+    fireEvent.mouseEnter(mark)
+    fireEvent.pointerDown(document.body)
+    expect(screen.queryByText('Answer 2')).toBeNull()
+  })
+
+  it('keeps Alt navigation out of editable inputs and removes its listener on unmount', async () => {
+    const onJump = vi.fn()
+    const { unmount } = render(<Harness onJump={onJump} />)
+    await act(async () => new Promise(resolve => setTimeout(resolve, 30)))
+    const input = document.createElement('textarea')
+    document.body.append(input)
+    fireEvent.keyDown(input, { altKey: true, key: 'ArrowDown' })
+    expect(onJump).not.toHaveBeenCalled()
+    input.remove()
+    fireEvent.keyDown(window, { altKey: true, key: 'ArrowDown' })
+    expect(onJump).toHaveBeenCalledWith('m2')
+    unmount()
+    onJump.mockClear()
+    fireEvent.keyDown(window, { altKey: true, key: 'ArrowDown' })
+    expect(onJump).not.toHaveBeenCalled()
+  })
+})
