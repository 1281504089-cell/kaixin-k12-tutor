+  activate?: boolean;
+  signal?: AbortSignal;
+} = {}): Promise<RealtimeVoiceSettings> {
+  const saving = "key" in options || options.activate;
+  const response = await apiFetch(`/api/voice/realtime-key?provider=${options.provider ?? "active"}`, {
+    method: saving ? "PUT" : "GET",
+    headers: saving ? { "Content-Type": "application/json" } : undefined,
