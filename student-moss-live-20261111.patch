index 0000000000000000000000000000000000000000..e8ee8ed339492cc8cdf1c2370fa3717e1652144a
--- /dev/null
+++ b/tests/services/test_moss_realtime.py
@@ -0,0 +1,131 @@
+"""Offline protocol and private-key regression checks; no live API calls."""
+
+import base64
+import json
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import AsyncMock, patch
+
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+from deeptutor.api.routers import voice
+from deeptutor.services.voice import realtime_credentials as credentials
+from deeptutor.services.voice.moss_realtime import MossRealtime
+
+
+class Socket:
+    def __init__(self, events):
+        self.events = events
+        self.sent = []
+
+    async def send(self, message):
+        self.sent.append(json.loads(message) if isinstance(message, str) else message)
+
+    async def __aiter__(self):
+        for event in self.events:
+            yield json.dumps(event) if isinstance(event, dict) else event
+
+
+class MossProtocolTests(unittest.IsolatedAsyncioTestCase):
+    async def test_history_keeps_revised_and_actually_spoken_text_once(self):
+        from deeptutor.services.voice import realtime_tutor as tutor
+
+        socket = Socket([
