+"""MOSS-Live wire events adapted to the shared tutoring call."""
+
+from __future__ import annotations
+
+import base64
+import json
+from uuid import uuid4
+
+ENDPOINT = "wss://api.mosi.cn/v1/realtime?model=moss-live-1.0"
+
+
+class MossRealtime:
+    def __init__(self, socket):
+        self.socket = socket
+        self.settings = {}
+        self.configured = False
+        self.updated = False
+        self.ready = False
+        self.scene_event = None
+        self.pending_tools = set()
+        self.user_item = uuid4().hex
+        self.user_turns = {}
+        self.assistant_item = uuid4().hex
+
+    async def action(self, action, **fields):
+        await self.socket.send(json.dumps({"action": action, **fields}, ensure_ascii=False))
+
+    async def send(self, kind, **fields):
+        if kind == "session.create":
+            self.settings = fields["session"]
+            await self.action("attach_session", session_id=None)
+        elif kind == "session.update":
+            self.scene_event = fields.get("event_id")
+            await self.action("session.update", session={"instructions": fields["session"]["instructions"]})
+        elif kind == "input_audio_buffer.append":
+            await self.socket.send(b"\x00" + base64.b64decode(fields["audio"]))
+        elif kind == "conversation.item.create":
+            for item in fields["items"]:
+                self.pending_tools.add(item["call_id"])
+                await self.action("conversation.item.create", item={
+                    "type": "function_call_output", "call_id": item["call_id"],
+                    "output": item["content"][0]["text"],
+                })
+        elif kind.startswith("playback."):
+            await self.action(kind, **fields)
+        elif kind == "session.close":
+            await self.socket.close()
+
+    async def __aiter__(self):
+        async for raw in self.socket:
+            if isinstance(raw, bytes):
+                yield raw
+                continue
+            event = json.loads(raw)
+            kind, data = event.get("action"), event.get("data") or {}
+            if kind == "session_attached":
+                await self.action("media.mode", binary_protocol="tagged-v1")
+                await self.action("media.configure", output_audio={"format": "pcm16", "sample_rate": 24000}, playback="client")
+                await self.action("session.update", session={
+                    "persona": {"name": "学习老师", "prompt": "你是自然交流、循循善诱的学习老师。"},
+                    "instructions": self.settings["instructions"], "tools": self.settings["tools"],
+                })
+            elif kind == "media.configured":
+                audio = data.get("output_audio") or {}
+                if data.get("error") or audio.get("format") != "pcm16" or audio.get("sample_rate") != 24000 or audio.get("channels") != 1:
+                    yield {"type": "error"}
+                    return
+                self.configured = True
+            elif kind == "session.updated":
+                if data.get("error"):
+                    yield {"type": "error", "event_id": self.scene_event}
+                    if not self.ready:
+                        return
+                else:
+                    self.updated = True
+                    if self.ready:
+                        yield {"type": "session.updated"}
+                self.scene_event = None
+            elif kind in {"input.transcript.updated", "input.transcript.done", "input.transcript.revised"}:
+                if kind.endswith("revised"):
+                    item = self.user_turns.get(data.get("turn"))
+                    if item is None:
+                        continue
+                else:
+                    item = self.user_item
+                yield {"type": "transcript.snapshot", "role": "user", "id": item,
+                       "text": data.get("text", ""), "final": not kind.endswith("updated")}
+                if kind.endswith("done"):
+                    if data.get("turn"):
+                        self.user_turns[data["turn"]] = item
+                    self.user_item = uuid4().hex
+            elif kind in {"output.transcript.updated", "output.transcript.done", "response.interrupted"}:
+                item = data.get("run_id") or self.assistant_item
+                yield {"type": "transcript.snapshot", "role": "assistant", "id": item,
+                       "text": data.get("text", ""), "final": not kind.endswith("updated")}
+            elif kind in {"response.audio.started", "response.audio.context", "response.audio.done", "response.audio.stop"}:
+                mapped = {"response.audio.started": "response.output_audio.started",
+                          "response.audio.context": "audio.context", "response.audio.done": "response.output_audio.done",
+                          "response.audio.stop": "response.canceled"}[kind]
+                yield {"type": mapped, **{key: data[key] for key in ("run_id", "turn_id", "chunk_id") if key in data}}
+            elif kind == "response.ended":
+                self.assistant_item = uuid4().hex
+                if data.get("status") == "failed":
+                    yield {"type": "error"}
+            elif kind == "response.function_call_arguments.done":
+                yield {"type": kind, "items": [data]}
+            elif kind == "conversation.item.created":
+                call_id = (data.get("item") or {}).get("call_id")
+                if call_id in self.pending_tools:
+                    self.pending_tools.remove(call_id)
+                    await self.action("response.create", response={"call_ids": [call_id]})
+            elif kind == "error":
+                yield {"type": "error"}
+            if not self.ready and self.configured and self.updated:
+                self.ready = True
+                await self.action("mic_state", enabled=True)
+                yield {"type": "session.created"}
