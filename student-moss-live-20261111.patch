+    signal: options.signal,
   });
   if (response.status === 400) throw new Error("语音 Key 格式不正确。");
   if (response.status === 403) throw new Error("请在本机的超级学霸中设置语音 Key。");
   if (!response.ok) throw new Error("无法读取或更新语音 Key，请重试。");
-  return (await response.json()).configured === true;
+  const value = await response.json();
+  const provider = value.provider ?? "doubao";
+  if ((provider !== "doubao" && provider !== "moss") || (options.provider && options.provider !== provider)) {
+    throw new Error("当前版本尚不支持这个语音服务，请更新超级学霸。");
+  }
+  return { provider, active_provider: value.active_provider ?? "doubao", configured: value.configured === true };
 }
