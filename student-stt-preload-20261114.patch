index 0000000..458a977
--- /dev/null
+++ b/tests/services/test_local_stt_failures.py
@@ -0,0 +1,102 @@
+import asyncio
+from types import SimpleNamespace
+
+import pytest
+
+from deeptutor.services import local_ai
+from deeptutor.services.voice.adapters.local import LocalSTTAdapter
+from deeptutor.services.voice.audio import pcm_to_wav
+from deeptutor.services.voice.base import VoiceProviderError
+from deeptutor.services.voice.config import STTConfig
+
+
+@pytest.mark.asyncio
+async def test_worker_exit_reports_code_and_reaps_child(monkeypatch):
+    from unittest.mock import AsyncMock
+
+    child = SimpleNamespace(
+        stdin=SimpleNamespace(write=lambda _: None, drain=AsyncMock()),
+        returncode=None,
+        wait=AsyncMock(),
+    )
+
+    async def exited():
+        child.returncode = 3221225781
+        return b""
+
+    child.stdout = SimpleNamespace(readline=exited)
+    monkeypatch.setattr(local_ai, "_stt_process", child)
+    monkeypatch.setattr(local_ai, "_stt_language", "auto")
+    with pytest.raises(local_ai.LocalAIWorkerError, match="3221225781"):
+        await local_ai._request_stt(b"synthetic-audio", "auto")
+    child.wait.assert_awaited()
+    assert local_ai._stt_process is None
+
+
+@pytest.mark.asyncio
+async def test_worker_stdio_is_utf8_and_native_errors_reach_runtime_log(monkeypatch):
+    from unittest.mock import AsyncMock
+
+    spawn = AsyncMock(return_value=object())
+    monkeypatch.setattr(asyncio, "create_subprocess_exec", spawn)
+    monkeypatch.setenv("PYTHONIOENCODING", "cp936")
+    await local_ai._start_worker("stt-session", "zh")
+    kwargs = spawn.await_args.kwargs
+    assert kwargs["stderr"] is None
+    assert kwargs["env"]["PYTHONIOENCODING"] == "utf-8"
+    assert kwargs["env"]["PYTHONUTF8"] == "1"
+
+
+@pytest.mark.asyncio
+async def test_voice_preserves_actionable_worker_failure(monkeypatch):
+    async def fail(*args, **kwargs):
+        raise local_ai.LocalAIWorkerError("本机语音识别组件意外退出（代码 7）。")
+
+    monkeypatch.setattr("deeptutor.services.voice.adapters.local.run_worker", fail)
+    with pytest.raises(VoiceProviderError, match="代码 7"):
+        await LocalSTTAdapter().transcribe(
+            pcm_to_wav(bytes(32000), 16000), STTConfig(model="sensevoice-small-int8")
+        )
+
+
+@pytest.mark.asyncio
+async def test_startup_warmup_stays_local_with_a_cloud_voice_selection(monkeypatch):
+    from unittest.mock import AsyncMock
+    from deeptutor.services import voice
+
+    monkeypatch.setenv("DEEPTUTOR_LOCAL_AI", "/bundled-models")
+    monkeypatch.setattr(
+        "deeptutor.services.config.provider_runtime.resolve_stt_runtime_config",
+        lambda **_: pytest.fail("Student warmup must not depend on a cloud voice service"),
+    )
+    worker = AsyncMock(return_value={})
+    monkeypatch.setattr(local_ai, "run_worker", worker)
+    await voice.warm_local_stt(prefer_local=True)
+    worker.assert_awaited_once_with("stt", b"", language="auto")
+
+
+@pytest.mark.asyncio
+async def test_prepared_speech_worker_is_reused_until_explicit_close(monkeypatch):
+    from unittest.mock import AsyncMock
+
+    child = SimpleNamespace(
+        stdin=SimpleNamespace(write=lambda _: None, drain=AsyncMock()),
+        stdout=SimpleNamespace(readline=AsyncMock(side_effect=[b"{}\n", b'{"text":"hello"}\n'])),
+        returncode=None,
+        wait=AsyncMock(),
+    )
+    def kill():
+        child.returncode = -9
+    child.kill = kill
+    spawn = AsyncMock(return_value=child)
+    monkeypatch.setattr(local_ai, "_start_worker", spawn)
+    monkeypatch.setattr(local_ai, "_stt_process", None)
+    monkeypatch.setattr(local_ai, "_stt_language", None)
+    loop = asyncio.get_running_loop()
+    monkeypatch.setattr(loop, "call_later", lambda *_, **__: pytest.fail("Warm decoder must not expire while studying"))
+    assert await local_ai._request_stt(b"", "auto") == b"{}\n"
+    assert await local_ai._request_stt(b"synthetic-audio", "auto") == b'{"text":"hello"}\n'
+    spawn.assert_awaited_once()
+    await local_ai.close_stt_worker()
+    assert child.returncode == -9
+    child.wait.assert_awaited_once()
diff --git a/tests/services/test_local_stt_worker.py b/tests/services/test_local_stt_worker.py
new file mode 100644
index 0000000..409295a
--- /dev/null
+++ b/tests/services/test_local_stt_worker.py
@@ -0,0 +1,87 @@
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from deeptutor.services.local_ai import worker
+
+
+@pytest.fixture(autouse=True)
+def clear_recognizer_cache():
+    worker.speech_recognizer.cache_clear()
+    yield
+    worker.speech_recognizer.cache_clear()
+
+
+@pytest.fixture
+def model_directory(tmp_path, monkeypatch):
+    root = tmp_path / "开心动力超级学霸"
+    directory = root / "sensevoice"
+    directory.mkdir(parents=True)
+    (directory / "model.int8.onnx").write_bytes(b"model")
+    (directory / "tokens.txt").write_bytes(b"tokens")
+    monkeypatch.setenv("DEEPTUTOR_LOCAL_AI", str(root))
+    return directory
+
+
+def install_recognizer(monkeypatch, create):
+    monkeypatch.setitem(
+        sys.modules,
+        "sherpa_onnx",
+        SimpleNamespace(OfflineRecognizer=SimpleNamespace(from_sense_voice=create)),
+    )
+
+
+def test_windows_uses_ascii_filenames_in_model_directory(model_directory, monkeypatch):
+    original = Path.cwd()
+    result = object()
+    calls = []
+    monkeypatch.setattr(worker, "sys", SimpleNamespace(platform="win32"))
+
+    def create(**kwargs):
+        calls.append(kwargs)
+        assert Path.cwd() == model_directory
+        for key, expected in (("model", b"model"), ("tokens", b"tokens")):
+            assert kwargs[key].isascii()
+            assert Path(kwargs[key]).name == kwargs[key]
+            assert Path(kwargs[key]).read_bytes() == expected
+        assert kwargs["language"] == "zh"
+        assert kwargs["provider"] == "cpu"
+        return result
+
+    install_recognizer(monkeypatch, create)
+    assert worker.speech_recognizer("zh") is result
+    assert Path.cwd() == original
+    assert worker.speech_recognizer("zh") is result
+    assert len(calls) == 1
+
+
+def test_windows_restores_directory_when_recognizer_fails(model_directory, monkeypatch):
+    original = Path.cwd()
+    monkeypatch.setattr(worker, "sys", SimpleNamespace(platform="win32"))
+
+    def create(**kwargs):
+        assert Path.cwd() == model_directory
+        raise RuntimeError("synthetic model load failure")
+
+    install_recognizer(monkeypatch, create)
+    with pytest.raises(RuntimeError, match="synthetic model load failure"):
+        worker.speech_recognizer("auto")
+    assert Path.cwd() == original
+
+
+def test_non_windows_preserves_absolute_paths_and_directory(model_directory, monkeypatch):
+    original = Path.cwd()
+    monkeypatch.setattr(worker, "sys", SimpleNamespace(platform="darwin"))
+    monkeypatch.setattr(worker, "chdir", lambda _: pytest.fail("Non-Windows must not change cwd"))
+
+    def create(**kwargs):
+        assert Path.cwd() == original
+        assert kwargs["model"] == str(model_directory / "model.int8.onnx")
+        assert kwargs["tokens"] == str(model_directory / "tokens.txt")
+        return "recognizer"
+
+    install_recognizer(monkeypatch, create)
+    assert worker.speech_recognizer("auto") == "recognizer"
+    assert Path.cwd() == original
