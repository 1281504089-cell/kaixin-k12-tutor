+async def test_old_unrelated_fallback_is_hidden_without_rewriting_saved_records(setup, subject):
+    await seed(setup, workspace=subject, content="继续本次学习。")
+    period = reports.ReportRange(**PERIOD.model_dump(exclude={"subject"}), subject=subject)
+    row, task = await reports.begin(period)
+    manager, notebook, saved = task[:3]
+    reports.save(manager, notebook, {**saved, "state": "ready", "stage": None, "policy": "old-policy",
+                                   "result_level": "records", "subject_review": {"title": "运算顺序与验算", "exercises": [{}]}})
+    before = manager.get_record(notebook, row["id"])
+    shown = await reports.detail(row["id"])
+    assert shown["state"] == "failed" and shown.get("subject_review") is None
+    assert "旧版备用稿" in shown["message"]
+    assert (await reports.overview(period))["report"]["state"] == "failed"
+    assert setup.client.get("/api/student/reports/history").json()[0]["state"] == "failed"
+    with pytest.raises(reports.ReportError, match="还没有可导出的正文"):
+        await reports.export_word(row["id"])
+    assert manager.get_record(notebook, row["id"]) == before
