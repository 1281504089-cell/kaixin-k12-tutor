+import { act, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, expect, it, vi } from "vitest";
+import VoiceRecordingStatus from "@/components/chat/home/VoiceRecordingStatus";
+
+afterEach(() => { vi.useRealTimers(); vi.unstubAllGlobals(); });
+
+it("shows recording time and a direct finish action, then switches to transcription", () => {
+  vi.useFakeTimers();
+  const stop = vi.fn();
+  const view = render(<VoiceRecordingStatus state="recording" stream={null} onStop={stop} />);
+  expect(screen.getByRole("status")).toHaveTextContent("正在录音");
+  act(() => vi.advanceTimersByTime(3000));
+  expect(screen.getByLabelText("录音时长")).toHaveTextContent("0:03");
+  fireEvent.click(screen.getByRole("button", { name: "完成录音" }));
+  expect(stop).toHaveBeenCalledTimes(1);
+  view.rerender(<VoiceRecordingStatus state="transcribing" stream={null} onStop={stop} />);
+  expect(screen.getByRole("status")).toHaveTextContent("正在转文字");
+  expect(screen.queryByLabelText("录音时长")).not.toBeInTheDocument();
+});
+
+it("uses captured audio levels and releases the visual meter without stopping microphone tracks", () => {
+  let frame!: FrameRequestCallback;
+  let sample = 160;
+  const disconnect = vi.fn();
+  const close = vi.fn().mockResolvedValue(undefined);
+  const connect = vi.fn();
+  vi.stubGlobal("requestAnimationFrame", (callback: FrameRequestCallback) => { frame = callback; return 1; });
+  const cancel = vi.fn();
+  vi.stubGlobal("cancelAnimationFrame", cancel);
+  vi.stubGlobal("AudioContext", class {
+    createMediaStreamSource() { return { connect, disconnect }; }
+    createAnalyser() { return { fftSize: 256, getByteTimeDomainData: (data: Uint8Array) => data.fill(sample) }; }
+    resume() { return Promise.resolve(); }
+    close = close;
+  });
+  const stream = { getTracks: vi.fn() } as unknown as MediaStream;
+  const view = render(<VoiceRecordingStatus state="recording" stream={stream} onStop={() => {}} />);
+  act(() => frame(100));
+  const bar = view.container.querySelectorAll("i")[12] as HTMLElement;
+  expect(bar.style.transform).toBe("scaleY(1)");
+  sample = 128;
+  act(() => frame(200));
+  expect(bar.style.transform).toBe("scaleY(0.16)");
+  view.unmount();
+  expect(disconnect).toHaveBeenCalledOnce();
+  expect(close).toHaveBeenCalledOnce();
+  expect(cancel).toHaveBeenCalled();
+  expect(stream.getTracks).not.toHaveBeenCalled();
+});
+
+it("keeps the recording explanation when reduced motion disables the visual meter", () => {
+  const audio = vi.fn();
+  vi.stubGlobal("AudioContext", audio);
+  vi.stubGlobal("matchMedia", () => ({ matches: true }));
+  render(<VoiceRecordingStatus state="recording" stream={{} as MediaStream} onStop={() => {}} />);
+  expect(screen.getByRole("status")).toHaveTextContent("正在录音");
+  expect(audio).not.toHaveBeenCalled();
+});
