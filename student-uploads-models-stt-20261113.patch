+"""Provider switches must not replay empty assistant messages as invalid content."""
+
+from copy import deepcopy
+
+import pytest
+
+from deeptutor.services.llm.provider_core.base import LLMProvider
+
+
+@pytest.mark.parametrize("content", [None, "", " \n\t", [], [{"type": "text", "text": " "}], {"type": "text", "text": ""}])
+def test_empty_history_is_compatible_without_mutating_saved_messages(content):
+    messages = [{"role": "assistant", "content": content, "reasoning_content": "previous reasoning"}]
+    before = deepcopy(messages)
+    cleaned = LLMProvider._sanitize_empty_content(messages)
+    assert cleaned == [{**messages[0], "content": "(empty)"}]
+    assert messages == before
+
+
+def test_tool_rounds_and_multimodal_evidence_survive_sanitization():
+    calls = [{"id": "call1", "type": "function", "function": {"name": "read", "arguments": "{}"}}]
+    image = {"type": "image_url", "image_url": {"url": "data:image/png;base64,example"}}
+    messages = [
+        {"role": "assistant", "content": [], "tool_calls": calls},
+        {"role": "tool", "tool_call_id": "call1", "content": ""},
+        {"role": "user", "content": [{"type": "text", "text": " "}, image]},
+        {"role": "assistant", "content": "题目中的公式", "_provider_response_state": {"reasoning_content": "reasoning"}},
+    ]
+    cleaned = LLMProvider._sanitize_empty_content(messages)
+    assert cleaned[0] == {**messages[0], "content": None}
+    assert cleaned[1] == {**messages[1], "content": "(empty)"}
+    assert cleaned[2]["content"] == [image]
+    assert cleaned[3] == messages[3]
