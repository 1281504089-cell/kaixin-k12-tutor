+import type { RecorderState } from "@/hooks/useVoiceRecorder";
+import styles from "./VoiceRecordingStatus.module.css";
+
+function RecordingFeedback({ stream, onStop }: { stream: MediaStream | null; onStop: () => void }) {
+  const wave = useRef<HTMLSpanElement>(null);
+  const [seconds, setSeconds] = useState(0);
+  useEffect(() => {
+    const started = performance.now();
+    const timer = setInterval(() => setSeconds(Math.floor((performance.now() - started) / 1000)), 1000);
+    return () => clearInterval(timer);
+  }, []);
+  useEffect(() => {
+    if (!stream || typeof AudioContext === "undefined" || window.matchMedia?.("(prefers-reduced-motion: reduce)").matches) return;
+    let audio: AudioContext | undefined;
+    let source: MediaStreamAudioSourceNode | undefined;
+    let frame = 0;
+    let cancelled = false;
+    try {
+      audio = new AudioContext();
+      source = audio.createMediaStreamSource(stream);
+      const analyser = audio.createAnalyser();
+      analyser.fftSize = 256;
+      source.connect(analyser);
+      const samples = new Uint8Array(analyser.fftSize);
+      const levels = Array<number>(13).fill(0.16);
+      let last = 0;
+      const draw = (now: number) => {
+        if (cancelled) return;
+        if (now - last >= 80) {
+          last = now;
+          analyser.getByteTimeDomainData(samples);
+          const rms = Math.sqrt(samples.reduce((sum, sample) => sum + ((sample - 128) / 128) ** 2, 0) / samples.length);
+          levels.shift(); levels.push(Math.min(1, 0.16 + rms * 5));
+          Array.from(wave.current?.children ?? []).forEach((bar, index) => {
+            (bar as HTMLElement).style.transform = `scaleY(${levels[index]})`;
+          });
+        }
+        frame = requestAnimationFrame(draw);
+      };
+      void audio.resume().catch(() => {});
+      frame = requestAnimationFrame(draw);
+    } catch { /* The recording remains usable if its visual meter is unavailable. */ }
+    return () => {
+      cancelled = true;
+      cancelAnimationFrame(frame);
+      source?.disconnect();
+      if (audio) void audio.close().catch(() => {});
+    };
+  }, [stream]);
+  return <div className={styles.recording}>
+    <span ref={wave} className={styles.wave} aria-hidden="true">{Array.from({ length: 13 }, (_, index) => <i key={index} />)}</span>
+    <span role="status">正在录音</span>
+    <time className={styles.time} aria-label="录音时长">{Math.floor(seconds / 60)}:{String(seconds % 60).padStart(2, "0")}</time>
+    <button type="button" className={styles.finish} onClick={onStop}><Square size={11} fill="currentColor" aria-hidden="true" />完成录音</button>
+  </div>;
+}
+
+export default function VoiceRecordingStatus({ state, stream, onStop }: { state: RecorderState; stream: MediaStream | null; onStop: () => void }) {
+  if (state === "idle") return null;
+  return <div className={styles.root}>
+    {state === "recording" ? <RecordingFeedback stream={stream} onStop={onStop} /> : <div className={styles.pending} role="status"><Loader2 size={13} className="animate-spin motion-reduce:animate-none" aria-hidden="true" />{state === "starting" ? "正在打开麦克风…" : "正在转文字…"}</div>}
+  </div>;
+}
