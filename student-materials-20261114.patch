diff --git a/web/components/student/LibraryUploadProvider.tsx b/web/components/student/LibraryUploadProvider.tsx
new file mode 100644
index 0000000..1789940
--- /dev/null
+++ b/web/components/student/LibraryUploadProvider.tsx
@@ -0,0 +1,129 @@
+'use client'
+
+import { createContext, useContext, useEffect, useRef, useState, type ReactNode } from 'react'
+import { classifyFile } from '@/lib/doc-attachments'
+import { notify } from '@/lib/notifications'
+import { RECOVERY_PRINCIPAL_CHANGED, recoveryPrincipal } from '@/lib/recovery-principal'
+import { MAX_UPLOAD_SOURCE_BYTES, uploadDocumentFile, type UploadResult } from '@/lib/student-upload'
+
+type UploadItem = {
+  id: number
+  filename: string
+  file: File | null
+  workspaceId: string
+  principal: string | null
+  status: 'waiting' | 'uploading' | 'saved' | 'failed' | 'stopped'
+  progress: number
+  result?: UploadResult
+  error?: string
+}
+const UploadContext = createContext<{
+  queue: UploadItem[]
+  enqueue: (files: File[], workspaceId: string) => void
+  stop: () => void
+} | null>(null)
+
+export function useLibraryUploads() {
+  const value = useContext(UploadContext)
+  if (!value) throw new Error('Library uploads need the application upload provider')
+  return value
+}
+
+/** Above both route groups and workspace boundaries so navigation cannot stop a batch. */
+export function LibraryUploadProvider({ children }: { children: ReactNode }) {
+  const [queue, setQueue] = useState<UploadItem[]>([])
+  const items = useRef<UploadItem[]>([])
+  const request = useRef<AbortController | null>(null)
+  const mounted = useRef(true)
+  const nextId = useRef(0)
+  const publish = (next: UploadItem[]) => {
+    items.current = next
+    if (mounted.current) setQueue(next)
+  }
+  const update = (id: number, changes: Partial<UploadItem>) =>
+    publish(items.current.map(item => item.id === id ? { ...item, ...changes } : item))
+
+  async function run() {
+    if (request.current || !mounted.current) return
+    const controller = new AbortController()
+    request.current = controller
+    try {
+      for (;;) {
+        if (controller.signal.aborted || !mounted.current) break
+        const item = items.current.find(item => item.status === 'waiting')
+        if (!item) break
+        if (item.principal !== recoveryPrincipal()) {
+          update(item.id, { status: 'stopped', file: null })
+          continue
+        }
+        update(item.id, { status: 'uploading' })
+        try {
+          const file = item.file!
+          if (!classifyFile(file)) throw new Error('不支持这种文件类型，请选择 PDF、Office 文档、图片或文本。')
+          if (!file.size || file.size > MAX_UPLOAD_SOURCE_BYTES) throw new Error('文件为空或超过单份原件 1 GB 上限。')
+          const result = await uploadDocumentFile(file, 'library', item.workspaceId,
+            progress => update(item.id, { progress }), controller.signal)
+          if (!mounted.current) break
+          update(item.id, { status: 'saved', progress: 100, result, file: null })
+        } catch (caught) {
+          if (controller.signal.aborted || !mounted.current) break
+          update(item.id, { status: 'failed', file: null, error: caught instanceof TypeError
+            ? '网络连接中断，请刷新资料后重新选择这份文件。'
+            : caught instanceof Error ? caught.message : '这份文件上传未完成，请重新选择。' })
+        }
+      }
+      if (mounted.current && !controller.signal.aborted) {
+        const saved = items.current.filter(item => item.status === 'saved').length
+        const failed = items.current.filter(item => item.status === 'failed').length
+        notify(`资料上传完成：已保存 ${saved} 份${failed ? `，${failed} 份未完成，可到资料库查看。` : '，已自动加入资料库。'}`,
+          { tone: failed ? 'error' : 'success' })
+      }
+    } finally {
+      request.current = null
+      if (mounted.current && items.current.some(item => item.status === 'waiting')) void run()
+    }
+  }
+
+  function enqueue(files: File[], workspaceId: string) {
+    if (!files.length) return
+    const active = items.current.some(item => item.status === 'waiting' || item.status === 'uploading')
+    const added: UploadItem[] = files.map(file => ({ id: nextId.current++, file, filename: file.name,
+      workspaceId, principal: recoveryPrincipal(), status: 'waiting', progress: 0 }))
+    publish([...(active ? items.current : []), ...added])
+    notify(`已将 ${files.length} 份资料加入后台上传队列，可切换到其他页面。`)
+    void run()
+  }
+
+  function stop() {
+    request.current?.abort()
+    publish(items.current.map(item => item.status === 'waiting' || item.status === 'uploading'
+      ? { ...item, status: 'stopped', file: null } : item))
+  }
+
+  useEffect(() => {
+    mounted.current = true
+    const accountChanged = () => {
+      const active = items.current.some(item => item.status === 'waiting' || item.status === 'uploading')
+      request.current?.abort()
+      publish([])
+      if (active) notify('登录状态已变化，未完成资料上传已停止，请重新选择。', { tone: 'info' })
+    }
+    window.addEventListener(RECOVERY_PRINCIPAL_CHANGED, accountChanged)
+    return () => {
+      mounted.current = false
+      request.current?.abort()
+      window.removeEventListener(RECOVERY_PRINCIPAL_CHANGED, accountChanged)
+    }
+  }, [])
+
+  const active = queue.some(item => item.status === 'waiting' || item.status === 'uploading')
+  useEffect(() => {
+    if (!active) return
+    // shortcut: files live in this application session; durable restart recovery needs a native file spool.
+    const leaving = (event: BeforeUnloadEvent) => { event.preventDefault(); event.returnValue = '' }
+    window.addEventListener('beforeunload', leaving)
+    return () => window.removeEventListener('beforeunload', leaving)
+  }, [active])
+
+  return <UploadContext.Provider value={{ queue, enqueue, stop }}>{children}</UploadContext.Provider>
+}
