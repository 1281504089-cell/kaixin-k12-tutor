+'use client'
+
+import { useEffect, useId, useRef, useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import { FileText, Library, Loader2, RefreshCw, Search } from 'lucide-react'
+import PickerShell from '@/components/common/PickerShell'
+import PickerHeader from '@/components/common/PickerHeader'
+import { chatLibraryMaterials, referenceLibraryMaterial, type ChatLibraryMaterial } from '@/lib/chat-library-materials'
+import { formatFileSize } from '@/lib/knowledge-helpers'
+import type { PendingAttachment } from '@/features/chat/controllers/pending-attachments'
+
+/** Mounted only while open: leaving the conversation discards pending picker results. */
+export default function LibraryMaterialPicker({ workspaceId, onSelect, onClose }: {
+  workspaceId: string
+  onSelect: (attachment: PendingAttachment) => void
+  onClose: () => void
+}) {
+  const { t } = useTranslation()
+  const titleId = useId()
+  const [rows, setRows] = useState<ChatLibraryMaterial[]>([])
+  const [query, setQuery] = useState('')
+  const [error, setError] = useState('')
+  const [loading, setLoading] = useState(true)
+  const [busy, setBusy] = useState('')
+  const [revision, setRevision] = useState(0)
+  const lifetime = useRef({ alive: true, pending: false })
+  useEffect(() => {
+    const state = lifetime.current
+    state.alive = true
+    return () => { state.alive = false }
+  }, [lifetime])
+  useEffect(() => {
+    let current = true
+    void chatLibraryMaterials().then(result => {
+      if (!current) return
+      setRows(result.rows)
+      setError(result.error)
+      setLoading(false)
+    }).catch(() => {
+      if (current) { setError('资料库暂时无法读取，请重试。'); setLoading(false) }
+    })
+    return () => { current = false }
+  }, [revision])
+  async function select(row: ChatLibraryMaterial) {
+    if (lifetime.current.pending) return
+    lifetime.current.pending = true
+    setBusy(row.key)
+    setError('')
+    try {
+      const attachment = await referenceLibraryMaterial(row, workspaceId)
+      if (lifetime.current.alive) { onSelect(attachment); onClose() }
+    } catch (cause) {
+      if (lifetime.current.alive) setError(cause instanceof Error ? cause.message : '引用失败，请重试。')
+    } finally {
+      lifetime.current.pending = false
+      if (lifetime.current.alive) setBusy('')
+    }
+  }
+  const filtered = rows.filter(row => `${row.name} ${row.detail}`.toLocaleLowerCase().includes(query.trim().toLocaleLowerCase()))
+  return <PickerShell open onClose={onClose} labelledBy={titleId}>
+    <div className="flex max-h-[min(760px,90dvh)] w-[min(640px,calc(100vw-24px))] flex-col overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--background)] shadow-2xl">
+      <PickerHeader icon={Library} titleId={titleId} title={t("从资料库选择")} subtitle={t("引用原件到当前对话，保留资料原来的所属项目。")} onClose={onClose} />
+      <div className="flex gap-2 px-5 py-3">
+        <label className="flex min-w-0 flex-1 items-center gap-2 rounded-xl border border-[var(--border)] px-3 py-2">
+          <Search size={15} aria-hidden />
+          <input aria-label={t("搜索资料库")} placeholder={t("搜索文件或项目")} value={query} onChange={event => setQuery(event.target.value)} className="min-w-0 flex-1 bg-transparent text-sm outline-none" />
+        </label>
+        <button type="button" aria-label={t("刷新资料库")} disabled={loading || !!busy} onClick={() => { setLoading(true); setError(''); setRevision(value => value + 1) }} className="rounded-xl px-3 hover:bg-[var(--muted)] disabled:opacity-40"><RefreshCw size={16} /></button>
+      </div>
+      {error && <div role="alert" className="px-5 pb-3 text-sm text-red-600">{error}</div>}
+      <div className="min-h-0 overflow-y-auto px-3 pb-3">
+        {loading ? <p role="status" className="flex items-center gap-2 p-4 text-sm"><Loader2 size={16} className="animate-spin" />{t("正在读取资料库…")}</p> : filtered.length ? filtered.map(row =>
+          <button key={row.key} type="button" disabled={!!busy} onClick={() => void select(row)} className="flex w-full items-center gap-3 rounded-xl p-3 text-left hover:bg-[var(--muted)] disabled:opacity-50">
+            <FileText size={20} className="shrink-0 text-[var(--muted-foreground)]" aria-hidden />
+            <span className="min-w-0 flex-1"><span className="block break-words text-sm font-medium">{row.name}</span><span className="mt-1 block break-words text-xs text-[var(--muted-foreground)]">{row.detail}{row.size ? ` · ${formatFileSize(row.size)}` : ''}</span></span>
+            {busy === row.key ? <Loader2 size={16} className="shrink-0 animate-spin" aria-label={t("正在引用")} /> : <span className="shrink-0 text-xs text-[var(--primary)]">{t("引用")}</span>}
+          </button>
+        ) : <p className="p-4 text-sm text-[var(--muted-foreground)]">{query ? '没有找到匹配资料。' : '资料库暂无可引用原件，可先在资料库上传。'}</p>}
+      </div>
+    </div>
+  </PickerShell>
+}
