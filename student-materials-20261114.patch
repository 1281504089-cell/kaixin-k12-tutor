+"use client";
+
+import { useMemo, useState } from "react";
+import { Loader2 } from "lucide-react";
+import { useTranslation } from "react-i18next";
+import { useTextSource } from "./useTextSource";
+import { prepareHtmlAttachment } from "./html-attachment";
+
+export default function HtmlPreview({ url, filename }: { url: string; filename: string }) {
+  const { t } = useTranslation();
+  const state = useTextSource(url);
+  const [source, setSource] = useState(false);
+  const prepared = useMemo(() => state.kind === "ready" ? prepareHtmlAttachment(state.text) : "", [state]);
+  if (state.kind === "loading") return <div className="flex h-full items-center justify-center gap-2"><Loader2 size={14} className="animate-spin" />{t("Loading preview…")}</div>;
+  if (state.kind === "error") return <p role="alert" className="p-4 text-sm">{state.message}</p>;
+  return <div className="flex h-full min-h-0 flex-col">
+    <div className="flex flex-wrap items-center gap-2 border-b border-[var(--border)] px-3 py-2 text-xs">
+      <div className="flex gap-1" aria-label={t("HTML preview")}>
+        <button type="button" aria-pressed={!source} onClick={() => setSource(false)} className="rounded px-2 py-1 hover:bg-[var(--muted)] aria-pressed:bg-[var(--muted)]">{t("Preview page")}</button>
+        <button type="button" aria-pressed={source} onClick={() => setSource(true)} className="rounded px-2 py-1 hover:bg-[var(--muted)] aria-pressed:bg-[var(--muted)]">{t("Source code")}</button>
+      </div>
+      <span className="text-[var(--muted-foreground)]">{t("Device speech synthesis · not textbook audio")}</span>
+    </div>
+    <p className="border-b border-[var(--border)] px-3 py-2 text-[11px] text-[var(--muted-foreground)]">{t("Click text or a play button to listen. Attachment scripts and external links are disabled in safe preview.")}</p>
+    {source ? <pre className="min-h-0 flex-1 overflow-auto whitespace-pre-wrap break-all p-4 text-xs">{state.text}</pre> :
+      <iframe key={url} title={filename} srcDoc={prepared} sandbox="allow-scripts" referrerPolicy="no-referrer"
+        allow="camera 'none'; microphone 'none'; display-capture 'none'; geolocation 'none'; clipboard-read 'none'; clipboard-write 'none'"
+        className="min-h-0 w-full flex-1 border-0 bg-white" />}
+  </div>;
+}
diff --git a/web/components/chat/preview/previewers/html-attachment.ts b/web/components/chat/preview/previewers/html-attachment.ts
new file mode 100644
index 0000000..bf8e018
--- /dev/null
+++ b/web/components/chat/preview/previewers/html-attachment.ts
@@ -0,0 +1,146 @@
+/** Uploaded HTML is data: keep its layout, replace executable code with our reader. */
+const TAGS = new Set("html head body title style div span p br hr h1 h2 h3 h4 h5 h6 section article header footer main aside nav ul ol li dl dt dd table thead tbody tfoot tr th td caption colgroup col strong b em i u s small sub sup mark blockquote pre code a img audio source button label input details summary figure figcaption".split(" "));
+const ATTRS = new Set("id class style lang dir title role aria-label aria-hidden alt colspan rowspan width height for min max step value".split(" "));
+
+// Only this fixed controller runs. The attachment gets no host bridge or network.
+const READER = String.raw`(() => {
+  const synth = window.speechSynthesis;
+  const lines = [...document.querySelectorAll('[data-ks-line]')];
+  const status = document.querySelector('[data-ks-status]');
+  let generation = 0, timer, current, cancelVoiceWait;
+  synth?.getVoices(); // Ask the device for its voices before the first click.
+  const sayStatus = text => { status.hidden = false; status.textContent = text; };
+  const stop = () => { generation++; cancelVoiceWait?.(); clearTimeout(timer); current = null; synth?.cancel(); };
+  const rate = () => Math.max(0.6, Math.min(1.2, Number(document.getElementById('rate')?.value) || 0.9));
+  async function play(texts, repeat = 1) {
+    stop();
+    const token = generation;
+    let voices = synth?.getVoices().filter(v => v.localService) || [];
+    if (!voices.length && synth?.addEventListener) {
+      sayStatus('正在准备设备声音…');
+      await new Promise(resolve => {
+        const ready = () => {
+          clearTimeout(timer); synth.removeEventListener('voiceschanged', changed);
+          if (cancelVoiceWait === ready) cancelVoiceWait = null;
+          resolve();
+        };
+        const changed = () => { if (synth.getVoices().some(v => v.localService)) ready(); };
+        cancelVoiceWait = ready;
+        synth.addEventListener('voiceschanged', changed);
+        timer = setTimeout(ready, 3000);
+      });
+      if (token !== generation) return;
+      voices = synth.getVoices().filter(v => v.localService);
+    }
+    if (!voices.length) {
+      sayStatus('没有可用的设备朗读声音。请在系统语音设置中安装所需语言后重试。');
+      return;
+    }
+    const queue = texts.flatMap(text => text.match(/[\s\S]{1,400}(?:\s|$)|[\s\S]{1,400}/g) || []);
+    if (!queue.length) { sayStatus('没有可朗读的正文。'); return; }
+    let index = 0;
+    function next() {
+      if (token !== generation) return;
+      if (index >= queue.length * repeat) { current = null; sayStatus('朗读完成'); return; }
+      const text = queue[index++ % queue.length];
+      const language = (text.match(/[\u4e00-\u9fff]/g) || []).length > (text.match(/[a-z]/ig) || []).length / 2 ? 'zh' : 'en';
+      const voice = voices.find(v => v.lang.toLowerCase().startsWith(language));
+      if (!voice) { stop(); sayStatus('设备缺少这段文字对应的语言声音，请在系统语音设置中安装后重试。'); return; }
+      const utterance = new SpeechSynthesisUtterance(text);
+      current = utterance;
+      utterance.voice = voice; utterance.lang = voice.lang; utterance.rate = rate();
+      utterance.onstart = () => { if (token === generation && current === utterance) { clearTimeout(timer); sayStatus('正在朗读 · 设备合成声音'); } };
+      utterance.onend = () => { if (token === generation && current === utterance) { clearTimeout(timer); next(); } };
+      utterance.onerror = () => { if (token === generation && current === utterance) { stop(); sayStatus('设备朗读未能播放，请检查系统声音后重试。'); } };
+      timer = setTimeout(() => { if (token === generation) { stop(); sayStatus('设备朗读未响应，请检查系统语音设置后重试。'); } }, 8000);
+      try { synth.speak(utterance); }
+      catch { stop(); sayStatus('设备朗读未能播放，请检查系统声音后重试。'); }
+    }
+    sayStatus('正在启动设备朗读…'); next();
+  }
+  const lineText = node => node?.textContent?.trim() || '';
+  function activate(node) {
+    const action = node.dataset.ksAction;
+    if (action === 'stop') { stop(); sayStatus('已停止'); }
+    if (action === 'all') play(lines.map(lineText), Number(node.dataset.ksRepeat) || 1);
+    if (action === 'one') play([lineText(lines[Number(node.dataset.ksIndex)])]);
+    if (action === 'text') play([node.dataset.ksText || '']);
+    if (action === 'blind') {
+      const on = document.body.classList.toggle('blind');
+      lines.forEach(line => { line.style.visibility = on ? 'hidden' : ''; });
+      node.textContent = on ? '显示文字' : '盲听模式'; node.setAttribute('aria-pressed', String(on));
+    }
+    if (node.hasAttribute('data-ks-line')) play([lineText(node)]);
+  }
+  document.addEventListener('click', event => {
+    const node = event.target.closest('[data-ks-action], [data-ks-line]');
+    if (node) activate(node);
+  });
+  document.addEventListener('keydown', event => {
+    if ((event.key === 'Enter' || event.key === ' ') && event.target.matches('[data-ks-line]')) {
+      event.preventDefault(); activate(event.target);
+    }
+    if (event.key === 'Escape') { stop(); sayStatus('已停止'); }
+  });
+  document.getElementById('rate')?.addEventListener('input', () => {
+    const label = document.getElementById('rateVal'); if (label) label.textContent = rate().toFixed(2);
+  });
+  window.addEventListener('pagehide', stop);
+})();`;
+
+export function prepareHtmlAttachment(raw: string): string {
+  const doc = new DOMParser().parseFromString(raw, "text/html");
+  for (const node of Array.from(doc.querySelectorAll("*"))) {
+    if (!TAGS.has(node.localName)) { node.remove(); continue; }
+    const click = node.getAttribute("onclick")?.trim().replace(/;$/, "") || "";
+    const src = node.getAttribute("src") || "";
+    for (const attr of Array.from(node.attributes)) {
+      if (!ATTRS.has(attr.name)) node.removeAttribute(attr.name);
+    }
+    if (["img", "audio", "source"].includes(node.localName) && /^data:(?:image\/(?:png|jpe?g|gif|webp|avif|bmp)|audio\/[a-z0-9.+-]+);base64,[a-z0-9+/=\s]+$/i.test(src)) node.setAttribute("src", src);
+    if (node.localName === "audio") node.setAttribute("controls", "");
+    if (node.localName === "button") {
+      node.setAttribute("type", "button");
+      const one = /^speakOne\(\s*(\d+)\s*\)$/.exec(click);
+      const all = /^playAll\(\s*([13])\s*\)$/.exec(click);
+      const text = /^speakText\(\s*(?:"([^"\\]*)"|'([^'\\]*)')\s*\)$/.exec(click);
+      const action = one ? "one" : all ? "all" : text ? "text"
+        : click === "stopAll()" ? "stop" : click === "toggleBlind()" ? "blind" : "";
+      if (action) node.setAttribute("data-ks-action", action);
+      else node.setAttribute("disabled", "");
+      if (one) node.setAttribute("data-ks-index", one[1]);
+      if (all) node.setAttribute("data-ks-repeat", all[1]);
+      if (text) node.setAttribute("data-ks-text", text[1] ?? text[2]);
+    }
+    if (node.localName === "input") {
+      // No file pickers, submission or hidden controls in an attachment.
+      node.setAttribute("type", "range");
+      node.setAttribute("min", "0.6"); node.setAttribute("max", "1.2"); node.setAttribute("step", "0.05");
+    }
+  }
+  const candidates = doc.querySelectorAll(".row .text");
+  const lines = candidates.length ? Array.from(candidates) : Array.from(doc.body.querySelectorAll("p,li,blockquote,td"))
+    .filter(node => !node.querySelector("p,li,blockquote,td"));
+  for (const line of lines) {
+    line.setAttribute("data-ks-line", ""); line.setAttribute("tabindex", "0");
+    line.setAttribute("role", "button"); line.setAttribute("title", "点击合成朗读这一段");
+  }
+  const status = doc.createElement("p");
+  status.hidden = true;
+  status.setAttribute("data-ks-status", ""); status.setAttribute("role", "status"); status.setAttribute("aria-live", "polite");
+  status.style.cssText = "font:13px/1.5 system-ui;color:#6b6259;padding:8px 0;";
+  if (!doc.querySelector('[data-ks-action="all"]')) {
+    const controls = doc.createElement("div");
+    controls.innerHTML = '<button type="button" data-ks-action="all">▶ 朗读全文</button> <button type="button" data-ks-action="stop">停止</button>';
+    doc.body.prepend(controls);
+  }
+  doc.body.prepend(status);
+  const nonce = crypto.randomUUID().replaceAll("-", "");
+  const csp = doc.createElement("meta");
+  csp.httpEquiv = "Content-Security-Policy";
+  csp.content = `default-src 'none'; script-src 'nonce-${nonce}'; style-src 'unsafe-inline'; img-src data:; media-src data:; connect-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'`;
+  doc.head.prepend(csp);
+  const viewport = doc.createElement("meta"); viewport.name = "viewport"; viewport.content = "width=device-width,initial-scale=1"; doc.head.prepend(viewport);
+  const script = doc.createElement("script"); script.setAttribute("nonce", nonce); script.textContent = READER; doc.body.append(script);
+  return "<!DOCTYPE html>" + doc.documentElement.outerHTML;
+}
