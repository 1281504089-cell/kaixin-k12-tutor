+import { afterEach, expect, it } from 'vitest'
+import { BlockNoteEditor } from '@blocknote/core'
+import { parseNoteMarkdown } from '@/features/notes/model/markdown'
+import type { NoteBlock } from '@/lib/notes-api'
+const editors: BlockNoteEditor[] = []
+afterEach(() => editors.splice(0).forEach(editor => editor._tiptapEditor.destroy()))
+function parse(text: string) {
+  const editor = BlockNoteEditor.create()
+  editors.push(editor)
+  return parseNoteMarkdown(text, value => editor.tryParseMarkdownToBlocks(value) as NoteBlock[])
+}
+it('keeps formulas in real BlockNote table cells and preserves their backslashes and underscores', () => {
+  const source = '| 形状 | 公式 |\n|---|---|\n| 平方 | $x_1^2+x_2^2$ |\n| 公式法 | $x=\\dfrac{-b\\pm\\sqrt{b^2-4ac}}{2a}$ |'
+  const blocks = parse(source)
+  const json = JSON.stringify(blocks)
+  expect(json.match(/inlineMath/g)).toHaveLength(2)
+  expect(json).toContain('x_1^2+x_2^2')
+  expect(json).toContain('dfrac')
+  expect(json).not.toContain('DTNOTEMATH')
+})
+it('preserves backslash delimiters before Markdown can unescape them', () => {
+  const blocks = parse('条件 \\(a\\neq0\\)；结果 \\(x=\\frac{2}{3}\\)。\n\n\\[x^2=4\\]')
+  const json = JSON.stringify(blocks)
+  expect(json.match(/inlineMath/g)).toHaveLength(2)
+  expect(blocks.some(block => block.type === 'math')).toBe(true)
+  expect(json).toContain('frac{2}{3}')
+})
+it('leaves code examples, links, currency and ordinary text intact', () => {
+  const blocks = parse('代码 `cost = "$5"`，[资料](https://example.com)\n\n```tex\n$x_1$\\frac{1}{2}\n```\n\n门票 $5 和 $10，共 $15。')
+  const json = JSON.stringify(blocks)
+  expect(json).toContain('codeBlock')
+  expect(json).toContain('https://example.com')
+  expect(json).toContain('$15')
+  expect(json).not.toContain('DTNOTEMATH')
+})
+
+it('renders already saved table cells without mutating their IDs, formatting, metadata or code', async () => {
+  const { normalizeNoteMath } = await import('@/features/notes/model/markdown')
