diff --git a/web/tests/html-attachment.spec.ts b/web/tests/html-attachment.spec.ts
new file mode 100644
index 0000000..6b55661
--- /dev/null
+++ b/web/tests/html-attachment.spec.ts
@@ -0,0 +1,125 @@
+import { afterEach, expect, it, vi } from "vitest";
+import { prepareHtmlAttachment } from "@/components/chat/preview/previewers/html-attachment";
+import { previewKindFor } from "@/components/chat/preview/previewerFor";
+
+it("routes named and MIME-only HTML to the page preview and preserves other code previews", () => {
+  expect(previewKindFor({filename:"unit1_listening_click.HTML"})).toBe("html");
+  expect(previewKindFor({filename:"lesson",mimeType:"text/html; charset=utf-8"})).toBe("html");
+  expect(previewKindFor({filename:"script.js"})).toBe("code");
+});
+
+const lesson = `<style>.row{padding:8px}</style><h1>听力练习</h1>
+<button onclick="playAll(3)">三遍连听</button><button onclick="stopAll()">停止</button>
+<button onclick="toggleBlind()">盲听模式</button><input id="rate" value="0.9"><span id="rateVal"></span>
+<div class="row"><button onclick="speakOne(0)">逐句一</button><span class="text">The box has six sides.</span></div>
+<div class="row"><button onclick="speakOne(1)">逐句二</button><span class="text">Each face is a square.</span></div>
+<button onclick="speakText('six sides')">six sides<small>六个面</small></button>
+<script>window.compromised=true;fetch('https://example.org/leak')</script>`;
+const cleanups: (() => void)[] = [];
+type Utterance = { text: string; rate: number; lang: string; voice?: {localService:boolean}; onstart?:()=>void; onend?:()=>void; onerror?:()=>void };
+function renderLesson(raw = lesson, local = true) {
+  const calls: Utterance[] = [];
+  const cancel = vi.fn();
+  const document = new DOMParser().parseFromString(prepareHtmlAttachment(raw), "text/html");
+  const events = new EventTarget();
+  const w = { document, KeyboardEvent, addEventListener: events.addEventListener.bind(events), speechSynthesis: {
+    getVoices: () => [{ lang: "en-US", localService: local }], cancel,
+    speak: (u: Utterance) => { calls.push(u); u.onstart?.(); },
+  } };
+  new Function("window", "document", "SpeechSynthesisUtterance", document.querySelector("script")!.textContent!)(
+    w, document, class { constructor(public text:string){} },
+  );
+  const dom = { window: w };
+  cleanups.push(() => events.dispatchEvent(new Event("pagehide")));
+  const click = (text: string) => Array.from(dom.window.document.querySelectorAll("button")).find(n => n.textContent === text)!.click();
+  return { dom, calls, cancel, click };
+}
+afterEach(() => { cleanups.splice(0).forEach(cleanup => cleanup()); vi.useRealTimers(); });
+
+it("retains lesson layout and replaces scripts, inline handlers, links, frames and forged reader actions", () => {
+  const prepared = prepareHtmlAttachment(lesson + `<base href="file:///etc/"><meta http-equiv="refresh" content="0;url=https://example.org">
+    <iframe src="https://example.org"></iframe><object data="file:///x"></object><form action="http://localhost/settings"><input type="file"></form>
+    <a href="javascript:alert(1)" target="_top">link</a><img src="https://example.org/a" onerror="alert(1)">
+    <button data-ks-action="all" onclick="parent.kaixinDesktop.checkForUpdates()">forged</button><audio src="file:///private/audio.mp3"></audio>`);
+  const doc = new DOMParser().parseFromString(prepared, "text/html");
+  expect(doc.querySelectorAll("script")).toHaveLength(1);
+  expect(doc.querySelector("script")!.textContent).not.toContain("window.compromised");
+  expect(doc.querySelector("script")!.getAttribute("nonce")).toBeTruthy();
+  expect(doc.querySelector('meta[http-equiv="Content-Security-Policy"]')!.getAttribute("content")).toContain("connect-src 'none'");
+  expect(doc.querySelector("style")!.textContent).toContain("padding:8px");
+  expect(doc.querySelector("base,iframe,object,form,[onclick],[onerror],[href],[src],[target]")).toBeNull();
+  expect(Array.from(doc.querySelectorAll("button")).find(n => n.textContent === "forged")!.disabled).toBe(true);
+  const { dom } = renderLesson(prepared);
+  expect((dom.window as unknown as {compromised?:boolean}).compromised).toBeUndefined();
+});
+
+it("plays a clicked sentence with a local English voice, rate and clear completion", () => {
+  const { dom, calls, click } = renderLesson();
+  click("逐句一");
+  expect(calls).toHaveLength(1); expect(calls[0].text).toBe("The box has six sides.");
+  expect(calls[0].lang).toBe("en-US"); expect(calls[0].rate).toBe(0.9);
+  expect(calls[0].voice?.localService).toBe(true);
+  calls[0].onend?.();
+  expect(dom.window.document.querySelector('[role="status"]')!.textContent).toBe("朗读完成");
+});
+
+it("keeps three-repeat playback, word chips, blind mode and keyboard reading usable", () => {
+  const { dom, calls, click } = renderLesson();
+  click("三遍连听");
+  for (let i=0; i<6; i++) calls[i].onend?.();
+  expect(calls.map(c => c.text)).toEqual(Array.from({length:3}, () => ["The box has six sides.", "Each face is a square."]).flat());
+  click("six sides六个面"); expect(calls.at(-1)!.text).toBe("six sides");
+  click("盲听模式"); expect((dom.window.document.querySelector(".text") as HTMLElement).style.visibility).toBe("hidden");
+  click("显示文字"); expect((dom.window.document.querySelector(".text") as HTMLElement).style.visibility).toBe("");
+  dom.window.document.querySelector(".text")!.dispatchEvent(new dom.window.KeyboardEvent("keydown", { key:"Enter", bubbles:true }));
+  expect(calls.at(-1)!.text).toBe("The box has six sides.");
+});
+
+it("stops old queues and cannot restart them through a late callback", () => {
+  const { calls, click, cancel, dom } = renderLesson();
+  click("三遍连听"); click("停止"); calls[0].onend?.();
+  expect(calls).toHaveLength(1); expect(cancel).toHaveBeenCalledTimes(2);
+  expect(dom.window.document.querySelector('[role="status"]')!.textContent).toBe("已停止");
+  calls[0].onstart?.();
+  expect(dom.window.document.querySelector('[role="status"]')!.textContent).toBe("已停止");
+});
+
+it("cannot clear a new utterance's startup deadline through an old start event", () => {
+  vi.useFakeTimers();
+  const { calls, click, dom } = renderLesson();
+  dom.window.speechSynthesis.speak = utterance => { calls.push(utterance); };
+  click("逐句一");
+  click("逐句二");
+  calls[0].onstart?.();
+  vi.advanceTimersByTime(8000);
+  expect(dom.window.document.querySelector('[role="status"]')!.textContent).toContain("未响应");
+});
+
+it("does not silently choose network voices when device voices are absent", () => {
+  const { calls, click, dom } = renderLesson(lesson, false);
+  click("逐句一"); expect(calls).toHaveLength(0);
+  expect(dom.window.document.querySelector('[role="status"]')!.textContent).toContain("没有可用的设备朗读声音");
+});
+
+it.each([false, true])("handles voices arriving after a first click and cancellation (%s)", async cancelled => {
+  const { dom, calls, click } = renderLesson();
+  const voices = new EventTarget();
+  let ready = false;
+  Object.assign(dom.window.speechSynthesis, {
+    getVoices: () => ready ? [{lang:"en-US",localService:true}] : [],
+    addEventListener: voices.addEventListener.bind(voices), removeEventListener: voices.removeEventListener.bind(voices),
+  });
+  click("逐句一");
+  expect(dom.window.document.querySelector('[role="status"]')!.textContent).toBe("正在准备设备声音…");
+  if (cancelled) click("停止");
+  ready = true;
+  voices.dispatchEvent(new Event("voiceschanged"));
+  await Promise.resolve();
+  expect(calls).toHaveLength(cancelled ? 0 : 1);
+});
+
+it("supports ordinary static HTML with keyboard-readable paragraphs and explicit controls", () => {
+  const { calls, dom, click } = renderLesson("<h1>Reading</h1><p>One sentence.</p><p>Another sentence.</p>");
+  click("▶ 朗读全文"); expect(calls[0].text).toBe("One sentence.");
+  expect(dom.window.document.querySelectorAll('[role="button"]')).toHaveLength(2);
+});
