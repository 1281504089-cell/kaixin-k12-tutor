new file mode 100644
index 0000000..6fe8965
--- /dev/null
+++ b/web/lib/chat-library-materials.ts
@@ -0,0 +1,74 @@
+import { apiFetch, apiUrl } from '@/lib/api'
+import { scopedUrl } from '@/lib/workspace-scope'
+import { listKnowledgeBases, listKnowledgeBaseFiles } from '@/features/knowledge/api/client'
+import { knowledgeBaseRef } from '@/lib/knowledge-helpers'
+import { learningLibrary } from '@/lib/learning-library'
+import type { ReadingLibraryMaterial } from '@/lib/reading-workspace-api'
+import type { UploadResult, UploadedAttachment } from '@/lib/student-upload'
+import type { PendingAttachment } from '@/features/chat/controllers/pending-attachments'
+
+export interface ChatLibraryMaterial {
+  key: string
+  name: string
+  detail: string
+  size?: number
+  reference: { filename: string; kb_ref?: string; upload_id?: string; attachment_id?: string; material_id?: string; workspace_id?: string }
+  retainedKb?: string
+}
+
+export async function chatLibraryMaterials() {
+  const failures: string[] = []
+  const results = await Promise.allSettled([
+    (async (): Promise<ChatLibraryMaterial[]> => {
+      const response = await apiFetch(apiUrl('/api/student/attachments/uploads/library'), { cache: 'no-store' })
+      if (!response.ok) throw new Error('长期资料暂时无法读取')
+      const result: { uploads: (UploadResult & { content_workspace_id?: string; content_workspace_name?: string })[]; unavailable_workspaces?: string[] } = await response.json()
+      if (result.unavailable_workspaces?.length) failures.push('部分项目的长期资料')
+      return result.uploads.flatMap(upload => upload.records.map(row => ({
+        key: `upload:${upload.content_workspace_id || ''}:${row.id}`, name: row.filename, size: row.size,
+        detail: upload.content_workspace_name || '我的上传资料',
+        retainedKb: upload.content_workspace_id ? `workspace:${upload.content_workspace_id}:kb:我的上传资料` : 'account:kb:我的上传资料',
+        reference: { filename: row.filename, upload_id: upload.upload_id, attachment_id: row.id, workspace_id: upload.content_workspace_id || '' },
+      })))
+    })(),
+    (async (): Promise<ChatLibraryMaterial[]> => {
+      const bases = await listKnowledgeBases({ library: true, force: true })
+      const lists = await Promise.allSettled(bases.map(async kb => {
+        const ref = knowledgeBaseRef(kb)
+        const files = await listKnowledgeBaseFiles(ref, { library: true, force: true })
+        return files.filter(row => row.type !== 'folder').map(row => ({
+          key: `kb:${ref}:${row.name}`, name: row.name, size: row.size, detail: kb.name,
+          reference: { filename: row.name, kb_ref: ref },
+        }))
+      }))
+      return lists.flatMap(result => {
+        if (result.status === 'fulfilled') return result.value
+        failures.push('部分资料原件')
+        return []
+      })
+    })(),
+    (async (): Promise<ChatLibraryMaterial[]> => {
+      const result = await learningLibrary<ReadingLibraryMaterial>('materials')
+      if (result.unavailable_workspaces?.length) failures.push('部分阅读资料')
+      return result.items.filter(row => row.source_kind === 'file' && !row.collections?.some(c => c.workspace_id.startsWith('rw_tb_'))).map(row => ({
+        key: `reading:${row.content_workspace_id || ''}:${row.material_id}`, name: row.filename, detail: row.title,
+        reference: { filename: row.filename, material_id: row.material_id, workspace_id: row.content_workspace_id || '' },
+      }))
+    })(),
+  ])
+  const rows = results.flatMap((result, index) => {
+    if (result.status === 'fulfilled') return result.value
+    failures.push(['长期资料', '已有知识资料', '阅读资料'][index])
+    return []
+  })
+  return { rows: rows.filter(row => !row.reference.kb_ref || !rows.some(saved => saved.retainedKb === row.reference.kb_ref && saved.name === row.name && saved.size === row.size)), error: failures.length ? `${[...new Set(failures)].join('、')}未能读取，请重试。` : '' }
+}
+
+export async function referenceLibraryMaterial(row: ChatLibraryMaterial, workspace: string): Promise<PendingAttachment> {
+  const response = await apiFetch(apiUrl(scopedUrl('/api/student/materials/attach', workspace)), {
+    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(row.reference),
+  })
+  if (!response.ok) throw new Error('原件引用失败，请刷新资料库后重试。')
+  const file: UploadedAttachment = await response.json()
+  return { id: file.id, attachmentId: file.id, filename: file.filename, type: file.type, url: file.url, mimeType: file.mime_type, size: file.size, pageCount: file.page_count }
+}
