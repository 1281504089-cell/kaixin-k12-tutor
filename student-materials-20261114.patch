@@ -0,0 +1,58 @@
+"""Exercise source selection through the real answer loop with a scripted provider."""
+import json
+import pytest
+
+from deeptutor.agents.chat.agentic_pipeline import AgenticChatPipeline
+from deeptutor.core.context import UnifiedContext
+from deeptutor.runtime.registry.tool_registry import ToolRegistry
+from deeptutor.tools.builtin import ReadSourceTool
+from tests.agents.chat.test_agent_loop import _ScriptedChatClient, _isolated_runtime, _llm_chunk, _run
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("followup", [False, True])
+async def test_answer_loop_can_read_prior_document_without_an_intent_prepass(monkeypatch, followup):
+    original = "完整题干：用去三分之一，还剩12升，求原来水量。"
+    reads = []
+    class TracedSource(ReadSourceTool):
+        async def execute(self, **kwargs):
+            reads.append(kwargs)
+            return await super().execute(**kwargs)
+    registry = ToolRegistry()
+    registry.register(TracedSource())
+    script = []
+    if followup:
+        script.append([_llm_chunk(tool_calls=[{"id": "read", "name": "read_source", "arguments": '{"source_id":"at-question"}'}], finish_reason="tool_calls")])
+    script.append([_llm_chunk(content="source-grounded answer" if followup else "new-topic answer", finish_reason="stop")])
+    client = _ScriptedChatClient(script)
+    pipeline = AgenticChatPipeline(language="zh")
+    pipeline.registry = registry
+    monkeypatch.setattr(pipeline, "_build_openai_client", lambda: client)
+    context = UnifiedContext(session_id="s", user_message="继续解释刚才那一步" if followup else "换个话题，解释地理经纬度", enabled_tools=[], source_manifest="[Attached Sources]\n- id=at-question type=attachment name=题目.txt", metadata={"source_index": {"at-question": original}, "source_read_on_demand": True})
+    assert "read_source" in pipeline._compose_enabled_tools(context)
+    await _run(pipeline, context)
+    assert client.call_count == (2 if followup else 1)
+    assert len(reads) == int(followup)
+    if followup:
+        assert reads[0]["source_index"] == {"at-question": original}
+        assert original in json.dumps(client.calls[-1]["messages"], ensure_ascii=False)
+    else:
+        assert original not in json.dumps(client.calls[0]["messages"], ensure_ascii=False)
+
+
+def test_native_source_tool_receives_only_current_authorized_index(monkeypatch):
+    from deeptutor.agents.loop.native_seed import tool_specs
+    from deeptutor.agents.loop.native_tools import tool_runtime
+    pipeline = AgenticChatPipeline(language="zh")
+    registry = ToolRegistry()
+    registry.register(ReadSourceTool())
+    pipeline.registry = registry
+    context = UnifiedContext(session_id="s", user_message="继续", metadata={"source_index": {"at-current": "完整原文"}, "source_read_on_demand": True})
+    specs = tool_specs(pipeline, registry.build_openai_schemas(["read_source"]))
+    assert specs[0]["native"]
+    assert tool_runtime(pipeline, context, specs)["read_source"]["sources"] == {"at-current": "完整原文"}
+    context.metadata["source_index"] = {}
+    assert "read_source" not in pipeline._compose_enabled_tools(context)
+    assert tool_runtime(pipeline, context, specs)["read_source"]["sources"] == {}
+    context.metadata.update(source_index={"at-fresh": "first upload"}, source_read_on_demand=False)
+    assert "read_source" not in pipeline._compose_enabled_tools(context)
