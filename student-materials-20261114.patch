+"""Library picks reference authorized originals without moving their project or account."""
+from fastapi import HTTPException
+import pytest
+
+from deeptutor.api.routers.student_uploads import ExistingMaterial, attach_library_material
+from deeptutor.services.student_learning import uploads
+from deeptutor.services.workspace.context import workspace_context
+from tests.services.workspace.test_data_scope import account as account
+
+
+async def saved_file(retention="library"):
+    meta = uploads.begin("公式.txt", 3, retention)
+    (uploads.directory(meta["upload_id"]) / "0.chunk").write_bytes(b"abc")
+    return await uploads.finish(meta["upload_id"])
+
+
+@pytest.mark.asyncio
+async def test_cross_project_pick_preserves_original_and_targets_current_chat(account):
+    source = account.create_workspace("数学")["workspace_id"]
+    target = account.create_workspace("物理")["workspace_id"]
+    with workspace_context(source):
+        original = await saved_file()
+        record = original["records"][0]
+        original_path = uploads.file_for(record)
+    with workspace_context(target):
+        picked = await attach_library_material(ExistingMaterial(
+            upload_id=original["upload_id"], attachment_id=record["id"],
+            filename=record["filename"], workspace_id=source,
+        ))
+        assert f"dt_workspace={target}" in picked["url"]
+        assert picked["filename"] == record["filename"]
+        assert uploads.file_for(picked).read_bytes() == b"abc"
+        assert uploads.library_uploads() == []
+        assert original_path.read_bytes() == b"abc"
+        paths = await uploads.adopt([picked], "current-chat", uploads.store())
+        assert paths[picked["id"]].read_bytes() == b"abc"
+    with workspace_context(source):
+        assert uploads.library_uploads()[0]["records"] == original["records"]
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("change", ["wrong_id", "wrong_name", "temporary", "deleted", "foreign_workspace"])
+async def test_pick_rejects_unavailable_or_wrong_source(account, change):
+    original = await saved_file("temporary" if change == "temporary" else "library")
+    record = original["records"][0]
+    body = dict(upload_id=original["upload_id"], attachment_id=record["id"], filename=record["filename"])
+    if change == "wrong_id": body["attachment_id"] = "f" * 32
+    if change == "wrong_name": body["filename"] = "../other.txt"
+    if change == "deleted": uploads.file_for(record).unlink()
+    if change == "foreign_workspace": body["workspace_id"] = "ws_unknown"
+    with pytest.raises(HTTPException):
+        await attach_library_material(ExistingMaterial(**body))
+
+
+@pytest.mark.asyncio
+async def test_pick_cannot_resolve_another_account_original(account, tmp_path):
+    from deeptutor.multi_user.models import CurrentUser, UserScope
+    from deeptutor.multi_user.paths import user_context, get_account_path_service
+    original = await saved_file()
+    record = original["records"][0]
+    other = CurrentUser("other-picker", "other", "admin", UserScope("admin", "other-picker", tmp_path / "other"))
+    with user_context(other):
+        get_account_path_service().ensure_all_directories()
+        with pytest.raises(HTTPException):
+            await attach_library_material(ExistingMaterial(upload_id=original["upload_id"], attachment_id=record["id"], filename=record["filename"]))
+
+
+@pytest.mark.asyncio
+async def test_existing_kb_reference_keeps_authorized_resolver(account, monkeypatch, tmp_path):
+    from deeptutor.services import config
+    monkeypatch.setattr(config, "load_config_with_main", lambda *args, **kwargs: {})
+    from deeptutor.api.routers import knowledge
+    from deeptutor.services.workspace.knowledge import library_request
+    source = tmp_path / "教材.txt"
+    source.write_text("original", encoding="utf-8")
+    calls = []
+    def resolve(ref, filename):
+        assert library_request.get()
+        calls.append((ref, filename))
+        return source
+    monkeypatch.setattr(knowledge, "_resolve_kb_raw_file_or_404", resolve)
+    result = await attach_library_material(ExistingMaterial(kb_ref="account:kb:教材", filename=source.name))
+    assert calls == [("account:kb:教材", "教材.txt")]
+    assert uploads.file_for(result).read_text() == "original"
+    assert not library_request.get()
+
+
+@pytest.mark.asyncio
+async def test_reading_pick_uses_material_permission_check(account, monkeypatch):
+    from deeptutor.api.routers import reading
+    def denied(material):
+        raise HTTPException(403, "not assigned")
+    monkeypatch.setattr(reading, "assert_learning_material", denied)
+    with pytest.raises(HTTPException) as denied:
+        await attach_library_material(ExistingMaterial(material_id="abc12345", filename="private.pdf"))
+    assert denied.value.status_code == 403
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("body", [{"filename": "x.txt"}, {"filename": "x.txt", "kb_ref": "x", "material_id": "x"}])
+async def test_pick_requires_one_source(account, body):
+    with pytest.raises(HTTPException) as error:
+        await attach_library_material(ExistingMaterial(**body))
+    assert error.value.status_code == 400
+
+
+@pytest.mark.asyncio
+async def test_pdf_pick_preserves_original_name_page_count_and_reading_permission(account, tmp_path):
+    import pymupdf
+    pdf = pymupdf.open()
+    pdf.new_page().insert_text((40, 40), "Synthetic original page")
+    data = pdf.tobytes()
+    pdf.close()
+    source = account.create_workspace("PDF资料")["workspace_id"]
+    with workspace_context(source):
+        meta = uploads.begin("原始试卷.pdf", len(data), "library")
+        (uploads.directory(meta["upload_id"]) / "0.chunk").write_bytes(data)
+        result = await uploads.finish(meta["upload_id"])
+        record = result["records"][0]
+    picked = await attach_library_material(ExistingMaterial(upload_id=result["upload_id"], attachment_id=record["id"], workspace_id=source, filename=record["filename"]))
+    assert picked["filename"] == "原始试卷.pdf" and picked["page_count"] == 1
+    assert uploads.file_for(picked).read_bytes() == data
+    from deeptutor.api.routers.reading import _store
+    with workspace_context(source):
+        original = tmp_path / "阅读原件.pdf"
+        original.write_bytes(data)
+        material = _store().ingest(original)
+    reading = await attach_library_material(ExistingMaterial(material_id=material.material_id, workspace_id=source, filename=material.filename))
+    assert reading["filename"] == "阅读原件.pdf"
+    assert uploads.file_for(reading).read_bytes() == data
+
+
